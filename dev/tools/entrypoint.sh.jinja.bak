echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} first part:" >> /app/logs/{{additional_param.service_name}}_commands.log
cat "$FIRST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log

if [ $FIRST_STATUS -eq 0 ]; then
  # If first part succeeded, execute the rest
  log "First part succeeded, executing rest: $REST_OF_CMD"
  if [ -n "$REST_OF_CMD" ]; then
    REST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_rest.log"
    echo "[$(date '+%Y-%m-%d %H:%M:%S")] Starting execution of {{ cmd_type }} command #{{ loop.index }} rest part" > "$REST_OUTPUT"
    echo "Command: ${REST_OF_CMD}" >> "$REST_OUTPUT" 
    echo "----------------------------------------" >> "$REST_OUTPUT"
    bash -c "${REST_OF_CMD}" >> "$REST_OUTPUT" 2>&1
    REST_STATUS=$?
    echo "----------------------------------------" >> "$REST_OUTPUT"
    echo "[$(date '+%Y-%m-%d %H:%M:%S")] Rest part completed with exit code: $REST_STATUS" >> "$REST_OUTPUT"
    
    # Log the captured output
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} rest part:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$REST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log
    
    if [ $REST_STATUS -ne 0 ]; then
      log "Rest of command failed: $REST_OF_CMD (status $REST_STATUS)"
      exit $REST_STATUS
    fi
  fi
else
  exit $FIRST_STATUS
fi
{% elif cmd_obj.is_function_call %}
# Handle simple function call
log "Executing function call: {{ cmd_obj.command }}"
# Check if function exists first to avoid errors
if declare -f {{ cmd_obj.command }} > /dev/null; then
  {{ cmd_obj.command }} || {
    log "Function {{ cmd_obj.command }} failed. Exiting."
    exit $?
  }
else
  log "ERROR: Function {{ cmd_obj.command }} does not exist"
  exit 1
fi
{% else %}
# Handle regular command
execute_with_error_tracking "{{ cmd_type }}" "{{ cmd_obj.command }}" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "false" "true" || {
  log "{{ cmd_type }} command failed. Exiting."
  exit $?
}
{% endif %}
{% endfor %}
{% endif %}

# Check all environment variables
log "Checking environment variables for potential issues..."
{% endif %}
for var in $(env); do
  log "Environment variable: $var"
done

{% if structured_commands.get("run_cmd") and structured_commands.get("run_cmd").get("command_args") and structured_commands.get("run_cmd").get("command_args")|length > 0 %}
# Run main command with improved error tracking
log "Running main command: timeout {{structured_commands.get("run_cmd").get("timeout", 60)}} {{structured_commands.get("run_cmd").get("command_args")[0]}} {{' '.join(structured_commands.get("run_cmd").get("command_args")[1:])}}"

# Prepare run command
# First normalize any double slashes in paths
WORKING_DIR="{{ structured_commands.get("run_cmd").get("working_dir", "") }}"
WORKING_DIR="${WORKING_DIR//\/\//\/}"
COMMAND_BINARY="{{structured_commands.get("run_cmd").get("command_args")[0]}}"
{% else %}
# Run main command with improved error tracking
log "No valid run command found or command_args is empty"

# Prepare empty run command
WORKING_DIR="/app"
COMMAND_BINARY=""
{% endif %}

# Construct the command with normalized paths and environment variables
RUN_CMD="{% for key, val in structured_commands.get("run_cmd").get("env_vars", {}).items() %} {{key}}={{val | replace('//', '/')}} {% endfor -%} timeout {{structured_commands.get("run_cmd").get("timeout")}} ${COMMAND_BINARY} {{' '.join(structured_commands.get("run_cmd").get("command_args")[1:])}}"
{% else %}
# No run command defined
log "No main run command defined for this service"
RUN_CMD=""
WORKING_DIR="/app"
{% endif %}

{% if structured_commands.get("run_cmd") %}
log "Run command details:"
log "  - Working directory: ${WORKING_DIR}"
log "  - Command binary: ${COMMAND_BINARY}"
log "  - Command arguments: {{' '.join(structured_commands.get("run_cmd").get("command_args")[1:])}}"
log "  - Full command: $RUN_CMD"

  {% if additional_param.role.name == 'client' %}
  log "Client role detected, performing connectivity checks before execution..."

  # Try to locate the target service name from protocol configuration
  TARGET_SERVICE=""
  {% if additional_param.protocol and additional_param.protocol.target %}
  TARGET_SERVICE="{{ additional_param.protocol.target }}"
  log "Found target service from protocol configuration: $TARGET_SERVICE"
  {% endif %}

  # If we have a target service, try to test connectivity
  if [ -n "$TARGET_SERVICE" ]; then
    # Default port for QUIC is 4443, or use appropriate port from configuration
    TARGET_PORT=4443
    log "Checking connectivity to $TARGET_SERVICE:$TARGET_PORT before starting client"
    for retry in {1..5}; do
      check_connectivity "$TARGET_SERVICE" "$TARGET_PORT"
      if [ $? -eq 0 ]; then
        break
      fi
      log "Connectivity check $retry failed, waiting before retry..."
      sleep 3
    done
  fi

  log "Starting client with 5 second delay for service readiness"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting main command execution" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "Command: $RUN_CMD" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "----------------------------------------" >> /app/logs/{{additional_param.service_name}}_run.log

  (sleep 5; exec $RUN_CMD) > >(tee -a /app/logs/{{additional_param.service_name}}_run.log) 2> >(tee -a /app/logs/{{additional_param.service_name}}_run_error.log >&2)
  EXIT_CODE=$?

  echo "----------------------------------------" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command completed with exit code: $EXIT_CODE" >> /app/logs/{{additional_param.service_name}}_run.log
  {% else %}
  # Server role
  log "Server role detected, executing command directly"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting main command execution" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "Command: $RUN_CMD" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "----------------------------------------" >> /app/logs/{{additional_param.service_name}}_run.log

  (exec $RUN_CMD) > >(tee -a /app/logs/{{additional_param.service_name}}_run.log) 2> >(tee -a /app/logs/{{additional_param.service_name}}_run_error.log >&2)
  EXIT_CODE=$?

  echo "----------------------------------------" >> /app/logs/{{additional_param.service_name}}_run.log
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command completed with exit code: $EXIT_CODE" >> /app/logs/{{additional_param.service_name}}_run.log

  # Create a ready signal file for the client to detect
  if [ -d "/app/sync_logs" ]; then
    log "Creating server ready signal file in sync directory"
    touch /app/sync_logs/server_ready.log
  fi
  {% endif %}
{% else %}
  # No run command defined for this service
  log "No main run command to execute"
  EXIT_CODE=0
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] No main command defined for this service" >> /app/logs/{{additional_param.service_name}}_run.log
{% endif %}

# Handle main command exit code with detailed logging
if [ $EXIT_CODE -ne 0 ]; then
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Main command failed with code $EXIT_CODE" >> /app/logs/{{additional_param.service_name}}_error.log
  if [ -n "$RUN_CMD" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Failed command: $RUN_CMD" >> /app/logs/{{additional_param.service_name}}_error.log
    echo "FAILED_COMMAND=\"$RUN_CMD\"" >> /app/logs/{{additional_param.service_name}}_status.log
  else 
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] No command defined, but exit code was non-zero" >> /app/logs/{{additional_param.service_name}}_error.log
  fi
  echo "ERROR_TYPE=RUN_FAILURE" >> /app/logs/{{additional_param.service_name}}_status.log
  echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
  echo "EXIT_CODE=$EXIT_CODE" >> /app/logs/{{additional_param.service_name}}_status.log
  echo "COMMAND_TYPE=RUN" >> /app/logs/{{additional_param.service_name}}_status.log

  # Special error types for common exit codes
  if [ $EXIT_CODE -eq 124 ]; then
    echo "ERROR_TYPE=TIMEOUT" >> /app/logs/{{additional_param.service_name}}_status.log;
  elif [ $EXIT_CODE -eq 134 ]; then
    echo "ERROR_TYPE=CRASH_ABORT" >> /app/logs/{{additional_param.service_name}}_status.log;
  elif [ $EXIT_CODE -eq 139 ]; then
    echo "ERROR_TYPE=CRASH_SEGV" >> /app/logs/{{additional_param.service_name}}_status.log;
  fi

  # Exit with the same code as the failed command
  exit $EXIT_CODE
else
  {% if structured_commands.get("run_cmd") %}
  log "Main command completed successfully"
  {% else %}
  log "No main command was executed"
  {% endif %}
  echo "EXIT_CODE=0" >> /app/logs/{{additional_param.service_name}}_status.log
  echo "FAILED=false" >> /app/logs/{{additional_param.service_name}}_status.log
fi

# Execute post-run commands with error tracking
log "Executing post-run commands..."
{% if structured_commands.get("post_run_cmds") %}
{% for cmd_obj in structured_commands.get("post_run_cmds") %}
# Set command type for this context
cmd_type="POST_RUN"

{% if not cmd_obj.is_critical %}
# Handle non-critical command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)

# This command is marked as non-critical, execute it but don't fail if it returns error
log "Executing non-critical {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "{% if cmd_obj.is_multiline %}true{% else %}false{% endif %}" "false" || {
  log "Non-critical {{ cmd_type }} command failed but continuing execution"
  # Don't exit here since this is a non-critical command
}
{% elif cmd_obj.is_function_definition %}
# Handle function definition
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# This is a function definition, execute it directly without tracking
log "Executing function definition: {{ cmd_obj.description }}"
# Just evaluate the function definition
eval "$MULTILINE_CMD"
{% elif cmd_obj.is_multiline %}
# Handle multi-line command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# Execute multi-line command with error tracking
log "Executing multi-line {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "true" "false" || {
  log "{{ cmd_type }} command failed, but continuing execution for cleanup"
  # Don't exit on post-run errors to ensure all cleanup runs
}
{% elif cmd_obj.has_control_operators and '&&' in cmd_obj.control_operators %}
# Handle command with && operator
log "Command contains && operator: {{ cmd_obj.command | replace('"', '\\"') }}"

# Extract parts of the command before and after &&
FIRST_PART="{{ cmd_obj.command.split('&&')[0] }}"
REST_OF_CMD="{{ '&&'.join(cmd_obj.command.split('&&')[1:]) }}"

# Create output files for this command
FIRST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_first_part.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of {{ cmd_type }} command #{{ loop.index }} first part" > "$FIRST_OUTPUT"
echo "Command: ${FIRST_PART}" >> "$FIRST_OUTPUT"
echo "----------------------------------------" >> "$FIRST_OUTPUT"

# First execute the part before && and capture output
log "Executing first part: ${FIRST_PART}"
# Use bash -c to execute the command instead of eval to handle quotes better
bash -c "${FIRST_PART}" >> "$FIRST_OUTPUT" 2>&1
FIRST_STATUS=$?

# Record completion time for first part
echo "----------------------------------------" >> "$FIRST_OUTPUT"
echo "[$(date '+%Y-%m-%d %H:%M:%S")] First part completed with exit code: $FIRST_STATUS" >> "$FIRST_OUTPUT"

# Log the captured output
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} first part:" >> /app/logs/{{additional_param.service_name}}_commands.log
cat "$FIRST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log

if [ $FIRST_STATUS -eq 0 ]; then
  # If first part succeeded, execute the rest
  log "First part succeeded, executing rest: $REST_OF_CMD"
  if [ -n "$REST_OF_CMD" ]; then
    REST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_rest.log"
    echo "[$(date '+%Y-%m-%d %H:%M:%S")] Starting execution of {{ cmd_type }} command #{{ loop.index }} rest part" > "$REST_OUTPUT"
    echo "Command: ${REST_OF_CMD}" >> "$REST_OUTPUT" 
    echo "----------------------------------------" >> "$REST_OUTPUT"
    bash -c "${REST_OF_CMD}" >> "$REST_OUTPUT" 2>&1
    REST_STATUS=$?
    echo "----------------------------------------" >> "$REST_OUTPUT"
    echo "[$(date '+%Y-%m-%d %H:%M:%S")] Rest part completed with exit code: $REST_STATUS" >> "$REST_OUTPUT"
    
    # Log the captured output
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} rest part:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$REST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log
    
    if [ $REST_STATUS -ne 0 ]; then
      log "Rest of command failed: $REST_OF_CMD (status $REST_STATUS)"
      # Continue anyway for post-run commands to ensure cleanup
    fi
  fi
else
  log "First part of command {{ cmd_obj.command | replace('"', '\\"') }} failed with code $FIRST_STATUS, but continuing for cleanup"
  # Continue anyway for post-run commands to ensure cleanup
fi
{% elif cmd_obj.is_function_call %}
# Handle simple function call
log "Executing function call: {{ cmd_obj.command }}"
# Check if function exists first to avoid errors
if declare -f {{ cmd_obj.command }} > /dev/null; then
  {{ cmd_obj.command }} || {
    log "Function {{ cmd_obj.command }} failed, but continuing execution for cleanup"
  }
else
  log "WARNING: Function {{ cmd_obj.command }} does not exist, skipping"
fi
{% else %}
# Handle regular command
execute_with_error_tracking "{{ cmd_type }}" "{{ cmd_obj.command }}" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "false" "false" || {
  log "{{ cmd_type }} command failed, but continuing execution for cleanup"
}
{% endif %}
{% endfor %}
{% endif %}

# Summarize execution results
log "All commands executed. Check status.log for details."
report_exit $EXIT_CODE
exit $EXIT_CODE
