#!/bin/bash -x
# -x: trace every command (with expansions)

# Define helper functions
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> /app/logs/{{additional_param.service_name}}_setup.log;
}

check_connectivity() {
  local target="$1"
  local port="$2"
  log "Checking connectivity to $target:$port..."

  # Try ping first to check basic connectivity
  ping -c 3 "$target" > /app/logs/{{additional_param.service_name}}_connectivity.log 2>&1
  if [ $? -eq 0 ]; then
    log "Ping to $target successful"
    return 0
  else
    log "Ping to $target failed"
    return 1
  fi
}

report_exit() {
  local exit_code=$1
  echo "EXIT_CODE=$exit_code" >> /app/logs/{{additional_param.service_name}}_status.log
  if [ $exit_code -eq 0 ]; then
    echo "FAILED=false" >> /app/logs/{{additional_param.service_name}}_status.log
  else
    echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
  fi
}

set_environment() {
  # Set up any additional environment variables
  export DEBIAN_FRONTEND=noninteractive
}

# Initialize environment variables
log "Setting up environment variables..."
set_environment

# Fix double slashes in paths and environment variables
log "Normalizing paths and environment variables..."
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"//"* ]]; then
    normalized="${val//\/\//\/}"
    log "Fixing path variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

# Fix environment variables that contain $$ (escaping in templates)
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR\|IVY'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"\$\$"* ]]; then
    normalized="${val//\$\$/\$}"
    log "Fixing escaped variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

# Function to track command failures with details
execute_with_error_tracking() {
  local cmd_type="$1"
  local cmd="$2"
  local cmd_index="$3"
  local cmd_text="$4"
  local is_multiline="${5:-false}"
  local is_critical="${6:-true}"

  # Safely escape command text for logging (replacing " with \" for display purposes)
  local safe_cmd_text="${cmd_text//\"/\\\"}"

  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing $cmd_type command #$cmd_index: $safe_cmd_text" >> /app/logs/{{additional_param.service_name}}_commands.log

  # Create output file for this command's results
  local output_file="/app/logs/{{additional_param.service_name}}_${cmd_type}_cmd${cmd_index}_output.log"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of $cmd_type command #$cmd_index" > "$output_file"
  echo "Command: $safe_cmd_text" >> "$output_file"
  echo "----------------------------------------" >> "$output_file"

  # Execute the command and capture its exit code
  if [ "$is_multiline" = "true" ]; then
    # For multi-line commands, use a temporary script to ensure proper execution
    log "Executing multi-line command: ${safe_cmd_text}"
    local temp_script=$(mktemp)
    echo "#!/bin/bash" > "$temp_script"
    echo "set -e" >> "$temp_script"  # Exit on error
    # Write the raw command to the temp script without eval
    echo "$cmd" >> "$temp_script"
    chmod +x "$temp_script"

    # Execute the temporary script and capture output
    "$temp_script" >> "$output_file" 2>&1
    local exit_code=$?

    # Also log the output to the main command log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from $cmd_type command #$cmd_index:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log

    # Clean up
    rm -f "$temp_script"
  else
    log "Executing single-line command: ${safe_cmd_text}"

    # Use bash -c to execute commands with quotes
    # This avoids issues with eval and nested quotes
    bash -c "$cmd" >> "$output_file" 2>&1
    local exit_code=$?

    # Also log the output to the main command log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from $cmd_type command #$cmd_index:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log
  fi

  # Record completion time
  echo "----------------------------------------" >> "$output_file"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command completed with exit code: $exit_code" >> "$output_file"

  # Check if command failed
  if [ $exit_code -ne 0 ]; then
    # Always log the failure for tracking purposes
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $cmd_type command #$cmd_index failed with code $exit_code" >> /app/logs/{{additional_param.service_name}}_error.log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Failed command: $safe_cmd_text" >> /app/logs/{{additional_param.service_name}}_error.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_error.log

    # Only report failure to status file if the command is critical
    if [ "$is_critical" = "true" ]; then
      echo "ERROR_TYPE=${cmd_type}_FAILURE" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "FAILED_COMMAND=\"$safe_cmd_text\"" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "EXIT_CODE=$exit_code" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "COMMAND_INDEX=$cmd_index" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "COMMAND_TYPE=$cmd_type" >> /app/logs/{{additional_param.service_name}}_status.log
    fi

    # Return the exit code regardless of criticality
    return $exit_code
  else
    # Success case - log completion to the command log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $cmd_type command #$cmd_index completed successfully" >> /app/logs/{{additional_param.service_name}}_commands.log
  fi

  return 0
}

# Execute pre-compilation setup commands
log "Executing pre-compilation commands..."
{% if structured_commands.get("pre_compile_cmds") %}
{% for cmd_obj in structured_commands.get("pre_compile_cmds") %}
# Set command type for this context
cmd_type="PRE_COMPILE"

{% if not cmd_obj.is_critical %}
# Handle non-critical command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)

# This command is marked as non-critical, execute it but don't fail if it returns error
log "Executing non-critical {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "{% if cmd_obj.is_multiline %}true{% else %}false{% endif %}" "false" || {
  log "Non-critical {{ cmd_type }} command failed but continuing execution"
  # Don't exit here since this is a non-critical command
}
{% elif cmd_obj.is_function_definition %}
# Handle function definition
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# This is a function definition, execute it directly without tracking
log "Executing function definition: {{ cmd_obj.description }}"
# Just evaluate the function definition
eval "$MULTILINE_CMD"
{% elif cmd_obj.is_multiline %}
# Handle multi-line command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# Execute multi-line command with error tracking
log "Executing multi-line {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "true" "true" || {
  log "{{ cmd_type }} command failed. Exiting."
  exit $?
}
{% elif cmd_obj.has_control_operators and '&&' in cmd_obj.control_operators %}
# Handle command with && operator
log "Command contains && operator: {{ cmd_obj.command | replace('"', '\\"') }}"

# Extract parts of the command before and after &&
FIRST_PART="{{ cmd_obj.command.split('&&')[0] }}"
REST_OF_CMD="{{ '&&'.join(cmd_obj.command.split('&&')[1:]) }}"

# Create output files for this command
FIRST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_first_part.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of {{ cmd_type }} command #{{ loop.index }} first part" > "$FIRST_OUTPUT"
echo "Command: ${FIRST_PART}" >> "$FIRST_OUTPUT"
echo "----------------------------------------" >> "$FIRST_OUTPUT"

# First execute the part before && and capture output
log "Executing first part: ${FIRST_PART}"
# Use bash -c to execute the command instead of eval to handle quotes better
bash -c "${FIRST_PART}" >> "$FIRST_OUTPUT" 2>&1
FIRST_STATUS=$?

# Record completion time for first part
echo "----------------------------------------" >> "$FIRST_OUTPUT"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] First part completed with exit code: $FIRST_STATUS" >> "$FIRST_OUTPUT"

# Log the captured output
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} first part:" >> /app/logs/{{additional_param.service_name}}_commands.log
cat "$FIRST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log

if [ $FIRST_STATUS -eq 0 ]; then
  # If first part succeeded, execute the rest
  log "First part succeeded, executing rest: $REST_OF_CMD"
  if [ -n "$REST_OF_CMD" ]; then
    REST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_rest.log"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of {{ cmd_type }} command #{{ loop.index }} rest part" > "$REST_OUTPUT"
    echo "Command: ${REST_OF_CMD}" >> "$REST_OUTPUT" 
    echo "----------------------------------------" >> "$REST_OUTPUT"
    bash -c "${REST_OF_CMD}" >> "$REST_OUTPUT" 2>&1
    REST_STATUS=$?
    echo "----------------------------------------" >> "$REST_OUTPUT"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Rest part completed with exit code: $REST_STATUS" >> "$REST_OUTPUT"
    
    # Log the captured output
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} rest part:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$REST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log
    
    if [ $REST_STATUS -ne 0 ]; then
      log "Rest of command failed: $REST_OF_CMD (status $REST_STATUS)"
      exit $REST_STATUS
    fi
  fi
else
  exit $FIRST_STATUS
fi
{% elif cmd_obj.is_function_call %}
# Handle simple function call
log "Executing function call: {{ cmd_obj.command }}"
# Check if function exists first to avoid errors
if declare -f {{ cmd_obj.command }} > /dev/null; then
  {{ cmd_obj.command }} || {
    log "Function {{ cmd_obj.command }} failed. Exiting."
    exit $?
  }
else
  log "ERROR: Function {{ cmd_obj.command }} does not exist"
  exit 1
fi
{% else %}
# Handle regular command
execute_with_error_tracking "{{ cmd_type }}" "{{ cmd_obj.command }}" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "false" "true" || {
  log "{{ cmd_type }} command failed. Exiting."
  exit $?
}
{% endif %}
{% endfor %}

