include LICENSE.md
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include install.md
include pyproject.toml
include requirements.txt

recursive-include panther *.py *.yml *.yaml *.jinja *.sh *.j2
recursive-include panther/webapp *
recursive-include panther/plugins *
recursive-include docs_build *

# Not the mirror image of the include above. setuptools-scm is in
# [build-system].requires and registers a setuptools.file_finders entry point,
# so manifest_maker.add_defaults calls walk_revctrl() and adds every
# git-tracked file to the sdist filelist before this template is read at all.
# The corpus of plans and specs under docs/ is tracked, so no include names it
# and no missing include keeps it out -- only this prune does. It is anchored
# on docs/ and leaves docs_build/ alone.
prune docs

prune panther/plugins/services/testers/panther_ivy/protocol-testing/apt/test/nordsec
prune panther/plugins/services/testers/panther_ivy/submodules
prune tests
prune build
prune outputs
prune outputs_*
prune .github
prune .git
