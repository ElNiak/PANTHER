#!/usr/bin/env python3
"""
PANTHER Protocol Server Plugin Template for {{ plugin_name }}

This template implements a server for the {{ plugin_name }} protocol.
"""

from panther.plugins.protocols.protocol_interface import ProtocolServerInterface
from typing import Dict, Any, Optional, List, Callable

class {{ class_name }}(ProtocolServerInterface):
    """
    Server implementation for the {{ plugin_name }} protocol.
    
    This class implements the server-side functionality of the protocol.
    """
    
    def __init__(self):
        """Initialize the protocol server plugin."""
        super().__init__()
        self.name = "{{ plugin_name }}_server"
        self.description = "Server for {{ plugin_name.title() }} protocol"
        self.running = False
        self.config = None
        self.clients = []
        self.request_handlers = {}
    
    def start(self, config: Optional[Dict[str, Any]] = None) -> bool:
        """
        Start the protocol server.
        
        Args:
            config: Configuration parameters for the server
            
        Returns:
            bool: True if the server was started successfully
        """
        if self.running:
            return True
            
        self.config = config or {}
        
        host = self.config.get("host", "0.0.0.0")
        port = self.config.get("port", 8080)
        print(f"Starting {self.name} server on {host}:{port}")
        
        # TODO: Implement server startup logic
        # This might include:
        # - Opening a listening socket
        # - Initializing server resources
        # - Setting up thread pools or async loops
        
        self.running = True
        return True
    
    def stop(self) -> bool:
        """
        Stop the protocol server.
        
        Returns:
            bool: True if the server was stopped successfully
        """
        if not self.running:
            return True
            
        print(f"Stopping {self.name} server")
        
        # TODO: Implement server shutdown logic
        # This might include:
        # - Closing connections
        # - Releasing resources
        # - Stopping threads or async tasks
        
        self.running = False
        self.clients = []
        return True
    
    def register_request_handler(self, request_type: str, handler: Callable) -> bool:
        """
        Register a handler for a specific request type.
        
        Args:
            request_type: Type of request to handle
            handler: Function to call when the request is received
            
        Returns:
            bool: True if the handler was registered successfully
        """
        print(f"Registering handler for {request_type} requests")
        self.request_handlers[request_type] = handler
        return True
    
    def send_to_client(self, client_id: str, message_type: str, data: Any) -> bool:
        """
        Send a message to a specific client.
        
        Args:
            client_id: ID of the client to send to
            message_type: Type of message to send
            data: Data to send with the message
            
        Returns:
            bool: True if the message was sent successfully
        """
        if not self.running:
            return False
            
        # Find the client
        client = next((c for c in self.clients if c.get("id") == client_id), None)
        if not client:
            print(f"Client {client_id} not found")
            return False
            
        print(f"Sending {message_type} message to client {client_id}")
        
        # TODO: Implement client messaging logic
        # This might include:
        # - Serializing the message data
        # - Sending the message to the client
        
        return True
    
    def broadcast(self, message_type: str, data: Any, exclude_clients: Optional[List[str]] = None) -> bool:
        """
        Broadcast a message to all connected clients.
        
        Args:
            message_type: Type of message to send
            data: Data to send with the message
            exclude_clients: List of client IDs to exclude from the broadcast
            
        Returns:
            bool: True if the broadcast was sent successfully
        """
        if not self.running:
            return False
            
        exclude = exclude_clients or []
        target_clients = [c for c in self.clients if c.get("id") not in exclude]
        
        print(f"Broadcasting {message_type} message to {len(target_clients)} clients")
        
        # TODO: Implement broadcast logic
        # This might include:
        # - Serializing the message data
        # - Sending to all clients in parallel
        
        return True
    
    def get_server_info(self) -> Dict[str, Any]:
        """
        Get information about the server.
        
        Returns:
            Dict[str, Any]: Server information
        """
        info = {
            "name": self.name,
            "running": self.running,
            "client_count": len(self.clients),
        }
        
        if self.running and self.config:
            info.update({
                "host": self.config.get("host", "0.0.0.0"),
                "port": self.config.get("port", 8080),
                "protocol": "{{ plugin_name }}",
                "version": self.config.get("version", "1.0"),
                "uptime": 0,  # You could add actual uptime here
            })
            
        return info
    
    def get_connected_clients(self) -> List[Dict[str, Any]]:
        """
        Get a list of connected clients.
        
        Returns:
            List[Dict[str, Any]]: List of client information
        """
        return [
            {
                "id": client.get("id"),
                "address": client.get("address"),
                "connected_since": client.get("connected_since")
            }
            for client in self.clients
        ]
