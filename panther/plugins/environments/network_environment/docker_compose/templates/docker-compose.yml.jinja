name: {{ experiment_name | lower }}
# When no services are provided, a placeholder service is used
services:
{% for service in services %}
  {{ service.service_name  }}:
{# Follow same logic as service_manager_docker_mixin.py #}
{% set base_version = service.service_protocol.version or 'latest' %}
{% set build_suffix = ('-' + service.build_mode) if service.build_mode else '' %}
{% set runtime_suffix = ('-' + service.runtime_mode) if service.runtime_mode and service.runtime_mode != 'minimal' else '' %}
{% set platform_suffix = ('-' + additional_param.computed_target_platform) if additional_param.computed_target_platform else '' %}
{% set base_name = (service.implementation_name + '-' + base_version) if base_version else service.implementation_name %}
{% set tag_version = 'latest' %}
{% set image_name = base_name + ':' + tag_version + build_suffix + runtime_suffix + platform_suffix %}
{# Sanitize the image name to meet Docker naming requirements #}
{% set image_name = image_name.lower() %}
{% set image_name = image_name | regex_replace('[^a-z0-9._:-]', '-') %}
{% set image_name = image_name | regex_replace('^[.-]+', '') %}
{% if image_name | length > 128 %}
  {% set parts = image_name.split(':') %}
  {% if parts | length == 2 %}
    {% set name_part = parts[0] %}
    {% set tag_part = parts[1] %}
    {% set max_name_length = 128 - tag_part | length - 1 %}
    {% if name_part | length > max_name_length %}
      {% set name_part = name_part[:max_name_length] %}
    {% endif %}
    {% set image_name = name_part + ':' + tag_part %}
  {% else %}
    {% set image_name = image_name[:128] %}
  {% endif %}
{% endif %}
{% if additional_param.docker_config and additional_param.docker_config.pull_policy in ['never', 'build'] %}
    build:
      context: {{ paths.plugin_dir }}/services/iut/{{ service.service_protocol.name }}/{{ service.implementation_name }}
      dockerfile: Dockerfile
      args:
        VERSION: {{ version }}
        BUILD_MODE: {{ service.build_mode or '' }}
    image: {{ image_name }}
{% else %}
    image: {{ image_name }}
{% endif %}
{% if additional_param.docker_config and additional_param.docker_config.pull_policy and additional_param.docker_config.pull_policy != 'never' %}
    pull_policy: {{ additional_param.docker_config.pull_policy }}
{% endif %}
    container_name: {{ service.service_name  }}
    platform: {{ additional_param.computed_target_platform or 'linux/amd64' }}
    stop_grace_period: 15s
    {% if docker_user_mapping %}
    user: "{{ docker_user_mapping }}"
    {% endif %}
    {% if service.service_config_to_test.ports %}
    ports:
      {% for port in service.service_config_to_test.ports %}
      - "{{ port }}"
      {% endfor %}
    {% endif %}
    # Dependencies removed - coordination handled in entrypoint scripts
    environment:
      SSLKEYLOGFILE: "/app/logs/sslkeylogfile.txt"
      ZRTT_SSLKEYLOG_FILE: "/app/logs/zrtt_sslkeylogfile.txt"
      UID: "${UID}"
      GID: "${GID}"
      {% for key, value in service.environments.items() %}
      {{ key }}: "{{ value }}"
      {% endfor %}
    tty: true
    stdin_open: true
    sysctls:
      - net.ipv6.conf.all.disable_ipv6=1
    security_opt: # TODO: check if this is needed
      - seccomp:unconfined
    #devices: # iGPU passthrough
    #  - /dev/dri:/dev/dri
    hostname: {{ service.service_name }}
    domainname: panther.local
    # TODO fix in the docker
    cap_add:
      - CAP_NET_ADMIN
      - CAP_NET_RAW
      - SYS_PTRACE
      - SYS_ADMIN
      - SYS_TIME
      - PERFMON
    ulimits:
      core: -1
    tmpfs:
      - /dev/shm:rw,nosuid,nodev,exec,size=512g
    working_dir: "{{ service.run_cmd["run_cmd"]["working_dir"] }}"
    entrypoint:
      - /bin/bash
      - -c
      - |
        chmod +x /app/entrypoint.sh \
        && exec /app/entrypoint.sh

    # TODO fix sudo tshark
    volumes:
      - {{ log_dir | realpath }}/{{ service.service_name  }}:/app/logs/
      - {{ output_dir | realpath }}/entrypoint_{{ service.service_name  }}.sh:/app/entrypoint.sh
      # Certificate volume mounting
      {% if service.service_config_to_test.generate_new_certificates %}
      - {{ output_dir | realpath }}/certs:/opt/certs
      {% endif %}
      - {{ output_dir | realpath }}/ticket:/opt/ticket
      - "coordination:/app/coordination"
      {% for volume in service.volumes %}
      {% if volume | is_dict %}
      - "{{ volume.local | realpath }}:{{ volume.container }}"
      {% else %}
      - "{{ volume }}"
      {% endif %}
      {% endfor %}
    networks:
      panther_network:
        aliases:
          - {{ service.service_name  }}
    # Simple health check: container is running
    healthcheck:
      test: ["CMD", "true"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 5s
{% endfor %}

networks:
  panther_network:
    driver: bridge


volumes:
  shared_logs:
    driver: local
  coordination:
    driver: local
  ticket:
    driver: local
  certs:
    driver: local
  logs:
    driver: local
