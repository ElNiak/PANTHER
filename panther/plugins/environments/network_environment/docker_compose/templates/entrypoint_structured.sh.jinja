#!/bin/bash -x
# -x: trace every command (with expansions)

# Define helper functions
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> /app/logs/{{additional_param.service_name}}_setup.log;
}

check_connectivity() {
  local target="$1"
  local port="$2"
  log "Checking connectivity to $target:$port..."

  # Try ping first to check basic connectivity
  ping -c 3 "$target" > /app/logs/{{additional_param.service_name}}_connectivity.log 2>&1
  if [ $? -eq 0 ]; then
    log "Ping to $target successful"
    return 0
  else
    log "Ping to $target failed"
    return 1
  fi
}

report_exit() {
  local exit_code=$1
  echo "EXIT_CODE=$exit_code" >> /app/logs/{{additional_param.service_name}}_status.log
  if [ $exit_code -eq 0 ]; then
    echo "FAILED=false" >> /app/logs/{{additional_param.service_name}}_status.log
  else
    echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
  fi
}

set_environment() {
  # Set up any additional environment variables
  export DEBIAN_FRONTEND=noninteractive
}

# Initialize environment variables
log "Setting up environment variables..."
set_environment

# Fix double slashes in paths and environment variables
log "Normalizing paths and environment variables..."
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"//"* ]]; then
    normalized="${val//\/\//\/}"
    log "Fixing path variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

# Fix environment variables that contain $$ (escaping in templates)
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR\|IVY'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"\$\$"* ]]; then
    normalized="${val//\$\$/\$}"
    log "Fixing escaped variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

{% if structured_commands %}
# Stage: Pre-compile commands
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting pre-compile commands" >> /app/logs/{{additional_param.service_name}}_commands.log

{% for cmd in structured_commands.pre_compile_cmds %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing pre-compile command: {{ cmd|quote_shell }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{{ cmd }}
{% endfor %}

# Stage: Compile commands
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting compile commands" >> /app/logs/{{additional_param.service_name}}_commands.log

{% for cmd in structured_commands.compile_cmds %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing compile command: {{ cmd|quote_shell }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{{ cmd }}
{% endfor %}

# Stage: Post-compile commands
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting post-compile commands" >> /app/logs/{{additional_param.service_name}}_commands.log

{% for cmd in structured_commands.post_compile_cmds %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing post-compile command: {{ cmd|quote_shell }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{{ cmd }}
{% endfor %}

# Stage: Pre-run commands
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting pre-run commands" >> /app/logs/{{additional_param.service_name}}_commands.log

{% for cmd in structured_commands.pre_run_cmds %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing pre-run command: {{ cmd|quote_shell }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{{ cmd }}
{% endfor %}

# Stage: Main run command
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting main run command" >> /app/logs/{{additional_param.service_name}}_commands.log

{% if structured_commands.run_cmd %}
# Set environment variables for main command
{% for key, value in structured_commands.run_cmd.env_vars.items() %}
export {{ key }}={{ value|quote_shell }}
{% endfor %}

# Change to working directory
cd {{ structured_commands.run_cmd.working_dir|quote_shell }}

# Execute main command with proper arguments
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing main command in {{ structured_commands.run_cmd.working_dir }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{% for arg in structured_commands.run_cmd.command_args %}{{ arg|quote_shell }} {% endfor %}

{% else %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] No main command specified" >> /app/logs/{{additional_param.service_name}}_commands.log
{% endif %}

# Stage: Post-run commands
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting post-run commands" >> /app/logs/{{additional_param.service_name}}_commands.log

{% for cmd in structured_commands.post_run_cmds %}
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing post-run command: {{ cmd|quote_shell }}" >> /app/logs/{{additional_param.service_name}}_commands.log
{{ cmd }}
{% endfor %}

{% else %}
# Legacy command handling - this section uses the old approach for backward compatibility
# Pre-compile commands
{% for cmd in additional_param.run_cmd.pre_compile_cmds %}
{{ cmd }}
{% endfor %}

# Compile commands
{% for cmd in additional_param.run_cmd.compile_cmds %}
{{ cmd }}
{% endfor %}

# Post-compile commands
{% for cmd in additional_param.run_cmd.post_compile_cmds %}
{{ cmd }}
{% endfor %}

# Pre-run commands
{% for cmd in additional_param.run_cmd.pre_run_cmds %}
{{ cmd }}
{% endfor %}

# Main run command
cd {{ additional_param.run_cmd.run_cmd.working_dir }}
{{ additional_param.run_cmd.run_cmd.command_binary }} {{ additional_param.run_cmd.run_cmd.command_args }}

# Post-run commands
{% for cmd in additional_param.run_cmd.post_run_cmds %}
{{ cmd }}
{% endfor %}
{% endif %}

# Final cleanup
log "Entrypoint script completed"
exit 0
