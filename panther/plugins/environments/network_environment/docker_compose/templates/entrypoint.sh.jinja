#!/bin/bash -x
# -x: trace every command (with expansions)

# Define helper functions
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> /app/logs/{{additional_param.service_name}}_setup.log;
}

check_connectivity() {
  local target="$1"
  local port="$2"
  log "Checking connectivity to $target:$port..."

  # Try ping first to check basic connectivity
  ping -c 3 "$target" > /app/logs/{{additional_param.service_name}}_connectivity.log 2>&1
  if [ $? -eq 0 ]; then
    log "Ping to $target successful"
    return 0
  else
    log "Ping to $target failed"
    return 1
  fi
}

report_exit() {
  local exit_code=$1
  echo "EXIT_CODE=$exit_code" >> /app/logs/{{additional_param.service_name}}_status.log
  if [ $exit_code -eq 0 ]; then
    echo "FAILED=false" >> /app/logs/{{additional_param.service_name}}_status.log
  else
    echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
  fi
}

set_environment() {
  # Set up any additional environment variables
  export DEBIAN_FRONTEND=noninteractive
}

# Initialize environment variables
log "Setting up environment variables..."
set_environment

# Fix double slashes in paths and environment variables
log "Normalizing paths and environment variables..."
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"//"* ]]; then
    normalized="${val//\/\//\/}"
    log "Fixing path variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

# Fix environment variables that contain $$ (escaping in templates)
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR\|IVY'); do
  val=$(eval echo "\$$var")
  if [[ "$val" == *"\$\$"* ]]; then
    normalized="${val//\$\$/\$}"
    log "Fixing escaped variable $var: $val -> $normalized"
    eval "export $var=\"$normalized\""
  fi
done

# Function to track command failures with details
execute_with_error_tracking() {
  local cmd_type="$1"
  local cmd="$2"
  local cmd_index="$3"
  local cmd_text="$4"
  local is_multiline="${5:-false}"
  local is_critical="${6:-true}"

  # Special handling for shell option commands like "set -x;"
  # These may interfere with the logging/error tracking when executed through eval
  if [[ "$cmd" == "set -"* ]]; then
    log "Detected shell option command: $cmd - handling directly"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Shell option command: $cmd_text - handled directly" >> /app/logs/{{additional_param.service_name}}_commands.log
    # Log the command but don't execute it through eval
    # It's already handled in the shebang line or in set_environment
    return 0
  fi

  # Check if the command is a single-word function call
  if [[ "$cmd" =~ ^[a-zA-Z0-9_]+$ ]]; then
    local func_name="$cmd"
    # Check if the function exists before calling it
    if ! declare -f "$func_name" > /dev/null; then
      log "ERROR: Function '$func_name' not found - checking for related functions..."
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: Attempted to call undefined function '$func_name'" >> /app/logs/{{additional_param.service_name}}_error.log

      # Check for similarly named functions as a fallback
      local similar_func=$(declare -F | grep -o "$func_name[^ ]*" | head -1)
      if [ -n "$similar_func" ]; then
        log "Found similar function '$similar_func', will use it instead"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Using '$similar_func' as a fallback for '$func_name'" >> /app/logs/{{additional_param.service_name}}_commands.log
        cmd="$similar_func"
        cmd_text="$similar_func # (fallback for $func_name)"
      else
        # List all available functions for debugging
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Available functions:" >> /app/logs/{{additional_param.service_name}}_error.log
        declare -F >> /app/logs/{{additional_param.service_name}}_error.log

        if [ "$is_critical" = "true" ]; then
          echo "ERROR_TYPE=UNDEFINED_FUNCTION" >> /app/logs/{{additional_param.service_name}}_status.log
          echo "UNDEFINED_FUNCTION=$func_name" >> /app/logs/{{additional_param.service_name}}_status.log
          echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
          echo "EXIT_CODE=127" >> /app/logs/{{additional_param.service_name}}_status.log
          log "Function '$func_name' not found and is critical. Exiting."
          return 127
        else
          log "Function '$func_name' not found but not critical. Continuing."
          return 0
        fi
      fi
    fi
  fi

  # Safely escape command text for logging (replacing " with \" for display purposes)
  local safe_cmd_text="${cmd_text//\"/\\\"}"

  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Executing $cmd_type command #$cmd_index: $safe_cmd_text" >> /app/logs/{{additional_param.service_name}}_commands.log

  # Create output file for this command's results
  local output_file="/app/logs/{{additional_param.service_name}}_${cmd_type}_cmd${cmd_index}_output.log"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of $cmd_type command #$cmd_index" > "$output_file"
  echo "Command: $safe_cmd_text" >> "$output_file"
  echo "----------------------------------------" >> "$output_file"

  # Execute the command and capture its exit code
  if [ "$is_multiline" = "true" ]; then
    # For multi-line commands, use a temporary script to ensure proper execution
    log "Executing multi-line command: ${safe_cmd_text}"
    local temp_script=$(mktemp)
    echo "#!/bin/bash" > "$temp_script"
    echo "set -e" >> "$temp_script"  # Exit on error
    # Write the raw command to the temp script without eval
    echo "$cmd" >> "$temp_script"
    chmod +x "$temp_script"

    # Execute the temporary script and capture output
    "$temp_script" >> "$output_file" 2>&1
    local exit_code=$?

    # Also log the output to the main command log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from $cmd_type command #$cmd_index:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log

    # Clean up
    rm -f "$temp_script"
  else
    log "Executing single-line command: ${safe_cmd_text}"

    # Use bash -c to execute commands with quotes
    # This avoids issues with eval and nested quotes
    bash -c "$cmd" >> "$output_file" 2>&1
    local exit_code=$?

    # Also log the output to the main command log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from $cmd_type command #$cmd_index:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log
  fi

  # Record completion time
  echo "----------------------------------------" >> "$output_file"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command completed with exit code: $exit_code" >> "$output_file"

  # Check if command failed
  if [ $exit_code -ne 0 ]; then
    # Always log the failure for tracking purposes
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $cmd_type command #$cmd_index failed with code $exit_code" >> /app/logs/{{additional_param.service_name}}_error.log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Failed command: $safe_cmd_text" >> /app/logs/{{additional_param.service_name}}_error.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_error.log

    # Only report failure to status file if the command is critical
    if [ "$is_critical" = "true" ]; then
      echo "ERROR_TYPE=${cmd_type}_FAILURE" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "FAILED_COMMAND=\"$safe_cmd_text\"" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "FAILED=true" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "EXIT_CODE=$exit_code" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "COMMAND_INDEX=$cmd_index" >> /app/logs/{{additional_param.service_name}}_status.log
      echo "COMMAND_TYPE=$cmd_type" >> /app/logs/{{additional_param.service_name}}_status.log

      # Capture relevant logs for context
      if [ -f "/app/logs/ivy_setup.log" ] && [ "$cmd_type" = "COMPILE" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Attaching Ivy setup log for context" >> /app/logs/{{additional_param.service_name}}_error.log
        cat /app/logs/ivy_setup.log >> /app/logs/{{additional_param.service_name}}_error.log
      fi

      # Check for specific errors in commands related to Ivy setup
      if [[ "$safe_cmd_text" == *"setup.py install"* || "$safe_cmd_text" == *"panther_ivy"* ]]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] Detected Ivy setup failure, attempting to fix paths..." >> /app/logs/{{additional_param.service_name}}_error.log
        # Log environment variables for debugging
        env | grep -i ivy >> /app/logs/{{additional_param.service_name}}_ivy_env.log
        env | grep -i path >> /app/logs/{{additional_param.service_name}}_path_env.log
      fi

      # Create a specific error log file for this failure
      echo "Command '$safe_cmd_text' failed with exit code $exit_code" > /app/logs/{{additional_param.service_name}}_${cmd_type}_failure.log
      echo "Execution stopped at $(date)" >> /app/logs/{{additional_param.service_name}}_${cmd_type}_failure.log
      cat "$output_file" >> /app/logs/{{additional_param.service_name}}_${cmd_type}_failure.log
    else
      # For non-critical commands, just note in the logs that we're ignoring the error
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] Non-critical command failure, continuing execution" >> /app/logs/{{additional_param.service_name}}_error.log

      # Create a warning log instead of a failure log
      echo "Non-critical command '$safe_cmd_text' failed with exit code $exit_code" > /app/logs/{{additional_param.service_name}}_${cmd_type}_warning.log
      echo "Execution continuing despite error at $(date)" >> /app/logs/{{additional_param.service_name}}_${cmd_type}_warning.log
    fi

    # Return the exit code regardless of criticality
    return $exit_code
  else
    # Success case - log completion to the command log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $cmd_type command #$cmd_index completed successfully" >> /app/logs/{{additional_param.service_name}}_commands.log
  fi

  return 0
}

# Execute pre-compilation setup commands
log "Executing pre-compilation commands..."
{% for cmd in additional_param.run_cmd["pre_compile_cmds"] %}
{% if 'PANTHER_NON_CRITICAL_COMMAND' in cmd %}
# Extract the actual command without the marker line and leading newline
{% set actual_cmd = cmd.replace('# PANTHER_NON_CRITICAL_COMMAND\n', '') %}
# Handle non-critical multi-line command as a complete unit
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ actual_cmd }}
ENDOFCOMMAND
)

# Set command type for this context
cmd_type="PRE_COMPILE"

# Special handling for function definitions
if [[ "$MULTILINE_CMD" == *"# PANTHER_FUNCTION_DEFINITION"* ]]; then
  # This is a function definition, execute it directly without tracking
  log "Detected function definition with marker, executing directly"
  # Remove the special comment marker
  MULTILINE_CMD="${MULTILINE_CMD/\# PANTHER_FUNCTION_DEFINITION/}"
  # Just evaluate the function definition
  eval "$MULTILINE_CMD"
  # Skip the error tracking since this is just defining a function, not executing commands
elif [[ "$MULTILINE_CMD" =~ ^[[:space:]]*[a-zA-Z0-9_]+\(\)[[:space:]]*\{.* ]] && [[ "$MULTILINE_CMD" == *"}"* ]]; then
  # This is a function definition detected by syntax pattern
  log "Detected function definition by syntax, executing directly"
  # Just evaluate the function definition
  eval "$MULTILINE_CMD"
  # Skip the error tracking since this is just defining a function, not executing commands
elif [[ "$MULTILINE_CMD" == *"panther_ivy"* || "$MULTILINE_CMD" == *"setup.py"* ]]; then
  log "Special handling for Ivy related pre-compile command"

  # Fix double slashes in paths if present
  MULTILINE_CMD="${MULTILINE_CMD//\/\//\/}"

  # Fix escaped variables
  MULTILINE_CMD="${MULTILINE_CMD//\$\$/\$}"

  # Make sure directories exist
  if [[ "$MULTILINE_CMD" == *"cd /opt/panther_ivy"* ]]; then
    log "Ensuring panther_ivy directory exists"
    mkdir -p /opt/panther_ivy
  fi

  execute_with_error_tracking "PRE_COMPILE" "$MULTILINE_CMD" "{{ loop.index }}" "Non-critical: {{ actual_cmd | replace('"', '\\"') | truncate(50, true, '...') }}" "true" "false" || {
    log "Non-critical pre-compilation command failed. Continuing execution."
    # Special handling for specific types of commands
    if [[ "$MULTILINE_CMD" == *"setup.py"* ]]; then
      log "Python setup.py failed - attempting to collect diagnostic information"
      python3.10 --version > /app/logs/python_info.log 2>&1
      pip3 list >> /app/logs/python_info.log 2>&1
    fi
    # Don't exit here since this is a non-critical command
  }
else
  execute_with_error_tracking "PRE_COMPILE" "$MULTILINE_CMD" "{{ loop.index }}" "Non-critical: {{ actual_cmd | replace('"', '\\"') | truncate(50, true, '...') }}" "true" "false" || {
    log "Non-critical pre-compilation command failed. Continuing execution."
    # Don't exit here since this is a non-critical command
  }
fi
{% elif 'while ' in cmd or 'for ' in cmd or 'if ' in cmd %}
# Handle multi-line command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd }}
ENDOFCOMMAND
)
execute_with_error_tracking "PRE_COMPILE" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd | replace('"', '\\"') }}" "true" "true" || {
  log "Pre-compilation command failed. Exiting."
  exit $?
}
{% else %}
# Handle regular command
execute_with_error_tracking "PRE_COMPILE" "{{ cmd }}" "{{ loop.index }}" "{{ cmd | replace('"', '\\"') }}" "false" "true" || {
  log "Pre-compilation command failed. Exiting."
  exit $?
}
{% endif %}
{% endfor %}

