eval "$MULTILINE_CMD"
{% elif '&&' in cmd and cmd.split('&&')[0].strip() and cmd.split('&&')[0].strip().isalnum() %}
# Special handling for function calls with && operator
{% set func_name = cmd.split('&&')[0].strip() if '&&' in cmd else cmd.split()[0] %}
log "Detected function call with &&: {{ cmd }}, function name: {{ func_name }}"

# Check if the function exists before calling it
if declare -f {{ func_name }} > /dev/null; then
  log "Function {{ func_name }} exists, executing"

  # Special handling for commands with &&
  {% if '&&' in cmd %}
  # Extract the first part of the command (before &&)
  log "Command contains &&, executing parts separately"
  FIRST_PART=$(echo "{{ cmd }}" | cut -d '&' -f 1)

  # Create output file for this command's first part
  FIRST_OUTPUT="/app/logs/{{additional_param.service_name}}_PRE_COMPILE_cmd{{ loop.index }}_first_part.log"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of PRE_COMPILE command #{{ loop.index }} first part" > "$FIRST_OUTPUT"
  echo "Command: $FIRST_PART" >> "$FIRST_OUTPUT"
  echo "----------------------------------------" >> "$FIRST_OUTPUT"

  # Execute first part and capture output
  $FIRST_PART >> "$FIRST_OUTPUT" 2>&1
  FIRST_STATUS=$?

  # Record completion time
  echo "----------------------------------------" >> "$FIRST_OUTPUT"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] First part completed with exit code: $FIRST_STATUS" >> "$FIRST_OUTPUT"

  # Log the captured output
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from PRE_COMPILE command #{{ loop.index }} first part:" >> /app/logs/{{additional_param.service_name}}_commands.log
  cat "$FIRST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log

  log "First part exit status: $FIRST_STATUS"

  if [ $FIRST_STATUS -eq 0 ]; then
    # If first part succeeded, execute the rest
    REST_OF_CMD=$(echo "{{ cmd }}" | cut -d '&' -f 3-)
    log "Executing rest of command: $REST_OF_CMD"

    if [ -n "$REST_OF_CMD" ]; then
      execute_with_error_tracking "PRE_COMPILE" "$REST_OF_CMD" "{{ loop.index }}" "Rest of {{ cmd | replace('"', '\\"') }}" "false" "true" || {
        log "Rest of command {{ cmd }} failed. Exiting."
        exit $?
      }
    fi
  else
    log "First part of command {{ cmd }} failed with code $FIRST_STATUS. Exiting."
    exit $FIRST_STATUS
  fi
  {% else %}
  # Regular function call without &&
  execute_with_error_tracking "PRE_COMPILE" "{{ cmd }}" "{{ loop.index }}" "{{ cmd | replace('"', '\\"') }}" "false" "true" || {
    log "Function call {{ cmd }} failed. Exiting."
    exit $?
  }
  {% endif %}
else
  # Function not found - error out as fallbacks are not allowed
  log "ERROR: Function '{{ func_name }}' does not exist and no fallbacks are permitted"
  echo "ERROR_TYPE=UNDEFINED_FUNCTION" >> /app/logs/{{additional_param.service_name}}_status.log
