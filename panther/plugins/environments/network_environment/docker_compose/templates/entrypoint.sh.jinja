#!/bin/bash -x
# -x: trace every command (with expansions)
{# Jinja2 Macros for reducing code duplication #}
{% macro handle_control_operator_command(cmd_obj, phase_name, loop_index) %}
# Handle command with && operator
{% set safe_cmd = cmd_obj.shell_safe_command | default(cmd_obj.command | replace('"', '\\"')) %}
log "Executing command with && operator: {{ cmd_obj.command | replace('"', '\"') }}"

# Since working directory is now handled via metadata, execute the full command directly
execute_with_error_tracking "{{ phase_name }}" "{{ safe_cmd }}" "{{ loop_index }}" "false" "true"
CMD_STATUS=$?

if [ "${CMD_STATUS:-1}" -ne 0 ]; then
  exit $CMD_STATUS
fi
{% endmacro %}

{% macro execute_command_phase(commands, phase_name) %}
{% if commands %}
# Create phase-specific output directory
PHASE_DIR="/app/logs/{{ phase_name | lower | replace('_', '-') }}"
mkdir -p "$PHASE_DIR"
log "Created phase directory: $PHASE_DIR"

# Set up phase-specific output redirection
PHASE_STDOUT="$PHASE_DIR/stdout.log"
PHASE_STDERR="$PHASE_DIR/stderr.log"


# Initialize phase log files with header
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Starting {{ phase_name }} phase ===" > "$PHASE_STDOUT"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Starting {{ phase_name }} phase ===" > "$PHASE_STDERR"

{% for cmd_obj in commands %}
# Set command type for this context
cmd_type="{{ phase_name }}"

{% if cmd_obj.metadata.working_directory %}
# Change to working directory for this command
SAVED_PWD="$(pwd)"
cd "{{ cmd_obj.metadata.working_directory }}" || {
  log "Failed to change to directory: {{ cmd_obj.metadata.working_directory }}"
  exit 1
}
log "Changed to working directory: {{ cmd_obj.metadata.working_directory }}"
{% endif %}

{% if cmd_obj.metadata.is_empty %}
log "Skipping empty $cmd_type command #{{ loop.index }}"

{% elif cmd_obj.metadata.is_environment_variable_assignment %}
{{ cmd_obj.command }}

{% elif not cmd_obj.metadata.is_critical %}
# Handle non-critical command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)

# This command is marked as non-critical, execute it but don't fail if it returns error
log "Executing non-critical $cmd_type command #{{ loop.index }}"
execute_with_error_tracking "{{ phase_name }}" "$MULTILINE_CMD" "{{ loop.index }}" "{% if cmd_obj.metadata.is_multiline %}true{% else %}false{% endif %}" "false" || {
  log "WARNING: Non-critical command failed but continuing execution"
}
{% elif cmd_obj.metadata.is_function_definition %}
# Handle function definition
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# This is a function definition, needs to be defined in the global scope
log "Executing function definition: {{ cmd_obj.metadata.description }}"
# Export the function to ensure it's available to all subprocesses
eval "$MULTILINE_CMD"
# Verify the function was properly defined
# Extract function name more reliably - handle both "name()" and "name() {" formats
FUNC_NAME=$(echo "{{ cmd_obj.command }}" | grep -o '^[[:space:]]*[[:alnum:]_]*[[:space:]]*()' | sed 's/[[:space:]]*()$//' | xargs)
if ! declare -f "$FUNC_NAME" > /dev/null; then
  log "ERROR: Function $FUNC_NAME failed to define correctly"
  exit 1
else
  log "Function $FUNC_NAME defined successfully"
fi
{% elif cmd_obj.metadata.is_multiline %}
# Handle multi-line command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# Execute multi-line command with error tracking
log "Executing multi-line $cmd_type command #{{ loop.index }}"
execute_with_error_tracking "{{ phase_name }}" "$MULTILINE_CMD" "{{ loop.index }}" "true" "true" || {
  exit $?
}

{% elif cmd_obj.metadata.has_control_operators and '&&' in cmd_obj.metadata.control_operators %}
{{ handle_control_operator_command(cmd_obj, phase_name, loop.index) }}

{% elif cmd_obj.metadata.is_variable_assignment or cmd_obj.metadata.is_shell_builtin or cmd_obj.metadata.is_control_structure %}
# Handle special command types that need eval: variable assignment, shell builtin, control structure
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
log "Executing {{ cmd_obj.metadata.is_variable_assignment and 'variable assignment' or cmd_obj.metadata.is_shell_builtin and 'shell builtin' or 'control structure' }}: {{ cmd_obj.command | replace('"', '\\"') }}"
# Use execute_with_error_tracking but with eval mode for proper syntax handling
execute_with_error_tracking "{{ phase_name }}" "eval \"$MULTILINE_CMD\"" "{{ loop.index }}" "{% if cmd_obj.metadata.is_multiline %}true{% else %}false{% endif %}" "{% if cmd_obj.metadata.is_critical %}true{% else %}false{% endif %}" || {
  {% if cmd_obj.metadata.is_critical %}
  exit $?
  {% else %}
  log "WARNING: Non-critical command failed but continuing execution"
  {% endif %}
}

{% elif cmd_obj.metadata.has_nested_quotes %}
# Handle commands with nested quotes through proper logging infrastructure
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
log "Executing command with nested quotes: {{ cmd_obj.command | replace('"', '\\"') }}"
# Use execute_with_error_tracking for proper output capture and logging
execute_with_error_tracking "{{ phase_name }}" "$MULTILINE_CMD" "{{ loop.index }}" "{% if cmd_obj.metadata.is_multiline %}true{% else %}false{% endif %}" "{% if cmd_obj.metadata.is_critical %}true{% else %}false{% endif %}" || {
  {% if cmd_obj.metadata.is_critical %}
  exit $?
  {% else %}
  log "WARNING: Non-critical command failed but continuing execution"
  {% endif %}
}

{% elif cmd_obj.metadata.is_function_call %}
# Handle simple function call (only pure function calls, not assignments)
log "Executing function call: {{ cmd_obj.command }}"
# Extract function name from command for validation
FUNC_NAME="{{ cmd_obj.command.split()[0] if cmd_obj.command.split() else cmd_obj.command }}"
# Check if function exists first to avoid errors
if declare -f "$FUNC_NAME" > /dev/null; then
  {{ cmd_obj.command }} || {
    {% if cmd_obj.metadata.is_critical %}
    exit $?
    {% else %}
    log "WARNING: Non-critical function call failed but continuing execution"
    {% endif %}
  }
else
  log "ERROR: Function $FUNC_NAME not defined"
  {% if cmd_obj.metadata.is_critical %}
  exit 1
  {% else %}
  log "WARNING: Non-critical function call failed but continuing execution"
  {% endif %}
fi

{% else %}
# Handle regular command
{% set safe_cmd = cmd_obj.shell_safe_command | default(cmd_obj.command | replace('"', '\\"')) %}
execute_with_error_tracking "{{ phase_name }}" "{{ safe_cmd }}" "{{ loop.index }}" "false" "{% if cmd_obj.metadata.is_critical %}true{% else %}false{% endif %}" || {
  {% if cmd_obj.metadata.is_critical %}
  exit $?
  {% else %}
  log "WARNING: Non-critical command failed but continuing execution"
  {% endif %}
}
{% endif %}

{% if cmd_obj.metadata.working_directory %}
# Restore previous working directory
cd "$SAVED_PWD" || {
  log "WARNING: Failed to restore previous directory: $SAVED_PWD"
}
log "Restored working directory to: $SAVED_PWD"
{% endif %}
{% endfor %}
{% endif %}
{% endmacro %}

# Define helper functions
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a /app/logs/{{additional_param.service_name}}_entrypoint.log
}
# Export log function so it's available in subshells
export -f log

log_function() {
  local fn_name="$1"
  local start_time=$(date +%s)
  local status_file="/app/logs/{{additional_param.service_name}}_function_${fn_name}_status.txt"
  local output_file="/app/logs/{{additional_param.service_name}}_function_${fn_name}_output.log"

  # Create header for the output file
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of function: ${fn_name}" > "$output_file"
  echo "----------------------------------------" >> "$output_file"

  # Execute the function and capture output
  shift
  if type "${fn_name}" 2>/dev/null | grep -q 'function'; then
    log "Executing function: ${fn_name}"
    { ${fn_name} "$@" >> "$output_file" 2>&1; }
    local status=$?
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))

    # Record completion time and status
    echo "----------------------------------------" >> "$output_file"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Function completed with exit code: $status (duration: ${duration}ms)" >> "$output_file"
    echo "$status" > "$status_file"

    # Log output to main log file
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from function ${fn_name}:" >> /app/logs/{{additional_param.service_name}}_commands.log
    cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log

    return $status
  else
    log "ERROR: Function ${fn_name} is not defined"
    echo "ERROR: Function ${fn_name} is not defined" >> "$output_file"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Function call failed - function not defined" >> "$output_file"
    echo "1" > "$status_file"
    return 1
  fi
}

check_connectivity() {
  local target="$1"
  local port="$2"
  log "Checking connectivity to $target:$port..."

  # Try ping first to check basic connectivity
  ping -c 3 "$target" > /app/logs/{{additional_param.service_name}}_connectivity.log 2>&1
  if [ $? -eq 0 ]; then
    log "Ping to $target successful"
    return 0
  else
    log "Ping to $target failed"
    return 1
  fi
}

resolve_hostname() {
  local hostname="$1"
  local format="${2:-ip}"  # Default to IP format, can be: ip, decimal, hex
  local ip=""

  # Try service discovery file first (most reliable for our services)
  if [ -f "/app/coordination/${hostname}_ip.txt" ]; then
    ip=$(cat "/app/coordination/${hostname}_ip.txt" 2>/dev/null | head -n1)
    log "Found IP from service discovery: $ip" >&2
  fi

  if [ -z "$ip" ]; then
    # Try getent (most reliable in Docker)
    ip=$(getent hosts "$hostname" 2>/dev/null | awk '{ print $1 }' | head -n1)
  fi

  if [ -z "$ip" ]; then
    # Fallback to nslookup
    ip=$(nslookup "$hostname" 2>/dev/null | grep -A1 'Name:' | grep 'Address:' | tail -n1 | awk '{print $2}')
  fi

  if [ -z "$ip" ]; then
    # Fallback to ping
    ip=$(ping -c 1 "$hostname" 2>/dev/null | grep PING | sed -n 's/.*(\([0-9.]*\)).*/\1/p')
  fi

  if [ -n "$ip" ]; then
    # Validate IP address format to prevent malformed conversions
    if ! echo "$ip" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' >/dev/null; then
      log "ERROR: Invalid IP address format: '$ip' for hostname '$hostname'" >&2
      echo "$hostname"  # Return hostname if IP is malformed
      return 1
    fi

    # Validate IP address ranges (0-255 for each octet)
    if ! echo "$ip" | awk -F. '{ exit ($1<=255 && $2<=255 && $3<=255 && $4<=255 && $1>=0 && $2>=0 && $3>=0 && $4>=0) ? 0 : 1 }'; then
      log "ERROR: IP address out of range: '$ip' for hostname '$hostname'" >&2
      echo "$hostname"  # Return hostname if IP is out of range
      return 1
    fi

    log "Resolved hostname '$hostname' to IP '$ip'" >&2

    # Convert based on requested format
    case "$format" in
      decimal)
        # Service-aware IP to decimal conversion
        # FIXED: Use proper endianness based on service type
        # Ivy services expect big-endian format (bytes reversed)
        # Non-Ivy services use standard network byte order

        # Check if this is an Ivy service by looking at environment or service name patterns
        # if [ "${ROLE:-}" = "SERVER" ] && [[ "${hostname}" =~ ivy.*server ]] || [[ "$0" =~ ivy.*entrypoint ]] || [ -n "${IVY_INCLUDE_PATH:-}" ]; then
          # BIG-ENDIAN conversion for Ivy services (bytes: d.c.b.a)
        #   log "Using big-endian decimal conversion for Ivy service: $hostname -> $ip" >&2
        #   echo "$ip" | awk -F. '{printf("%.0f", ($4 * 256 * 256 * 256) + ($3 * 256 * 256) + ($2 * 256) + $1)}'
        # else
          # STANDARD network byte order for non-Ivy services (bytes: a.b.c.d)
        log "Using standard decimal conversion for service: $hostname -> $ip" >&2
        echo "$ip" | awk -F. '{printf("%.0f", ($1 * 256 * 256 * 256) + ($2 * 256 * 256) + ($3 * 256) + $4)}'
        # fi
        ;;
      hex)
        # Convert IP to 0x-prefixed hex (matches Ivy ip.addr parameter format)
        echo "$ip" | awk -F. '{printf("0x%02X%02X%02X%02X", $1, $2, $3, $4)}'
        ;;
      *)
        # Default: return IP as-is
        echo "$ip"
        ;;
    esac
  else
    log "WARNING: Could not resolve hostname '$hostname'" >&2
    echo "$hostname"  # Return original hostname if resolution fails
  fi
}

# Export the function so it's available in subshells
export -f resolve_hostname

# Check current working directory
log "Current working directory: $(pwd)"

wait_for_dependency() {
  local target="$1"
  local port="${2:-4443}"
  local timeout="${3:-300}"  # Default 5 minutes timeout
  local interval="${4:-5}"   # Check every 5 seconds
  local start_time=$(date +%s)

  log "Waiting for dependency $target:$port to become ready (timeout: ${timeout}s)..."

  # First wait for basic connectivity

  if ! [[ "$target" == "tester" || "$target" == *"ivy"* ]]; then
    while true; do
      current_time=$(date +%s)
      elapsed=$((current_time - start_time))

      if [ $elapsed -gt $timeout ]; then
        log "ERROR: Timeout waiting for $target after ${timeout} seconds"
        return 1
      fi

      # Check if host is reachable
      if ping -c 1 -W 2 "$target" >/dev/null 2>&1; then
        log "Host $target is reachable, checking service port..."
        break
      fi

      log "Waiting for $target to become reachable... (${elapsed}s elapsed)"
      sleep $interval
    done
  fi

  # For tester services, check for ready marker files
  if [[ "$target" == *"ivy"* ]] || [[ "$target" == *"tester"* ]]; then
    log "Detected tester service, checking for ready marker..."
    local ready_marker="/app/coordination/*ivy*_ready"

    while true; do
      current_time=$(date +%s)
      elapsed=$((current_time - start_time))

      if [ $elapsed -gt $timeout ]; then
        log "ERROR: Timeout waiting for tester service $target to be ready after ${timeout} seconds"
        return 1
      fi

      # Check if the ready marker exists
      if ls $ready_marker 1>/dev/null 2>&1; then
        log "Tester service $target is ready (found ready marker)"
        return 0
      fi

      log "Waiting for tester service $target to complete initialization... (${elapsed}s elapsed)"
      sleep $interval
    done
  else
    # For regular services, check port availability
    while true; do
      current_time=$(date +%s)
      elapsed=$((current_time - start_time))

      if [ $elapsed -gt $timeout ]; then
        log "ERROR: Timeout waiting for $target:$port after ${timeout} seconds"
        return 1
      fi

      # Use nc (netcat) to check if port is open
      if nc -z -w 2 "$target" "$port" 2>/dev/null; then
        log "Service $target:$port is ready"
        return 0
      fi

      log "Waiting for $target:$port to become available... (${elapsed}s elapsed)"
      sleep $interval
    done
  fi
}

report_exit() {
  local exit_status=$1
  local phase=$2
  local cmd_num=$3
  local cmd_desc=$4

  log "Command $cmd_num in phase $phase exited with status $exit_status: $cmd_desc"
  if [ $exit_status -ne 0 ]; then
    log "ERROR: Command failed with exit status $exit_status"
    echo "$cmd_desc" > /app/logs/{{additional_param.service_name}}_last_failed_command.txt
    echo "Exit status: $exit_status" >> /app/logs/{{additional_param.service_name}}_last_failed_command.txt

    # Write to phase-specific stderr for better organization
    local phase_dir="/app/logs/$(echo "$phase" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
    local phase_stderr="$phase_dir/stderr.log"

    {
      echo ""
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] COMMAND FAILURE in $phase phase:"
      echo "Command: $cmd_desc"
      echo "Exit status: $exit_status"
      echo "----------------------------------------"
    } >> "$phase_stderr"
  fi
}

set_environment() {
  # Set environment variables for the service
  {% for key, value in additional_param.environments.items() %}
  export {{ key }}={{ value }}
  {% endfor %}
  : # No-op command to prevent empty function syntax error
}
