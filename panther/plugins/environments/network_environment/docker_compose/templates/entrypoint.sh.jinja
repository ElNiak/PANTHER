# the coordination file holds the primary panther_network address that
# downstream readers (FRR neighbor config, resolve_hostname) need.
if [ -n "${AUX_NETWORK_SUBNET:-}" ]; then
  AUX_PREFIX="${AUX_NETWORK_SUBNET%.*/*}."
  PRIMARY_IP=$(hostname -i | tr ' ' '\n' | grep -v '^127' | grep -vF "${AUX_PREFIX}" | head -n 1)
  [ -n "$PRIMARY_IP" ] && SERVICE_IP="$PRIMARY_IP"
fi
if [ -n "$SERVICE_IP" ]; then
  echo "$SERVICE_IP" > /app/coordination/${SERVICE_NAME}_ip.txt
  log "Registered service IP: $SERVICE_IP"
fi

