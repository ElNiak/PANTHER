# Function to track command failures with details
execute_with_error_tracking() {
  local phase="$1"
  local cmd="$2"
  local cmd_num="$3"
  local is_multiline="$4"
  local is_critical="$5"

  # Use phase-specific directory for output files
  local phase_dir="/app/logs/$(echo "$phase" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  local phase_stdout="$phase_dir/stdout.log"
  local phase_stderr="$phase_dir/stderr.log"

  # Keep individual command files in phase directory if needed for debugging
  local status_file="$phase_dir/cmd-$cmd_num-status.txt"
  local output_file="$phase_dir/cmd-$cmd_num-output.log"
  local cmd_env_file="$phase_dir/cmd-$cmd_num-env.env"

  # Save current environment to a file for reference
  env > "$cmd_env_file"

  # Append command header to phase stdout
  echo "" >> "$phase_stdout"
  echo "=== Command $cmd_num ===" >> "$phase_stdout"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of $cmd" >> "$phase_stdout"
  echo "Is Multiline: $is_multiline" >> "$phase_stdout"
  echo "Is Critical: $is_critical" >> "$phase_stdout"
  echo "----------------------------------------" >> "$phase_stdout"

  # Execute the command and capture output to phase files
  if [ "$is_multiline" = "true" ]; then
    # For multiline commands, use eval
    eval "$cmd" >> "$phase_stdout" 2>> "$phase_stderr"
  else
    # For single line commands, use bash -c
    bash -c "source $cmd_env_file; source  ~/.bashrc; $cmd" >> "$phase_stdout" 2>> "$phase_stderr"
  fi
  local status=$?

  # Record completion in phase stdout
  echo "----------------------------------------" >> "$phase_stdout"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command $cmd_num completed with exit code: $status" >> "$phase_stdout"
  echo "$status" > "$status_file"

  # If there was an error, also log to stderr
  if [ $status -ne 0 ]; then
    echo "" >> "$phase_stderr"
    echo "=== ERROR in Command $cmd_num ===" >> "$phase_stderr"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Failed with exit code: $status" >> "$phase_stderr"
    echo "----------------------------------------" >> "$phase_stderr"
  fi

  # Report exit status
  report_exit "$status" "$phase" "$cmd_num" "Command $cmd_num"

  # Return the command's exit status
  return $status
}

