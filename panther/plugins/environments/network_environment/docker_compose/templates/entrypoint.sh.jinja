# Clean stale coordination files from previous crashed runs
mkdir -p /app/coordination
CLEANUP_LOCK="/app/coordination/.cleanup_lock"
if ! ls /app/coordination/.cleanup_done 1>/dev/null 2>&1; then
  if (set -o noclobber; echo "$$" > "$CLEANUP_LOCK") 2>/dev/null; then
    log "Cleaning stale coordination files from previous run..."
    rm -f /app/coordination/*_ready /app/coordination/*_ip.txt /app/coordination/server_ready_*
    touch /app/coordination/.cleanup_done
    rm -f "$CLEANUP_LOCK"
    log "Stale coordination files cleaned"
  else
    log "Another service is cleaning coordination files, waiting..."
    while [ -f "$CLEANUP_LOCK" ] && [ ! -f /app/coordination/.cleanup_done ]; do sleep 0.5; done
  fi
fi

