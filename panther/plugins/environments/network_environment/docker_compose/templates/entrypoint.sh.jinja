# Check uname for architecture compatibility
uname -m >> "$RUNTIME_DIR/uname_output.log" 2>> "$RUNTIME_DIR/uname_error.log"
execute_with_error_tracking "PRE_RUN" "uname -m" "2" "false" "true" || {
  log "ERROR: uname command failed, exiting"
  exit 1
}

# Prepare command and execute it
# Handle both string and list command_args
{% set cmd_args = structured_commands.get("run_cmd").command_args %}
{% if cmd_args is string %}
FULL_CMD="{{ structured_commands.get("run_cmd").command_binary }} {{ cmd_args }}"
{% elif cmd_args is iterable and cmd_args is not string %}
FULL_CMD="{{ structured_commands.get("run_cmd").command_binary }} {{ cmd_args | join(' ') }}"
{% else %}
FULL_CMD="{{ structured_commands.get("run_cmd").command_binary }}"
{% endif %}
FULL_CMD="$(echo "$FULL_CMD" | xargs)"  # Trim whitespace

# Resolve hostnames to IPs for better compatibility
# This helps with applications that have DNS resolution issues in Docker
# Match any service pattern: *_server, *_client, *_tester, *_iut
while [[ "$FULL_CMD" =~ ([a-zA-Z][a-zA-Z0-9_-]*_(server|client|tester|iut)) ]]; do
  SERVICE_HOSTNAME="${BASH_REMATCH[0]}"
  SERVICE_IP=$(resolve_hostname "$SERVICE_HOSTNAME")
  if [ -n "$SERVICE_IP" ] && [ "$SERVICE_IP" != "$SERVICE_HOSTNAME" ]; then
    FULL_CMD="${FULL_CMD//$SERVICE_HOSTNAME/$SERVICE_IP}"
    log "Replaced hostname '$SERVICE_HOSTNAME' with IP '$SERVICE_IP' in command"
  else
    # If we can't resolve, break to avoid infinite loop
    log "WARNING: Could not resolve hostname '$SERVICE_HOSTNAME', keeping it in command"
    break
  fi
done

# Execute the command if available
if [[ -z "$FULL_CMD" ]]; then
  log "WARNING: No command to run, skipping execution"
  RUN_STATUS=-666
else
  # Check if execution environment wrappers are available from persistent file or environment
  WRAPPER_FILE="/app/logs/{{additional_param.service_name}}_exec_env_wrappers.txt"
  if [[ -f "$WRAPPER_FILE" ]]; then
    EXEC_ENV_WRAPPERS=$(cat "$WRAPPER_FILE" 2>/dev/null || echo "")
  fi

  {% if structured_commands.get("run_cmd").timeout %}
  log "Setting timeout for main command: {{ structured_commands.get("run_cmd").timeout }} seconds"
  FULL_CMD="timeout {{ structured_commands.get("run_cmd").timeout }} $FULL_CMD"
  {% endif %}

  if [[ -n "$EXEC_ENV_WRAPPERS" ]]; then
    # Validate wrapper binary exists before attempting to use it
    WRAPPER_BINARY=$(echo "$EXEC_ENV_WRAPPERS" | awk '{print $1}')
    if ! command -v "$WRAPPER_BINARY" >/dev/null 2>&1; then
      log "WARNING: Wrapper binary '$WRAPPER_BINARY' not found. Falling back to direct execution."
      EXEC_ENV_WRAPPERS=""
    fi
  fi

  if [[ -n "$EXEC_ENV_WRAPPERS" ]]; then
    # Execute the strace setup first, then the wrapped command
    # Split the wrapper into setup and trace parts
    log "Running command with execution environment wrappers"
    log "Wrapper: $EXEC_ENV_WRAPPERS"
    log "Main command: $FULL_CMD"
    echo "Execution environment wrappers applied: $EXEC_ENV_WRAPPERS" >> /app/logs/{{additional_param.service_name}}_exec_env_wrapping.log
    echo "Main command: $FULL_CMD" >> /app/logs/{{additional_param.service_name}}_exec_env_wrapping.log

    # Properly substitute "$@" in wrapper with the actual command
    # Use simple bash string replacement to avoid sed escaping issues
    WRAPPED_CMD="${EXEC_ENV_WRAPPERS}"
    WRAPPED_CMD="${WRAPPED_CMD//\"\$@\"/$FULL_CMD}"

    # Debug: log the substitution result
    log "Before substitution: $EXEC_ENV_WRAPPERS"
    log "After substitution: $WRAPPED_CMD"
    echo "Wrapped command after substitution: $WRAPPED_CMD" >> /app/logs/{{additional_param.service_name}}_exec_env_wrapping.log
  else
    WRAPPED_CMD="$FULL_CMD"
    log "Running command: $WRAPPED_CMD"
  fi

  # Use runtime phase directory for main command output
  # Use service-specific output redirections if available
  {% if output_redirections and output_redirections.stdout and output_redirections.stderr %}
  STDOUT_FILE="{{ output_redirections.stdout }}"
  STDERR_FILE="{{ output_redirections.stderr }}"
  {% else %}
  STDOUT_FILE="$RUNTIME_DIR/stdout.log"
  STDERR_FILE="$RUNTIME_DIR/stderr.log"
  {% endif %}

  # Initialize runtime log files
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Starting RUNTIME phase ===" > "$STDOUT_FILE"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] === Starting RUNTIME phase ===" > "$STDERR_FILE"
  echo "Command: $WRAPPED_CMD" >> "$STDOUT_FILE"
  echo "----------------------------------------" >> "$STDOUT_FILE"

  log "Output will be redirected to: stdout=$STDOUT_FILE, stderr=$STDERR_FILE"

  if [[ "${ROLE:-}" == "server" ]]; then
    # Wait until wrapped command's port is open instead of touching file immediately
    READY_FILE="/app/coordination/server_ready_{{additional_param.service_name}}"
  fi

  # Replace shell with target to get correct PID & signal handling
  setsid bash -c "$WRAPPED_CMD" >> "$STDOUT_FILE" 2>> "$STDERR_FILE" &
  CMD_PID=$!

  if [[ "${ROLE:-}" == "server" ]]; then
    # Wait for server to actually start listening before signaling ready
    READY_WAIT=0
    while [ $READY_WAIT -lt 120 ]; do
      if nc -z localhost ${PORT:-4443} 2>/dev/null; then
        log "Server port ${PORT:-4443} is open"
        break
      fi
      sleep 0.5
      READY_WAIT=$((READY_WAIT + 1))
    done
    if [ $READY_WAIT -ge 120 ]; then
      log "WARNING: Server port readiness check timed out after 60s, signaling ready anyway"
    fi
    printf 'server_ready' >"$READY_FILE"
    log "Server ready signal written to $READY_FILE"
  fi
  wait "$CMD_PID"
  RUN_STATUS=$?
fi
{% else %}
# If no run command is defined, set RUN_STATUS to -666
RUN_STATUS=-666
log "No run command defined, skipping execution"
{% endif %}
# Check command exit status
if [[ $RUN_STATUS -ne 0 ]]; then
  if [[ $RUN_STATUS -eq 124 || $RUN_STATUS -eq 137 ]]; then
    log "WARNING: Command timed out after {{ (structured_commands.get("run_cmd").timeout if structured_commands and structured_commands.get("run_cmd") and structured_commands.get("run_cmd").timeout else "unknown") }} seconds"
  elif [[ $RUN_STATUS -eq 139 ]]; then
    log "ERROR: Command terminated by signal (segmentation fault)"
  elif [[ $RUN_STATUS -eq 1 ]]; then
    log "ERROR: Command failed with exit status 1"
  elif [[ $RUN_STATUS -eq 126 ]]; then
    log "ERROR: Command invoked cannot execute"
  elif [[ $RUN_STATUS -eq 127 ]]; then
    log "ERROR: Command not found"
  elif [[ $RUN_STATUS -eq 130 ]]; then
    log "ERROR: Command terminated by Ctrl+C (SIGINT)"
  elif [[ $RUN_STATUS -eq 255 ]]; then
    log "ERROR: Command failed with exit status 255 (general error)"
  elif [[ $RUN_STATUS -eq 666 ]]; then
    log "ERROR: Command failed with exit status 666 (no \"run_cmd\" command defined)"
  elif [[ $RUN_STATUS -eq 143 ]]; then
    log "ERROR: Command terminated by SIGTERM"
  else
    log "ERROR: Command failed with unknown exit status $RUN_STATUS"
  fi
fi

# Execute post-run commands
log "Executing post-run commands..."
{{ execute_command_phase(structured_commands.get("post_run_cmds") if structured_commands else [], "POST_RUN") }}

if [[ $RUN_STATUS -eq 0 || $RUN_STATUS -eq -666 ]]; then
  log "All commands executed successfully. Service '{{additional_param.service_name}}' entrypoint complete."
else
  log "Service '{{additional_param.service_name}}' entrypoint complete with errors (exit code: $RUN_STATUS)."
fi
exit $RUN_STATUS
