#!/bin/bash -x
# -x: trace every command (with expansions)

# Define helper functions
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a /app/logs/{{additional_param.service_name}}_commands.log
}

check_connectivity() {
  # Function implementation here
  local target="$1"
  log "Checking connectivity to $target..."
}

report_exit() {
  local exit_status=$1
  local phase=$2
  local cmd_num=$3
  local cmd_desc=$4
  
  log "Command $cmd_num in phase $phase exited with status $exit_status: $cmd_desc"
  if [ $exit_status -ne 0 ]; then
    log "ERROR: Command failed with exit status $exit_status"
    echo "$cmd_desc" > /app/logs/{{additional_param.service_name}}_last_failed_command.txt
    echo "Exit status: $exit_status" >> /app/logs/{{additional_param.service_name}}_last_failed_command.txt
  fi
}

set_environment() {
  # Set environment variables for the service
  {% if additional_param and additional_param.env %}
  {% for key, value in additional_param.env.items() %}
  export {{ key }}="{{ value }}"
  {% endfor %}
  {% endif %}
  
  # Set default values for common variables if not already set
  : ${LOG_LEVEL:=INFO}
  : ${TIMEOUT:=30}
  
  # Export all variables
  export LOG_LEVEL TIMEOUT
}

# Initialize environment variables
log "Setting up environment variables..."
set_environment

# Fix double slashes in paths and environment variables
log "Normalizing paths and environment variables..."
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR'); do
  if [ -n "${!var}" ]; then
    # Replace double slashes with single slash
    eval "$var=${!var//\/\//\/}"
  fi
done

# Fix environment variables that contain $$ (escaping in templates)
for var in $(env | grep -o '^[^=]*' | grep -i 'PATH\|DIR\|IVY'); do
  if [ -n "${!var}" ]; then
    # Replace $$ with $
    eval "$var=${!var//\$\$/\$}"
  fi
done

# Function to track command failures with details
execute_with_error_tracking() {
  local phase="$1"
  local cmd="$2"
  local cmd_num="$3"
  local cmd_desc="$4"
  local is_multiline="$5"
  local is_critical="$6"
  local status_file="/app/logs/{{additional_param.service_name}}_${phase}_cmd${cmd_num}_status.txt"
  local output_file="/app/logs/{{additional_param.service_name}}_${phase}_cmd${cmd_num}_output.log"
  
  # Create header for the output file
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of $phase command #$cmd_num" > "$output_file"
  echo "Command: $cmd_desc" >> "$output_file"
  echo "----------------------------------------" >> "$output_file"
  
  # Execute the command and capture output and status
  if [ "$is_multiline" = "true" ]; then
    # For multiline commands, use eval
    eval "$cmd" >> "$output_file" 2>&1
  else
    # For single line commands, use bash -c
    bash -c "$cmd" >> "$output_file" 2>&1
  fi
  local status=$?
  
  # Record completion time and status
  echo "----------------------------------------" >> "$output_file"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Command completed with exit code: $status" >> "$output_file"
  echo "$status" > "$status_file"
  
  # Log the output to main log file
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from $phase command #$cmd_num:" >> /app/logs/{{additional_param.service_name}}_commands.log
  cat "$output_file" >> /app/logs/{{additional_param.service_name}}_commands.log
  
  # Report exit status
  report_exit "$status" "$phase" "$cmd_num" "$cmd_desc"
  
  # Return the command's exit status
  return $status
}

# Execute pre-compilation setup commands
log "Executing pre-compilation commands..."
{% if structured_commands.get("pre_compile_cmds") %}
{% for cmd_obj in structured_commands.get("pre_compile_cmds") %}
# Set command type for this context
cmd_type="PRE_COMPILE"

{% if cmd_obj.is_empty %}
log "Skipping empty pre-compile command #{{ loop.index }}"

{% elif not cmd_obj.is_critical %}
# Handle non-critical command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)

# This command is marked as non-critical, execute it but don't fail if it returns error
log "Executing non-critical {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "{% if cmd_obj.is_multiline %}true{% else %}false{% endif %}" "false" || {
  log "WARNING: Non-critical command failed but continuing execution"
}

{% elif cmd_obj.is_function_definition %}
# Handle function definition
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# This is a function definition, execute it directly without tracking
log "Executing function definition: {{ cmd_obj.description }}"
# Just evaluate the function definition
eval "$MULTILINE_CMD"

{% elif cmd_obj.is_multiline %}
# Handle multi-line command
MULTILINE_CMD=$(cat <<'ENDOFCOMMAND'
{{ cmd_obj.command }}
ENDOFCOMMAND
)
# Execute multi-line command with error tracking
log "Executing multi-line {{ cmd_type }} command #{{ loop.index }}"
execute_with_error_tracking "{{ cmd_type }}" "$MULTILINE_CMD" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "true" "true" || {
  exit $?
}

{% elif cmd_obj.has_control_operators and '&&' in cmd_obj.control_operators %}
# Handle command with && operator
log "Command contains && operator: {{ cmd_obj.command | replace('"', '\\"') }}"

# Extract parts of the command before and after &&
FIRST_PART="{{ cmd_obj.command.split('&&')[0] }}"
REST_OF_CMD="{{ '&&'.join(cmd_obj.command.split('&&')[1:]) }}"

# Create output files for this command
FIRST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_first_part.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of {{ cmd_type }} command #{{ loop.index }} first part" > "$FIRST_OUTPUT"
echo "Command: ${FIRST_PART}" >> "$FIRST_OUTPUT"
echo "----------------------------------------" >> "$FIRST_OUTPUT"

# First execute the part before && and capture output
log "Executing first part: ${FIRST_PART}"
# Use bash -c to execute the command instead of eval to handle quotes better
bash -c "${FIRST_PART}" >> "$FIRST_OUTPUT" 2>&1
FIRST_STATUS=$?

# Record completion time for first part
echo "----------------------------------------" >> "$FIRST_OUTPUT"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] First part completed with exit code: $FIRST_STATUS" >> "$FIRST_OUTPUT"

# Log the captured output
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} first part:" >> /app/logs/{{additional_param.service_name}}_commands.log
cat "$FIRST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log

if [ $FIRST_STATUS -eq 0 ]; then
  # If first part succeeded, execute rest of command
  log "First part succeeded. Executing rest: ${REST_OF_CMD}"
  REST_OUTPUT="/app/logs/{{additional_param.service_name}}_{{ cmd_type }}_cmd{{ loop.index }}_rest.log"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting execution of {{ cmd_type }} command #{{ loop.index }} rest part" > "$REST_OUTPUT"
  echo "Command: ${REST_OF_CMD}" >> "$REST_OUTPUT"
  echo "----------------------------------------" >> "$REST_OUTPUT"
  
  # Execute rest of command
  bash -c "${REST_OF_CMD}" >> "$REST_OUTPUT" 2>&1
  REST_STATUS=$?
  
  # Record completion time for rest part
  echo "----------------------------------------" >> "$REST_OUTPUT"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Rest part completed with exit code: $REST_STATUS" >> "$REST_OUTPUT"
  
  # Log the captured output
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Output from {{ cmd_type }} command #{{ loop.index }} rest part:" >> /app/logs/{{additional_param.service_name}}_commands.log
  cat "$REST_OUTPUT" >> /app/logs/{{additional_param.service_name}}_commands.log
  
  # Exit with status from rest part
  if [ $REST_STATUS -ne 0 ]; then
    exit $REST_STATUS
  fi
else
  exit $FIRST_STATUS
fi

{% elif cmd_obj.is_function_call %}
# Handle simple function call
log "Executing function call: {{ cmd_obj.command }}"
# Check if function exists first to avoid errors
if declare -f {{ cmd_obj.command }} > /dev/null; then
  {{ cmd_obj.command }} || {
    exit $?
  }
else
  log "ERROR: Function {{ cmd_obj.command }} not defined"
  exit 1
fi

{% elif cmd_obj.is_variable_assignment or cmd_obj.is_shell_builtin or cmd_obj.is_control_structure or cmd_obj.has_nested_quotes %}
# Handle special command types: variable assignment, shell builtin, control structure, or nested quotes
log "Executing {{ cmd_obj.is_variable_assignment and 'variable assignment' or cmd_obj.is_shell_builtin and 'shell builtin' or cmd_obj.is_control_structure and 'control structure' or 'command with nested quotes' }}: {{ cmd_obj.command | replace('"', '\\"') }}"
# Use eval to properly execute these special command types while preserving their syntax
eval "{{ cmd_obj.command }}" || {
  exit $?
}

{% else %}
# Handle regular command
execute_with_error_tracking "{{ cmd_type }}" "{{ cmd_obj.command }}" "{{ loop.index }}" "{{ cmd_obj.command | replace('"', '\\"') }}" "false" "true" || {
  exit $?
}
{% endif %}
{% endfor %}
{% endif %}

