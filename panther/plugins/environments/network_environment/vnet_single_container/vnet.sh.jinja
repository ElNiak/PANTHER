#!/bin/bash
# /setup_vnet.sh.jinja
# Script to set up and run the experiment in a virtual network environment

set -e

# Experiment setup
EXPERIMENT_NAME="{{ experiment_name }}"
LOG_DIR="{{ log_dir | realpath }}"
mkdir -p "$LOG_DIR"

# Define namespaces and interfaces
echo "Setting up network namespaces and virtual interfaces..."

{% for command in setup %}
echo "+ {{ command }}"
{{ command }}
{% endfor %}

echo "Network namespaces and virtual interfaces are set up."

# Verify connectivity
echo "Verifying connectivity..."
{% for verification_command in verify %}
echo "+ {{ verification_command }}"
{{ verification_command }}
{% endfor %}

echo "Connectivity verified."

# Set up services
echo "Starting services..."
{% for service_name, service in services.items() %}
echo "Setting up service: {{ service_name | replace('-', '.') | replace('_', '.') }}"

# Define environment variables
export ROLE="{{ service.role }}"
export SSLKEYLOGFILE="$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}/sslkeylogfile.txt"
mkdir -p "$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}"

# Execute service command in its network namespace
echo "Starting {{ service_name | replace('-', '.') | replace('_', '.') }} in network namespace..."
ip netns exec {{ service.network_namespace }} bash -c '
    cd "{{ deployment_info[service_name]['working_dir'] }}"
    {% if not "ivy" in service_name %}
    {{ additional_command }}
    (tshark -a duration:10 -i any -w "$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}/{{ service_name | replace('-', '.') | replace('_', '.') }}.pcap") &
    {% if service.role == "client" %}
    sleep 5
    {% endif %}
    {{ deployment_info[service_name]['command'] }}
    {% else %}
    {{ deployment_info[service_name]['compilation_command'] }} && \
    (touch "$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}/{{ service_name | replace('-', '.') | replace('_', '.') }}.pcap"; \
    tshark -a duration:10 -i any -w "$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}/{{ service_name | replace('-', '.') | replace('_', '.') }}.pcap") &
    {% if service.role == "client" %}
    sleep 5
    {% endif %}
    {{ deployment_info[service_name]['command'] }}
    {% endif %}
' > "$LOG_DIR/{{ service_name | replace('-', '.') | replace('_', '.') }}/service.log" 2>&1 &

echo "Service {{ service_name | replace('-', '.') | replace('_', '.') }} started."
{% endfor %}

# Wait for services
echo "Waiting for all services to complete..."
wait

echo "All services have completed execution."

# Clean up
echo "Cleaning up network namespaces..."
{% for cleanup_command in reset %}
echo "+ {{ cleanup_command }}"
{{ cleanup_command }}
{% endfor %}

echo "Experiment completed and cleaned up."
