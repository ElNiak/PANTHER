general:
  # stop after  {{ environment_settings.stop_time | default(60) }} simulated seconds
  stop_time: {{ environment_settings.stop_time | default(60) }}s
  # old versions of cURL use a busy loop, so to avoid spinning in this busy
  # loop indefinitely, we add a system call latency to advance the simulated
  # time when running non-blocking system calls
  model_unblocked_syscall_latency: {%if environment_settings.model_unblocked_syscall_latency %}true{% else %}false{% endif %}


experimental:
  strace_logging_mode: "{{ environment_settings.strace_logging_mode }}"

# TODO improve network configuration -> make more modular
network:
  graph:
    # use a built-in network graph containing
    # a single vertex with a bandwidth of 1 Gbit
    # type: 1_gbit_switch
    type: gml
    # file:
    # path: /app/topo.gml
    inline: |
      graph [
        directed 0
        node [
          id 0
          host_bandwidth_down "100 Gbit"
          host_bandwidth_up "100 Gbit"
        ]
        edge [
          source 0
          target 0
          latency "{{ environment_settings.latency }} ms"
          jitter "{{ environment_settings.jitter }} ms"
          packet_loss {{ environment_settings.packet_loss}}
        ]
      ]

host_option_defaults:
  pcap_enabled: {%if environment_settings.pcap_enabled %}true{% else %}false{% endif %}


# TODO improve process configuration -> make more modular (need better config format for experiment paramters and allowed values)
hosts:
  {% for service_name, service in services.items() %}
  {{ service_name | replace('-', '.') | replace('_', '.') }}:
    {% if service.role == "client" %}
    network_node_id: 0
    ip_addr: "11.0.0.2"
    {% else %}
    network_node_id: 0
    ip_addr: "11.0.0.1"
    {% endif %}
    processes:
    - path: {{ deployment_info[service_name]['working_dir'] }}/{{ deployment_info[service_name]['command_binary'] }}
      args: {{ deployment_info[service_name]['args'].split('>')[0] }}
      {% if service.role == 'client' %}
      start_time: 5s
      {% else %}
      start_time: 1s
      {% endif %}
      {% if "environment" in deployment_info[service_name] and (deployment_info[service_name]["environment"] |length ) > 0 %}
      environment:
        {% for key, value in deployment_info[service_name]["environment"].items() %}
        {{ key }}: "{{ value }}"
        {% endfor %}
      {% endif %}

  {% endfor %}
