FROM panther_shadow_ns:latest


FROM picoquic_shadow_rfc9000_panther:latest as picoquic_server_image

EXPOSE 4443:4443
EXPOSE 8080:8080
# Set container working directory
WORKDIR "/opt/picoquic"

# Add service-specific environment variables
ENV ROLE="server"
ENV UID=${UID}
ENV GID=${GID}

# Copy logs and volumes
VOLUME /app/logs
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/certs/cert.pem:/opt/certs/cert.pem"
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/certs/key.pem:/opt/certs/key.pem"
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/tls_keys:/opt/ticket/ticket.key"

# Set capabilities
RUN apt-get update && apt-get install -y sudo
RUN sudo setcap cap_net_admin,cap_net_raw+ep /bin/sh

# Define the command for the service


FROM picoquic_shadow_rfc9000_panther:latest as picoquic_client_image

EXPOSE 5000:5000
EXPOSE 8081:8081
# Set container working directory
WORKDIR "/opt/picoquic"

# Add service-specific environment variables
ENV ROLE="client"
ENV UID=${UID}
ENV GID=${GID}

# Copy logs and volumes
VOLUME /app/logs
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/certs/cert.pem:/opt/certs/cert.pem"
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/certs/key.pem:/opt/certs/key.pem"
VOLUME "/home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/config/tls_keys:/opt/ticket/ticket.key"

# Set capabilities
RUN apt-get update && apt-get install -y sudo
RUN sudo setcap cap_net_admin,cap_net_raw+ep /bin/sh

# Define the command for the service


WORKDIR /

ADD /home/crochetch/Documents/Projects/VerificationQUIC/PANTHER-SCP/panther/plugins/environments/network_environment/shadow_ns/shadow.generated.yml shadow_ns_config.yml
ENV RUST_BACKTRACE=1
ENTRYPOINT [ "shadow", "shadow_ns_config.yml" , ">> /app/logs/shadow_ns.log" ]
