# syntax=docker/dockerfile:1
FROM  ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Layer 1: System base configuration (rarely changes)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    apt-get update

# Layer 2: Core build dependencies (changes infrequently)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get install --fix-missing --auto-remove --show-upgraded --no-install-recommends -y \
    build-essential cmake software-properties-common \
    openssl libssl-dev pkg-config \
    git wget curl sudo \
    clang python3

# Layer 3: Network and debugging tools (changes infrequently)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get install --fix-missing --auto-remove --show-upgraded --no-install-recommends -y \
    net-tools tcpdump iperf traceroute \
    wireshark tshark libcap2-bin \
    iputils-ping iproute2 iperf3 netcat-openbsd \
    dnsutils radare2 strace

# Layer 4: Performance profiling dependencies (rarely changes)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get install --no-install-recommends -y \
    libunwind-dev google-perftools graphviz gv gperf

# Layer 5: System configuration (changes rarely)
RUN yes yes | DEBIAN_FRONTEND=teletype dpkg-reconfigure wireshark-common

WORKDIR /
