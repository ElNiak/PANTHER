# syntax=docker/dockerfile:1

# =============================================================================
# PING_PONG Implementation - Modern Multi-Platform BuildKit Dockerfile
# Cross-platform build with automatic platform detection and security hardening
# =============================================================================

# BuildKit automatic platform arguments
ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG BUILDVARIANT

# Runtime configuration
ARG RUNTIME_MODE=minimal
ARG BASE_IMAGE_DIGEST=sha256:965fbcae990b0467ed5657caceaec165018ef44a4d2d46c7cdea80a9dff0d1ea

# Define build arguments for version-specific configurations
ARG VERSION=random
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value
ARG BASE_IMAGE=panther_base_service:latest

# =============================================================================
# STAGE 1: BUILD - Cross-platform build environment for PING_PONG
# =============================================================================

FROM --platform=$TARGETPLATFORM ${BASE_IMAGE} AS base

# Re-declare ARGs after FROM to make them available in this stage
ARG VERSION
ARG DEPENDENCIES
ARG TARGETARCH
ARG BUILDPLATFORM
ARG TARGETPLATFORM

ENV DEBIAN_FRONTEND=noninteractive
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Layer 1: Install cross-compilation tools based on target architecture
RUN --mount=type=cache,target=/var/cache/apt,id=crossbuild-$BUILDPLATFORM,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,id=crossbuild-$TARGETPLATFORM,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    case "$TARGETARCH" in \
        arm64) \
            apt-get update && \
            apt-get install --no-install-recommends -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && \
            rm -rf /var/lib/apt/lists/* ;; \
        arm) \
            apt-get update && \
            apt-get install --no-install-recommends -y gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf && \
            rm -rf /var/lib/apt/lists/* ;; \
        amd64) \
            echo "Native compilation for amd64" ;; \
        *) \
            echo "Unsupported target architecture: $TARGETARCH" && exit 1 ;; \
    esac

# Set cross-compilation environment variables with CMAKE support
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    CC_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CXX_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-g++ \
    CMAKE_C_COMPILER_aarch64=aarch64-linux-gnu-gcc \
    CMAKE_CXX_COMPILER_aarch64=aarch64-linux-gnu-g++

# =============================================================================
# FINAL STAGE: Runtime configuration with platform metadata
# =============================================================================

# Target platform runtime stage
FROM --platform=$TARGETPLATFORM base AS runtime

# Layer: Runtime configuration
EXPOSE 4443 8080

RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Platform and build metadata for debugging and compliance
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE
ARG TARGETOS
ARG TARGETARCH

LABEL platform.build="${BUILDPLATFORM}"
LABEL platform.target="${TARGETPLATFORM}"
LABEL platform.os="${TARGETOS}"
LABEL platform.arch="${TARGETARCH}"
LABEL runtime.mode="${RUNTIME_MODE}"
LABEL implementation="ping_pong"
LABEL version="random"
LABEL runtime.description="PING_PONG implementation execution environment"
LABEL build.syntax="docker/dockerfile:1"

# Health check for runtime validation
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -d /opt || exit 1

# Set entrypoint (can be overridden)
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
