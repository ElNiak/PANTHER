# syntax=docker/dockerfile:1
ARG TARGETPLATFORM=linux/amd64
ARG RUNTIME_MODE=minimal
ARG BASE_IMAGE=panther_base_service:latest
FROM ${BASE_IMAGE} AS base

ENV DEBIAN_FRONTEND=noninteractive

# Define build arguments for version-specific configurations
ARG VERSION=master
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Install jq with cache mount for apt packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install --fix-missing -y jq

# Switch to specified user (now properly defined)
USER ${USER_N}

# Multi-stage build: Extract quant binaries
FROM ntap/quant:latest as quant

# Copy binaries from quant image
COPY --from=quant /bin/server /opt/quant/bin/server
COPY --from=quant /bin/client /opt/quant/bin/client

# Expose necessary ports
EXPOSE 4443 8080

# Create required directories
RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Final stage: Runtime selection with proper labels
FROM base AS minimal
LABEL org.panther.service.type="quic"
LABEL org.panther.service.name="quant"
LABEL org.panther.service.runtime="minimal"
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

FROM base AS full
LABEL org.panther.service.type="quic"
LABEL org.panther.service.name="quant"
LABEL org.panther.service.runtime="full"
RUN apt-get update && apt-get install -y \
    strace tcpdump net-tools procps htop curl wget \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

# Default to runtime mode specified by build arg
FROM ${RUNTIME_MODE} AS final
