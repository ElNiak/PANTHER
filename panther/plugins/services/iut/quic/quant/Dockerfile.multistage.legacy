# syntax=docker/dockerfile:1
ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64


# Multi-stage build for quant plugin isolation and optimization
# Uses 3-stage base service architecture: minimal/debug/profile runtime modes
# Build stage: Uses official ntap/quant image to extract binaries
# Runtime stage: Selected runtime environment (minimal/debug/profile)

# Runtime mode selection for execution environment
ARG RUNTIME_MODE=minimal

# ============================================================================
# BUILD STAGE: Extract binaries from official quant image
# ============================================================================

FROM ntap/quant:latest AS quant_source

# Extract quant binaries
RUN mkdir -p /tmp/quant/bin
RUN cp /bin/server /tmp/quant/bin/server 2>/dev/null || echo "Server binary not found"
RUN cp /bin/client /tmp/quant/bin/client 2>/dev/null || echo "Client binary not found"

# ============================================================================
# RUNTIME STAGE: Selected runtime environment (minimal/debug/profile)
# ============================================================================

# Use base service with runtime mode selection
# Base service provides: minimal (core+network) / debug (+gdb,valgrind,strace) / profile (+perf,gperftools,radare2)
ARG RUNTIME_MODE
FROM --platform=linux/amd64 panther_base_service:latest

# Runtime arguments (inherited ARG RUNTIME_MODE from global scope)
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# System configuration
ENV DEBIAN_FRONTEND=noninteractive

# Runtime dependencies only (no build tools)
RUN --mount=type=cache,target=/var/cache/apt,id=aptcache-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=aptlib-${TARGETPLATFORM//\//-},sharing=locked \
    apt-get update && apt-get install -y \
        jq \
        libssl1.1 \
        && rm -rf /var/lib/apt/lists/*

# Copy extracted binaries from quant source
COPY --from=quant_source /tmp/quant/bin/server /opt/quant/bin/server
COPY --from=quant_source /tmp/quant/bin/client /opt/quant/bin/client

# Ensure binaries are executable
RUN chmod +x /opt/quant/bin/server /opt/quant/bin/client

# Runtime environment setup
USER ${USER_N}

# Default runtime configuration
EXPOSE 4443
EXPOSE 8080

# Ensure required directories exist
RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Runtime mode labels for identification
ARG RUNTIME_MODE
LABEL panther.runtime.mode="${RUNTIME_MODE}"
LABEL panther.service.name="quant"
LABEL panther.service.type="quic_iut"
LABEL panther.runtime.capabilities.minimal="quant,wireshark,tshark,tcpdump,iperf3"
LABEL panther.runtime.capabilities.debug="minimal+gdb,valgrind,strace"
LABEL panther.runtime.capabilities.profile="debug+perf,gperftools,radare2"

# Set entrypoint
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

# =============================================================================
# Usage Examples:
#
# Minimal runtime (default - core + network analysis):
# docker build --build-arg RUNTIME_MODE=minimal -t quant:minimal .
#
# Debug runtime (minimal + debugging tools):
# docker build --build-arg RUNTIME_MODE=debug -t quant:debug .
#
# Profile runtime (debug + performance profiling tools):
# docker build --build-arg RUNTIME_MODE=profile -t quant:profile .
# =============================================================================
