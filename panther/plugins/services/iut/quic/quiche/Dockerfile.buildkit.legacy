# syntax=docker/dockerfile:1
ARG BUILDPLATFORM=linux/amd64

ARG TARGETPLATFORM=linux/amd64
FROM panther_base_service:latest AS base
ARG RUNTIME_MODE=minimal
ENV DEBIAN_FRONTEND=noninteractive

# Define build arguments for version-specific configurations
ARG VERSION=master
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Layer 1: Install Rust and dependencies with cache mount
RUN --mount=type=cache,target=/var/cache/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/var/lib/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    apt-get update && \
    apt-get install --fix-missing -y curl build-essential # Platform-specific CMake configuration
 case "${TARGETPLATFORM}" in \
     "linux/amd64") \
         CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64 -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++" \
         ;; \
     "linux/arm64") \
         CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=aarch64" \
         ;; \
     *) \
         CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64" \
         ;; \
 esac && \
 cmake $CMAKE_ARGS jq && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

ENV PATH="/root/.cargo/bin:${PATH}"

# Switch to specified user (now properly defined)
USER ${USER_N}

# Layer 2: Cargo cache for Rust dependencies
RUN --mount=type=cache,target=/usr/local/cargo/registry-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/tmp/quiche-cache-${TARGETPLATFORM//\//-},sharing=locked \
    cd /opt && \
    if [ -d "/tmp/quiche-cache/.git" ]; then \
        echo "Using cached Quiche repository"; \
        cp -r /tmp/quiche-cache quiche; \
        cd quiche && git fetch && git checkout ${VERSION}; \
    else \
        echo "Cloning fresh Quiche repository"; \
        git clone --recursive https://github.com/cloudflare/quiche.git; \
        cd quiche && git checkout ${VERSION}; \
        # Cache the repository \
        cp -r /opt/quiche /tmp/quiche-cache; \
    fi && \
    cargo build --release --examples

# Layer 3: Runtime configuration (rarely changes)
EXPOSE 4443 8080

RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Set entrypoint (can be overridden)
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
