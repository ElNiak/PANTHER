# syntax=docker/dockerfile:1
ARG TARGETPLATFORM=linux/amd64
ARG BUILDPLATFORM=linux/amd64


# Multi-stage build for quiche plugin isolation and optimization
# Build stage: Contains all build tools, Rust toolchain, and dependencies
# Runtime stage: Minimal environment with only runtime binaries

# ============================================================================
# BUILD STAGE: Complete build environment with Rust toolchain and dependencies
# ============================================================================

FROM --platform=linux/amd64 panther_base_service:latest AS builder

# Build arguments and environment
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# System configuration for build environment
ENV DEBIAN_FRONTEND=noninteractive

# Build dependencies with cache optimization
RUN --mount=type=cache,target=/var/cache/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/var/lib/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    apt-get update && apt-get install -y \
        build-essential \
        # Platform-specific CMake configuration

        case "${TARGETPLATFORM}" in \

            "linux/amd64") \

                CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64 -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++" \

                ;; \

            "linux/arm64") \

                CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=aarch64" \

                ;; \

            *) \

                CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64" \

                ;; \

        esac && \

        cmake $CMAKE_ARGS \
        git \
        wget \
        curl \
        pkg-config \
        libssl-dev \
        jq \
        && rm -rf /var/lib/apt/lists/*

# Install CMake 3.12.4 for quiche requirements
RUN wget https://github.com/Kitware/CMake/releases/download/v3.12.4/cmake-3.12.4-Linux-x86_64.sh && \
    chmod +x cmake-3.12.4-Linux-x86_64.sh && \
    mkdir /opt/cmake && \
    bash cmake-3.12.4-Linux-x86_64.sh --skip-license --prefix=/opt/cmake && \
    ln -s /opt/cmake/bin/cmake /usr/local/bin/cmake && \
    # Platform-specific CMake configuration

    case "${TARGETPLATFORM}" in \

        "linux/amd64") \

            CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64 -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++" \

            ;; \

        "linux/arm64") \

            CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=aarch64" \

            ;; \

        *) \

            CMAKE_ARGS="-DCMAKE_SYSTEM_PROCESSOR=x86_64" \

            ;; \

    esac && \

    cmake $CMAKE_ARGS --version

# Install Rust toolchain with cache optimization
RUN --mount=type=cache,target=/tmp/rustup-cache-${TARGETPLATFORM//\//-},sharing=locked \
    curl https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# User setup for build environment
USER ${USER_N}
WORKDIR /opt

# Clone and build quiche with build cache optimization
RUN --mount=type=cache,target=/tmp/git-cache-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/tmp/cargo-cache-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/root/.cargo/git-${TARGETPLATFORM//\//-},sharing=locked \
    git clone https://github.com/cloudflare/quiche

WORKDIR /opt/quiche
RUN --mount=type=cache,target=/tmp/git-cache-${TARGETPLATFORM//\//-},sharing=locked \
    git checkout 4bda0917dd5aa535f39214063ee85c2cad00ceb2 && \
    git submodule update --init

# Add customized files
COPY file_to_change/packet_0.9.0.rs /opt/quiche/src/packet.rs

# Build quiche with Rust cache optimization
RUN --mount=type=cache,target=/tmp/cargo-cache-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/root/.cargo/git-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/opt/quiche/target-${TARGETPLATFORM//\//-},sharing=locked \
    cargo build --examples && \
    cargo test || true

# ============================================================================
# RUNTIME STAGE: Selected runtime environment (minimal/debug/profile)
# ============================================================================

# Use base service with runtime mode selection
# Base service provides: minimal (core+network) / debug (+gdb,valgrind,strace) / profile (+perf,gperftools,radare2)
ARG RUNTIME_MODE
FROM --platform=linux/amd64 panther_base_service:latest

# Runtime arguments (inherited ARG RUNTIME_MODE from global scope)
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Runtime dependencies only (no build tools or Rust)
RUN --mount=type=cache,target=/var/cache/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    --mount=type=cache,target=/var/lib/apt-${TARGETPLATFORM//\//-},sharing=locked-${TARGETPLATFORM//\//-},sharing=locked \
    apt-get update && apt-get install -y \
        jq \
        libssl1.1 \
        && rm -rf /var/lib/apt/lists/*

# Copy compiled binaries and artifacts from build stage
COPY --from=builder /opt/quiche/target/debug/examples/ /opt/quiche/examples/
COPY --from=builder /opt/quiche/src/ /opt/quiche/src/
COPY --from=builder /opt/quiche/Cargo.toml /opt/quiche/

# Runtime environment setup
USER ${USER_N}

# Default runtime configuration
EXPOSE 4443
EXPOSE 8080

# Ensure required directories exist
RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Runtime mode labels for identification
ARG RUNTIME_MODE
LABEL panther.runtime.mode="${RUNTIME_MODE}"
LABEL panther.service.name="quiche"
LABEL panther.service.type="quic_iut"
LABEL panther.runtime.capabilities.minimal="quiche,rust,wireshark,tshark,tcpdump,iperf3"
LABEL panther.runtime.capabilities.debug="minimal+gdb,valgrind,strace"
LABEL panther.runtime.capabilities.profile="debug+perf,gperftools,radare2"

# Set entrypoint
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

# =============================================================================
# Usage Examples:
# Build quiche with minimal runtime (production):
#   docker build --build-arg RUNTIME_MODE=minimal -t quiche:minimal .
#
# Build quiche with debug runtime (development):
#   docker build --build-arg RUNTIME_MODE=debug -t quiche:debug .
#
# Build quiche with profile runtime (performance analysis):
#   docker build --build-arg RUNTIME_MODE=profile -t quiche:profile .
#
# Run quiche server:
#   docker run -p 4443:4443 -p 8080:8080 quiche:minimal "cd /opt/quiche && ./target/debug/examples/server"
# =============================================================================
