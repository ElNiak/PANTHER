# syntax=docker/dockerfile:1

# Multi-stage build for quic_go plugin isolation and optimization
# Build stage: Contains all build tools, Go toolchain, and dependencies
# Runtime stage: Minimal environment with only runtime binaries

# ============================================================================
# BUILD STAGE: Complete build environment with Go toolchain and dependencies
# ============================================================================

FROM --platform=linux/amd64 panther_base_service:latest AS builder

# Build arguments and environment
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# System configuration for build environment
ENV DEBIAN_FRONTEND=noninteractive

# Build dependencies with cache optimization
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
        build-essential \
        git \
        cmake \
        software-properties-common \
        openssl \
        libssl-dev \
        pkg-config \
        clang \
        binutils \
        libasan5 \
        wget \
        libhttp-parser2.9 \
        libubsan1 \
        && rm -rf /var/lib/apt/lists/*

# Install Go 1.21.10 with cache optimization
RUN --mount=type=cache,target=/tmp/go-cache \
    wget https://go.dev/dl/go1.21.10.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go1.21.10.linux-amd64.tar.gz
ENV PATH="$PATH:/usr/local/go/bin"

# User setup for build environment
USER ${USER_N}
WORKDIR /opt

# Clone and build quic-go with build cache optimization
RUN --mount=type=cache,target=/tmp/git-cache \
    --mount=type=cache,target=/tmp/go-cache \
    --mount=type=cache,target=/root/go/pkg/mod \
    git clone https://github.com/lucas-clemente/quic-go && \
    cd quic-go && \
    git fetch && \
    git checkout v0.45.2 && \
    git submodule update --init --recursive && \
    mkdir client server

# Add customized client/server files and certificates
ADD file_to_change/rfc9000-2/go_client/main.go /opt/quic-go/client/main.go
ADD file_to_change/rfc9000-2/go_server/main.go /opt/quic-go/server/main.go
ADD file_to_change/cert.pem /certs/cert.pem
ADD file_to_change/priv.key /certs/priv.key

# Build Go applications with cache optimization
RUN --mount=type=cache,target=/tmp/go-cache \
    --mount=type=cache,target=/root/go/pkg/mod \
    cd /opt/quic-go && \
    /usr/local/go/bin/go clean -modcache && \
    /usr/local/go/bin/go build -o server/server server/main.go && \
    /usr/local/go/bin/go build -o client/client client/main.go

# ============================================================================
# RUNTIME STAGE: Selected runtime environment (minimal/debug/profile)
# ============================================================================

# Use base service with runtime mode selection
# Base service provides: minimal (core+network) / debug (+gdb,valgrind,strace) / profile (+perf,gperftools,radare2)
ARG RUNTIME_MODE
FROM --platform=linux/amd64 panther_base_service:latest

# Runtime arguments (inherited ARG RUNTIME_MODE from global scope)
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Runtime dependencies only (no build tools or Go)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
        openssl \
        libssl1.1 \
        libhttp-parser2.9 \
        && rm -rf /var/lib/apt/lists/*

# Copy compiled binaries and certificates from build stage
COPY --from=builder /opt/quic-go/server/server /opt/quic-go/server/
COPY --from=builder /opt/quic-go/client/client /opt/quic-go/client/
COPY --from=builder /certs/ /certs/

# Runtime environment setup
USER ${USER_N}

# Default runtime configuration
EXPOSE 4443
EXPOSE 8080

# Ensure required directories exist
RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Runtime mode labels for identification
ARG RUNTIME_MODE
LABEL panther.runtime.mode="${RUNTIME_MODE}"
LABEL panther.service.name="quic_go"
LABEL panther.service.type="quic_iut"
LABEL panther.runtime.capabilities.minimal="quic-go,golang,wireshark,tshark,tcpdump,iperf3"
LABEL panther.runtime.capabilities.debug="minimal+gdb,valgrind,strace"
LABEL panther.runtime.capabilities.profile="debug+perf,gperftools,radare2"

# Set entrypoint
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

# =============================================================================
# Usage Examples:
# Build quic-go with minimal runtime (production):
#   docker build --build-arg RUNTIME_MODE=minimal -t quic_go:minimal .
#
# Build quic-go with debug runtime (development):
#   docker build --build-arg RUNTIME_MODE=debug -t quic_go:debug .
#
# Build quic-go with profile runtime (performance analysis):
#   docker build --build-arg RUNTIME_MODE=profile -t quic_go:profile .
#
# Run quic-go server:
#   docker run -p 4443:4443 -p 8080:8080 quic_go:minimal "cd /opt/quic-go && ./server/server"
# =============================================================================
