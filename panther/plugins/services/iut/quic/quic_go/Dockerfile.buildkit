# syntax=docker/dockerfile:1
# ARG TARGETPLATFORM=linux/amd64
FROM panther_base_service:latest AS base
ARG RUNTIME_MODE=minimal
ENV DEBIAN_FRONTEND=noninteractive

# Define build arguments for version-specific configurations
ARG VERSION=master
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Layer 1: Install Go and dependencies with cache mount
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install --fix-missing -y golang-go jq

# Switch to specified user (now properly defined)
USER ${USER_N}

# Layer 2: Go module cache for dependencies
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/tmp/quic-go-cache \
    cd /opt && \
    if [ -d "/tmp/quic-go-cache/.git" ]; then \
        echo "Using cached quic-go repository"; \
        cp -r /tmp/quic-go-cache quic-go; \
        cd quic-go && git fetch && git checkout ${VERSION}; \
    else \
        echo "Cloning fresh quic-go repository"; \
        git clone https://github.com/lucas-clemente/quic-go.git; \
        cd quic-go && git checkout ${VERSION}; \
        # Cache the repository \
        cp -r /opt/quic-go /tmp/quic-go-cache; \
    fi && \
    go mod download && \
    go build ./...

# Layer 3: Runtime configuration (rarely changes)
EXPOSE 4443 8080

RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Set entrypoint (can be overridden)
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
