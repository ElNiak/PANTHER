# syntax=docker/dockerfile:1
# ARG TARGETPLATFORM=linux/amd64
FROM panther_base_service:latest AS base
ARG RUNTIME_MODE=minimal
ENV DEBIAN_FRONTEND=noninteractive

# Define build arguments for version-specific configurations
ARG VERSION=master
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Layer 1: Install Rust and dependencies with cache mount
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install --fix-missing -y curl build-essential jq && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

ENV PATH="/root/.cargo/bin:${PATH}"

# Switch to specified user (now properly defined)
USER ${USER_N}

# Layer 2: Cargo cache for Rust dependencies
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/tmp/quinn-cache \
    cd /opt && \
    if [ -d "/tmp/quinn-cache/.git" ]; then \
        echo "Using cached Quinn repository"; \
        cp -r /tmp/quinn-cache quinn; \
        cd quinn && git fetch && git checkout ${VERSION}; \
    else \
        echo "Cloning fresh Quinn repository"; \
        git clone https://github.com/quinn-rs/quinn.git; \
        cd quinn && git checkout ${VERSION}; \
        # Cache the repository \
        cp -r /opt/quinn /tmp/quinn-cache; \
    fi && \
    cargo build --release

# Layer 3: Runtime configuration (rarely changes)
EXPOSE 4443 8080

RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Set entrypoint (can be overridden)
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
