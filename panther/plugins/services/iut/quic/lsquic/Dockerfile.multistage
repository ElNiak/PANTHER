# syntax=docker/dockerfile:1

# =============================================================================
# BUILD STAGE: Cross-platform build environment with BoringSSL
# =============================================================================

FROM --platform=$BUILDPLATFORM ubuntu:22.04@sha256:965fbcae990b0467ed5657caceaec165018ef44a4d2d46c7cdea80a9dff0d1ea AS builder

# BuildKit automatic arguments
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS=linux
ARG TARGETARCH

# Build configuration
ARG VERSION=master
ARG DEPENDENCIES="[]"
ARG BUILD_MODE=""
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}
ENV BUILD_MODE=${BUILD_MODE}

# System configuration for build environment
ENV DEBIAN_FRONTEND=noninteractive

# Build dependencies with platform-aware cache optimization
RUN --mount=type=cache,target=/var/cache/apt,id=apt-$BUILDPLATFORM,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=aptlib-$BUILDPLATFORM,sharing=locked \
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        git \
        wget \
        curl \
        pkg-config \
        libssl-dev \
        jq \
        && rm -rf /var/lib/apt/lists/*

# Cross-compilation setup
RUN --mount=type=cache,target=/var/cache/apt,id=crossbuild-$BUILDPLATFORM,sharing=locked \
    case "$TARGETARCH" in \
        arm64) apt-get update && apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && rm -rf /var/lib/apt/lists/* ;; \
        arm) apt-get update && apt-get install -y gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf && rm -rf /var/lib/apt/lists/* ;; \
        amd64) echo "Native build for amd64" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" && exit 1 ;; \
    esac

# Set cross-compilation environment
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++

# Perl dependencies for picotls test code
RUN echo install Test::TCP | perl -MCPAN - && \
    echo install Scope::Guard | perl -MCPAN -

# User setup for build environment
USER ${USER_N}
WORKDIR /opt

# Build BoringSSL with platform-specific build cache optimization
RUN --mount=type=cache,target=/tmp/git-cache,id=git-$TARGETPLATFORM,sharing=locked \
    --mount=type=cache,target=/tmp/build-cache,id=build-$TARGETPLATFORM,sharing=private \
    git clone https://boringssl.googlesource.com/boringssl && \
    cd boringssl && \
    git checkout 9fc1c33e9c21439ce5f87855a6591a9324e569fd && \
    git submodule init && \
    git submodule update && \
    cmake . && \
    make

# Set BoringSSL environment
ENV BORINGSSL=/opt/boringssl/

# Clone and build lsquic with build cache optimization
RUN --mount=type=cache,target=/tmp/git-cache \
    --mount=type=cache,target=/tmp/build-cache \
    git clone https://github.com/litespeedtech/lsquic.git && \
    cd lsquic && \
    git checkout v4.0.9 && \
    git submodule update --init

# Build lsquic with BoringSSL integration
RUN --mount=type=cache,target=/tmp/build-cache \
    cd /opt/lsquic && \
    cmake -DBORINGSSL_DIR=/opt/boringssl/ . && \
    make && \
    make test || true

# ============================================================================
# RUNTIME STAGE: Selected runtime environment (minimal/debug/profile)
# ============================================================================

# Use base service with runtime mode selection
# Base service provides: minimal (core+network) / debug (+gdb,valgrind,strace) / profile (+perf,gperftools,radare2)
ARG RUNTIME_MODE
FROM --platform=linux/amd64 panther_base_service:latest

# Runtime arguments (inherited ARG RUNTIME_MODE from global scope)
ARG VERSION=master
ARG DEPENDENCIES="[]"
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Runtime dependencies only (no build tools)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
        jq \
        libtest-tcp-perl \
        libssl1.1 \
        && rm -rf /var/lib/apt/lists/*

# Copy compiled binaries and BoringSSL libraries from build stage
COPY --from=builder /opt/lsquic/ /opt/lsquic/
COPY --from=builder /opt/boringssl/ssl/libssl.a /opt/boringssl/ssl/
COPY --from=builder /opt/boringssl/crypto/libcrypto.a /opt/boringssl/crypto/
COPY --from=builder /opt/boringssl/include/ /opt/boringssl/include/

# Set runtime environment for BoringSSL
ENV BORINGSSL=/opt/boringssl/

# Runtime environment setup
USER ${USER_N}

# Default runtime configuration
EXPOSE 4443
EXPOSE 8080

# Ensure required directories exist
RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Runtime mode labels for identification
ARG RUNTIME_MODE
LABEL panther.runtime.mode="${RUNTIME_MODE}"
LABEL panther.service.name="lsquic"
LABEL panther.service.type="quic_iut"
LABEL panther.runtime.capabilities.minimal="lsquic,boringssl,wireshark,tshark,tcpdump,iperf3"
LABEL panther.runtime.capabilities.debug="minimal+gdb,valgrind,strace"
LABEL panther.runtime.capabilities.profile="debug+perf,gperftools,radare2"

# Set entrypoint
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]

# =============================================================================
# Usage Examples:
# Build lsquic with minimal runtime (production):
#   docker build --build-arg RUNTIME_MODE=minimal -t lsquic:minimal .
#
# Build lsquic with debug runtime (development):
#   docker build --build-arg RUNTIME_MODE=debug -t lsquic:debug .
#
# Build lsquic with profile runtime (performance analysis):
#   docker build --build-arg RUNTIME_MODE=profile -t lsquic:profile .
#
# Run lsquic server:
#   docker run -p 4443:4443 -p 8080:8080 lsquic:minimal "cd /opt/lsquic && ./bin/echo_server"
# =============================================================================
