{% if env_vars %}
# Environment variables
{% for key, value in env_vars.items() %}
export {{ key }}={{ value|quote_shell }}
{% endfor %}
{% endif %}

# Execute the command with properly quoted arguments
{% for arg in command_args -%}
{%- if arg is string -%}
{%- if '"' in arg -%}
{%- set escaped_arg = arg.replace('"', '\\"') -%}
{{ escaped_arg }}
{%- elif '&' in arg or '|' in arg or ';' in arg or '$' in arg or '`' in arg or '(' in arg or ')' in arg -%}
{{ arg|quote_shell }}
{%- elif ' ' in arg -%}
"{{ arg }}"
{%- elif arg in ['>', '>>', '<', '<<', '|', '&', ';'] -%}
{{ arg|quote_shell }}
{%- else -%}
{{ arg }}
{%- endif -%}
{%- else -%}
{{ arg|string|quote_shell }}
{%- endif -%}
{%- if not loop.last %} {% endif -%}
{%- endfor %}
