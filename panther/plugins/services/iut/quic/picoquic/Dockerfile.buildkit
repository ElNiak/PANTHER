# syntax=docker/dockerfile:1

# =============================================================================
# PICOQUIC Implementation - Modern Multi-Platform BuildKit Dockerfile
# Cross-platform build with automatic platform detection and security hardening
# =============================================================================

# BuildKit automatic platform arguments
ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG BUILDVARIANT

# Runtime configuration
ARG RUNTIME_MODE=minimal
ARG BASE_IMAGE=panther_base_service:latest
ARG BASE_IMAGE_DIGEST=sha256:965fbcae990b0467ed5657caceaec165018ef44a4d2d46c7cdea80a9dff0d1ea

# Define build arguments for version-specific configurations
ARG VERSION=master
ARG DEPENDENCIES="[]"  # JSON-formatted list of dependencies
ARG USER_N=root  # Define USER_N with default value

# =============================================================================
# STAGE 1: BUILD - Cross-platform build environment for PICOQUIC
# =============================================================================

FROM --platform=$TARGETPLATFORM ${BASE_IMAGE} AS base

# Re-declare ARGs after FROM to make them available in this stage
ARG VERSION
ARG DEPENDENCIES
ARG TARGETARCH
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE=minimal

ENV DEBIAN_FRONTEND=noninteractive
ENV VERSION=${VERSION}
ENV DEPENDENCIES=${DEPENDENCIES}

# Layer 1: Install cross-compilation tools based on target architecture
RUN --mount=type=cache,target=/var/cache/apt,id=crossbuild-$BUILDPLATFORM,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,id=crossbuild-$TARGETPLATFORM,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    case "$TARGETARCH" in \
        arm64) \
            apt-get update && \
            apt-get install --no-install-recommends -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && \
            rm -rf /var/lib/apt/lists/* ;; \
        arm) \
            apt-get update && \
            apt-get install --no-install-recommends -y gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf && \
            rm -rf /var/lib/apt/lists/* ;; \
        amd64) \
            echo "Native compilation for amd64" ;; \
        *) \
            echo "Unsupported target architecture: $TARGETARCH" && exit 1 ;; \
    esac

# Set cross-compilation environment variables with CMAKE support
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    CC_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CXX_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-g++ \
    CMAKE_C_COMPILER_aarch64=aarch64-linux-gnu-gcc \
    CMAKE_CXX_COMPILER_aarch64=aarch64-linux-gnu-g++

# Layer 3: Dependency building with comprehensive cache (expensive, changes occasionally)
RUN --mount=type=cache,target=/tmp/git-cache,id=picoquic-git-${RUNTIME_MODE}-${TARGETPLATFORM},sharing=locked \
    --mount=type=cache,target=/tmp/build-cache,id=picoquic-build-${RUNTIME_MODE}-${TARGETPLATFORM},sharing=private \
    cd /opt && \
    echo "Starting dependency installation..." && \
    echo $DEPENDENCIES | jq -c '.[]' | while read -r dep; do \
    DEP_NAME=$(echo $dep | jq -r '.name'); \
    DEP_URL=$(echo $dep | jq -r '.url'); \
    DEP_COMMIT=$(echo $dep | jq -r '.commit'); \
    if [ -n "$DEP_NAME" ] && [ -n "$DEP_URL" ] && [ -n "$DEP_COMMIT" ]; then \
    echo "Processing dependency '$DEP_NAME' from '$DEP_URL' at commit '$DEP_COMMIT'"; \
    # Use cached git repo if available \
    if [ -d "/tmp/git-cache/$DEP_NAME" ]; then \
    echo "Using cached repository for $DEP_NAME"; \
    cp -r "/tmp/git-cache/$DEP_NAME" "$DEP_NAME"; \
    cd "$DEP_NAME" && git fetch && git checkout "$DEP_COMMIT"; \
    else \
    echo "Cloning fresh repository for $DEP_NAME"; \
    git clone "$DEP_URL" "$DEP_NAME"; \
    cd "$DEP_NAME" && git checkout "$DEP_COMMIT"; \
    # Cache the repository \
    cp -r "/opt/$DEP_NAME" "/tmp/git-cache/$DEP_NAME"; \
    fi; \
    git submodule update --init --recursive; \
    # Use build cache for compilation \
    if [ -d "/tmp/build-cache/$DEP_NAME" ]; then \
    echo "Restoring build cache for $DEP_NAME"; \
    cp -r "/tmp/build-cache/$DEP_NAME"/* . 2>/dev/null || true; \
    fi; \
    OPENSSL_INCLUDE_DIR="/usr/include/openssl" cmake . && \
    make && \
    (make check || echo "Warning: make check failed for $DEP_NAME, continuing..."); \
    # Save build artifacts to cache \
    mkdir -p "/tmp/build-cache/$DEP_NAME"; \
    (cp -r . "/tmp/build-cache/$DEP_NAME/" 2>/dev/null || true); \
    echo "Successfully built dependency '$DEP_NAME'"; \
    cd /opt; \
    else \
    echo "Invalid dependency configuration: $dep"; \
    exit 1; \
    fi; \
    done

# Layer 4: Main picoquic repository (changes when VERSION changes)
RUN --mount=type=cache,target=/tmp/git-cache/picoquic,id=picoquic-src-${RUNTIME_MODE}-${TARGETPLATFORM},sharing=locked \
    --mount=type=cache,target=/tmp/picoquic-build,id=picoquic-cmake-${RUNTIME_MODE}-${TARGETPLATFORM},sharing=private \
    cd /opt && \
    if [ -d "/tmp/git-cache/picoquic/.git" ]; then \
    echo "Using cached picoquic repository"; \
    cp -r /tmp/git-cache/picoquic picoquic; \
    cd picoquic && git fetch && git checkout ${VERSION}; \
    else \
    echo "Cloning fresh picoquic repository"; \
    git clone https://github.com/private-octopus/picoquic.git; \
    cd picoquic && git checkout ${VERSION}; \
    # Cache the repository \
    cp -r /opt/picoquic /tmp/git-cache/picoquic; \
    fi && \
    # Use build cache for compilation \
    if [ -d "/tmp/picoquic-build/cmake_cache" ]; then \
    echo "Restoring cmake cache"; \
    cp -r /tmp/picoquic-build/cmake_cache/* . 2>/dev/null || true; \
    fi && \
    cmake . && \
    make && \
    (./picoquic_ct || true) && \
    # Verify binary was built \
    test -f /opt/picoquic/picoquicdemo && \
    echo "picoquicdemo binary verified" && \
    # Save cmake cache \
    mkdir -p /tmp/picoquic-build/cmake_cache && \
    (cp -r CMakeCache.txt CMakeFiles/ Makefile /tmp/picoquic-build/cmake_cache/ 2>/dev/null || true)

# =============================================================================
# FINAL STAGE: Runtime configuration with platform metadata
# =============================================================================

# Target platform runtime stage
FROM --platform=$TARGETPLATFORM base AS runtime

# Layer: Runtime configuration
EXPOSE 4443 8080

RUN mkdir -p /app/logs /opt/certs /opt/ticket

# Platform and build metadata for debugging and compliance
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE
ARG TARGETOS
ARG TARGETARCH

LABEL platform.build="${BUILDPLATFORM}"
LABEL platform.target="${TARGETPLATFORM}"
LABEL platform.os="${TARGETOS}"
LABEL platform.arch="${TARGETARCH}"
LABEL runtime.mode="${RUNTIME_MODE}"
LABEL implementation="picoquic"
LABEL version="master"
LABEL runtime.description="PICOQUIC implementation execution environment"
LABEL build.syntax="docker/dockerfile:1"

# Health check for runtime validation
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -d /opt || exit 1

# Set entrypoint (can be overridden)
ENTRYPOINT [ "/bin/bash", "-l", "-c" ]
