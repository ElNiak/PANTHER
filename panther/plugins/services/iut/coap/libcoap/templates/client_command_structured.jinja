#!/bin/bash
# Structured command template for ping_pong client
# Generated commands are properly escaped using quote_shell filter

{% if env_vars %}
# Environment variables
{% for key, value in env_vars.items() %}
export {{ key }}={{ value|quote_shell }}
{% endfor %}
{% endif %}

# Execute the command with properly quoted arguments
{{ binary.name }} \
{% for arg in command_args %}
  {{ arg|quote_shell }} {% if not loop.last %}\{% endif %}
{% endfor %}
