# syntax=docker/dockerfile:1

# =============================================================================
# PANTHER Service - Modern Multi-Platform BuildKit Dockerfile
# Cross-platform build with automatic platform detection and security hardening
# =============================================================================

# BuildKit automatic platform arguments
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS=linux
ARG TARGETARCH

# Runtime configuration
ARG RUNTIME_MODE=minimal

# =============================================================================
# STAGE 1: BUILDER - Cross-platform build environment
# =============================================================================
# Use digest-pinned image with platform awareness for security and performance
FROM --platform=$TARGETPLATFORM ubuntu:20.04 AS builder

# BuildKit automatic platform arguments
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS=linux
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

RUN echo "Building on platform: $BUILDPLATFORM" && \
    echo "Target platform: $TARGETPLATFORM" && \
    echo "Target OS: $TARGETOS" && \
    echo "Target architecture: $TARGETARCH"

# Platform-aware package installation with enhanced security
RUN --mount=type=cache,target=/var/cache/apt,id=apt-$TARGETPLATFORM,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=aptlib-$TARGETPLATFORM,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    apt-get update && \
    apt-get install --fix-missing --auto-remove --show-upgraded --no-install-recommends -y \
    build-essential git cmake software-properties-common \
    openssl libssl-dev pkg-config python3 \
    clang automake autoconf libtool \
    wget curl sudo \
    libc6-dev libdw1 libelf1 libunwind-dev && \
    rm -rf /var/lib/apt/lists/*

# Install cross-compilation tools based on target architecture
RUN --mount=type=cache,target=/var/cache/apt,id=crossbuild-$TARGETPLATFORM,sharing=locked \
    case "$TARGETARCH" in \
        arm64) \
            apt-get update && \
            apt-get install -y gcc-aarch64-linux-gnu g++-aarch64-linux-gnu && \
            rm -rf /var/lib/apt/lists/* ;; \
        arm) \
            apt-get update && \
            apt-get install -y gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf && \
            rm -rf /var/lib/apt/lists/* ;; \
        amd64) \
            echo "Native compilation for amd64 - already installed" ;; \
        *) \
            echo "Unsupported target architecture: $TARGETARCH" && exit 1 ;; \
    esac

# Set cross-compilation environment variables
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    CC_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CXX_arm_unknown_linux_gnueabihf=arm-linux-gnueabihf-g++

# Git clone with platform-specific build cache isolation
RUN --mount=type=cache,target=/tmp/git-cache,id=git-$TARGETPLATFORM,sharing=locked \
    --mount=type=cache,target=/tmp/build-cache,id=build-$TARGETPLATFORM,sharing=private \
    git clone https://github.com/gperftools/gperftools /tmp/git-cache/gperftools || \
    (cd /tmp/git-cache/gperftools && git pull) && \
    cp -r /tmp/git-cache/gperftools /gperftools

WORKDIR /gperftools

# Build with cache for compiled objects
RUN --mount=type=cache,target=/gperftools/.libs \
    --mount=type=cache,target=/gperftools/src/.libs \
    ./autogen.sh && \
    ./configure && \
    make && \
    make install

RUN whereis libprofiler && whereis libtcmalloc

WORKDIR /
RUN mkdir -p /app /opt

# =============================================================================
# STAGE 2: DEBUG - MINIMAL + debugging tools
# =============================================================================
# NOTE: For x86-only, this inherits builder's TARGETPLATFORM (may need TARGETPLATFORM base)
FROM builder AS debug

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE=minimal
ARG TARGETOS
ARG TARGETARCH

# Install debugging tools with cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    case "$TARGETARCH" in \
      amd64)   PKGS="gdb valgrind strace util-linux" ;; \
      arm64)   PKGS="gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
                     gdb-multiarch valgrind strace util-linux" ;; \
      arm)     PKGS="gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf \
                     gdb-multiarch valgrind strace util-linux" ;; \
      *)       echo "Unsupported arch $TARGETARCH" && exit 1 ;; \
    esac && \
    apt-get install -y --no-install-recommends $PKGS && \
    rm -rf /var/lib/apt/lists/*

# Copy built gperftools for debugging
COPY --from=builder /usr/local/lib/libprofiler.* /usr/local/lib/
COPY --from=builder /usr/local/lib/libtcmalloc.* /usr/local/lib/

# Security: Create non-root user with proper setup
RUN groupadd -r pantheruser && useradd -r -g pantheruser pantheruser

# Configure wireshark for non-root usage (PANTHER protocol testing requirement)
RUN yes yes | DEBIAN_FRONTEND=teletype dpkg-reconfigure wireshark-common && \
    usermod -aG wireshark pantheruser

# Create application directories with proper ownership
RUN mkdir -p /app /opt && \
    chown -R pantheruser:pantheruser /app /opt

# =============================================================================
# STAGE 3: PROFILE - DEBUG + performance profiling tools
# =============================================================================
FROM debug AS profile

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE=minimal
ARG TARGETOS
ARG TARGETARCH

# Install performance profiling tools with cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install --no-install-recommends -y \
    linux-tools-generic linux-tools-common linux-cloud-tools-common \
     google-perftools graphviz gv

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    snap install radare2 --classic

# Update library cache for gperftools
RUN ldconfig

# Security: Create non-root user with proper setup
RUN groupadd -r pantheruser && useradd -r -g pantheruser pantheruser

# Configure wireshark for non-root usage (PANTHER protocol testing requirement)
RUN yes yes | DEBIAN_FRONTEND=teletype dpkg-reconfigure wireshark-common && \
    usermod -aG wireshark pantheruser

# Create application directories with proper ownership
RUN mkdir -p /app /opt && \
    chown -R pantheruser:pantheruser /app /opt

# =============================================================================
# STAGE 4: MINIMAL - Core runtime + network analysis (PANTHER requirement)
# =============================================================================
# Target platform runtime with security hardening
# NOTE: For x86-only deployments, override with: --platform linux/amd64
FROM --platform=$TARGETPLATFORM ubuntu:20.04 AS minimal

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE=minimal
ARG TARGETOS
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# Security: Run as non-root user
RUN groupadd -r pantheruser && useradd -r -g pantheruser pantheruser

# Platform-aware runtime dependencies with security
RUN --mount=type=cache,target=/var/cache/apt,id=runtime-$TARGETPLATFORM,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=runtimelib-$TARGETPLATFORM,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    apt-get update && \
    apt-get install --fix-missing --auto-remove --show-upgraded --no-install-recommends -y \
    python3 openssl ca-certificates \
    net-tools tcpdump iperf iperf3 traceroute \
    wireshark tshark libcap2-bin \
    iputils-ping iproute2 netcat-openbsd \
    curl dnsutils  wireshark-common && \
    rm -rf /var/lib/apt/lists/*

# Configure wireshark for non-root usage (PANTHER protocol testing requirement)
RUN yes yes | DEBIAN_FRONTEND=teletype dpkg-reconfigure wireshark-common && \
    usermod -aG wireshark pantheruser

# Create application directories with proper ownership
RUN mkdir -p /app /opt && \
    chown -R pantheruser:pantheruser /app /opt

# =============================================================================
# FINAL STAGE: Runtime mode selection with platform metadata
# =============================================================================
FROM ${RUNTIME_MODE} AS final

# Platform and build metadata for debugging and compliance
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG RUNTIME_MODE=minimal
ARG TARGETOS
ARG TARGETARCH

LABEL platform.build="${BUILDPLATFORM}"
LABEL platform.target="${TARGETPLATFORM}"
LABEL platform.os="${TARGETOS}"
LABEL platform.arch="${TARGETARCH}"
LABEL runtime.mode="${RUNTIME_MODE}"
LABEL runtime.description="PANTHER base service execution environment"
LABEL runtime.capabilities.network="wireshark,tshark,tcpdump,iperf3"
LABEL runtime.capabilities.debug="gdb,valgrind,strace"
LABEL runtime.capabilities.profile="perf,gperftools,radare2"
LABEL security.user="pantheruser"
LABEL build.syntax="docker/dockerfile:1"

# Security: Switch to non-root user
USER pantheruser
WORKDIR /app

# Create necessary directories with proper ownership
RUN mkdir -p /app/logs /app/certs /app/data

# Health check for runtime validation
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1
