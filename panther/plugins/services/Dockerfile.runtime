# syntax=docker/dockerfile:1

# =============================================================================
# PANTHER Runtime Stages - Minimal/Debug/Profile Runtime Environments
# Multi-stage runtime selection based on RUNTIME_MODE argument
# =============================================================================

# Import builder stage
ARG BUILDER_IMAGE=builder
ARG TARGETPLATFORM=linux/amd64

# =============================================================================
# STAGE 1: DEBUG - MINIMAL + debugging tools
# =============================================================================
FROM ${BUILDER_IMAGE} AS debug

# Install debugging tools with platform-specific cache
RUN --mount=type=cache,target=/var/cache/apt,id=debug-${TARGETPLATFORM},sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=debuglib-${TARGETPLATFORM},sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    apt-get update && \
    apt-get install --no-install-recommends -y \
    gdb valgrind strace util-linux && \
    rm -rf /var/lib/apt/lists/*

# Copy built gperftools for debugging
COPY --from=${BUILDER_IMAGE} /usr/local/lib/libprofiler.* /usr/local/lib/
COPY --from=${BUILDER_IMAGE} /usr/local/lib/libtcmalloc.* /usr/local/lib/

# Metadata for debug stage
LABEL panther.stage="debug" \
      panther.size="~600MB" \
      panther.purpose="minimal-runtime-plus-debugging-tools" \
      panther.packages="gdb,valgrind,strace,gperftools"

# =============================================================================
# STAGE 2: PROFILE - DEBUG + performance profiling tools
# =============================================================================
FROM debug AS profile

# Install performance profiling tools with platform-specific cache
RUN --mount=type=cache,target=/var/cache/apt,id=profile-${TARGETPLATFORM},sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=profilelib-${TARGETPLATFORM},sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    apt-get update && \
    apt-get install --no-install-recommends -y \
    linux-tools-generic linux-tools-common linux-cloud-tools-common \
    radare2 google-perftools graphviz gv && \
    rm -rf /var/lib/apt/lists/*

# Update library cache for gperftools
RUN ldconfig

# Metadata for profile stage
LABEL panther.stage="profile" \
      panther.size="~800MB" \
      panther.purpose="debug-runtime-plus-profiling-tools" \
      panther.packages="debug-tools,perf,gperftools,radare2,graphviz"

# =============================================================================
# STAGE 3: MINIMAL - Core runtime + network analysis (PANTHER requirement)
# =============================================================================

# Target platform runtime with security hardening
FROM --platform=linux/amd64 ubuntu:20.04 AS minimal

ENV DEBIAN_FRONTEND=noninteractive

# Note: User security is applied via Dockerfile.user.buildkit layer for flexibility

# Platform-aware runtime dependencies with security
RUN --mount=type=cache,target=/var/cache/apt,id=runtime-${TARGETPLATFORM},sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=runtimelib-${TARGETPLATFORM},sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    ln -fs /usr/share/zoneinfo/UTC /etc/localtime && \
    apt-get update && \
    apt-get install --fix-missing --auto-remove --show-upgraded --no-install-recommends -y \
    python3 openssl ca-certificates \
    net-tools tcpdump iperf iperf3 traceroute \
    wireshark-common wireshark tshark libcap2-bin \
    iputils-ping iproute2 netcat-openbsd \
    curl dnsutils automake autoconf libtool pkg-config libssl-dev \
    cmake build-essential

# Configure wireshark for non-root usage (PANTHER protocol testing requirement)
# Note: User will be added to wireshark group in security layer
RUN apt-get install -y wireshark-common && \
    yes yes | DEBIAN_FRONTEND=teletype dpkg-reconfigure wireshark-common

# Create application directories (ownership handled by security layer)
RUN mkdir -p /app /opt /app/logs /app/certs /app/data

# Metadata for minimal stage
LABEL panther.stage="minimal" \
      panther.size="~200MB" \
      panther.purpose="core-runtime-with-network-analysis" \
      panther.packages="python3,wireshark,tcpdump,iperf3,cmake" \
      panther.wireshark="fixed-dpkg-reconfigure-issue"
