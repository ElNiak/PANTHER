# syntax=docker/dockerfile:1

# =============================================================================
# PANTHER Service - Modular Multi-Platform BuildKit Dockerfile
# Cross-platform build with automatic platform detection and security hardening
# =============================================================================

# BuildKit automatic platform arguments
ARG BUILDPLATFORM=linux/amd64
ARG TARGETPLATFORM=linux/amd64
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG BUILDVARIANT

# Runtime configuration
ARG RUNTIME_MODE=minimal

# =============================================================================
# STAGE IMPORTS - Modular Dockerfile Components
# =============================================================================

# Stage 1: Builder Environment (Lines 1-106 from original)
FROM docker.io/library/ubuntu:20.04 AS builder-base
ENV DEBIAN_FRONTEND=noninteractive

# Import builder stage from modular file
# Note: In production, these would be built as separate base images
COPY Dockerfile.builder /tmp/
RUN echo "Builder stage - See Dockerfile.builder for implementation"

# Stage 2: Runtime Stages (Lines 107-177 from original)
# Import runtime stages from modular file
COPY Dockerfile.runtime /tmp/
RUN echo "Runtime stages - See Dockerfile.runtime for implementation"

# Stage 3: Final Orchestration (Lines 178-207 from original)
# Import final stage from modular file
COPY Dockerfile.final /tmp/
RUN echo "Final stage - See Dockerfile.final for implementation"

# =============================================================================
# QUICK REFERENCE - Stage Selection
# =============================================================================
# RUNTIME_MODE=minimal → ~200MB (python3, wireshark, tcpdump, iperf3)
# RUNTIME_MODE=debug   → ~600MB (minimal + gdb, valgrind, strace, gperftools)
# RUNTIME_MODE=profile → ~800MB (debug + perf, radare2, graphviz)
#
# Usage:
#   docker build --build-arg RUNTIME_MODE=debug .
#   docker build --build-arg RUNTIME_MODE=profile .
#   docker build --build-arg RUNTIME_MODE=minimal .  (default)
# =============================================================================

# Metadata for modular architecture
LABEL panther.architecture="modular" \
      panther.components="builder,runtime,final" \
      panther.files="Dockerfile.builder,Dockerfile.runtime,Dockerfile.final" \
      panther.visibility="improved-maintainability"
