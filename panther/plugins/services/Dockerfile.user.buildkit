# syntax=docker/dockerfile:1

# =============================================================================
# PANTHER User Security Layer - Secure by Default
# =============================================================================
#
# This Dockerfile provides a security layer that can be applied to any PANTHER
# service image to ensure secure-by-default runtime behavior.
#
# Usage:
#   # Development (flexible, can run as root)
#   docker build -f Dockerfile.buildkit -t my-service:dev .
#
#   # Production (secure, runs as non-root)
#   docker build -f Dockerfile.buildkit -t my-service:base .
#   docker build -f Dockerfile.user.buildkit --build-arg BASE_IMAGE=my-service:base -t my-service:secure .
#
# =============================================================================

ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS base

# Create non-root user for secure runtime (if not exists)
RUN if ! id pantheruser >/dev/null 2>&1; then \
        groupadd -r pantheruser && \
        useradd -r -g pantheruser -s /bin/bash -m pantheruser; \
    fi

# Ensure proper ownership of common application directories
RUN mkdir -p /app /opt /home/pantheruser && \
    # Fix ownership of key directories that might have been created as root
    chown -R pantheruser:pantheruser /app /opt /home/pantheruser 2>/dev/null || true && \
    # Fix ownership of panther_ivy directory if it exists
    if [ -d /opt/panther_ivy ]; then \
        chown -R pantheruser:pantheruser /opt/panther_ivy; \
    fi

# Security hardening: Remove unnecessary packages and clean up
RUN apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    # Remove potentially sensitive files
    find / -type f -name "*.log" -delete 2>/dev/null || true && \
    find / -type f -name "*.tmp" -delete 2>/dev/null || true

# Configure sudo access for pantheruser (optional, can be removed in high-security environments)
RUN echo "pantheruser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/pantheruser && \
    chmod 440 /etc/sudoers.d/pantheruser

# Set secure file permissions
RUN chmod 755 /home/pantheruser && \
    chmod -R 755 /app /opt 2>/dev/null || true

# Security labels for compliance and monitoring
LABEL security.user="pantheruser"
LABEL security.uid="1000"
LABEL security.gid="1000"
LABEL security.sudo="enabled"
LABEL security.layer="user-security"
LABEL security.description="PANTHER secure runtime with non-root user"

# Final security: Switch to non-root user
USER pantheruser
WORKDIR /app

# Health check to ensure user switching worked
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD [ "$(id -u)" != "0" ] || exit 1
