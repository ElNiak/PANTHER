FROM python:3.10-slim

# Install required system packages
RUN apt-get update && apt-get install -y \
    tshark \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Create logs directory
RUN mkdir -p /app/logs

# Copy test service
COPY test_services/universal_test_service.py /app/universal_test_service.py
RUN chmod +x /app/universal_test_service.py

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV SERVICE_NAME=test_service
ENV SERVICE_ROLE=server
ENV MOCK_RUNTIME=5
ENV CREATE_ADDITIONAL_FILES=false

# Default command
CMD ["python", "/app/universal_test_service.py"]
