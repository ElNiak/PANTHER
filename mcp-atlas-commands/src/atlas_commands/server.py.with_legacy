    # OTLP Concurrency Pipeline Methods
            f"Status: {metadata['status']}",
            f"Created at: {metadata['created_at']}",
            f"Storage path: {self.storage_manager.get_task_root(args['project_name'], args['task_id'])}"
        ]

        # Suggest memory entity creation
        memory_creation_suggestion = self._suggest_memory_entity(
            memory_entity_name,
            "TaskInstance", 
            memory_observations
        )
        suggested_memory_operations = [memory_creation_suggestion]
        # Suggest linking to project entity
        project_entity_name = f"{args['project_name']}_Project"
        memory_relation_suggestion = self._suggest_memory_relation(
            memory_entity_name,
            project_entity_name,
            "belongs_to_project"
        )
        suggested_memory_operations.append(memory_relation_suggestion)

        result = {
            "success": True,
            "task_id": args["task_id"],
            "project_name": args["project_name"],
            "status": metadata["status"],
            "created_at": metadata["created_at"],
            "storage_path": str(self.storage_manager.get_task_root(args["project_name"], args["task_id"])),
            "memory_entity": memory_entity_name,
            "suggested_memory_operations": suggested_memory_operations
        }

        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_update_task_status(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle task status update with persistence and memory integration."""
        metadata = self.storage_manager.update_task_status(
            args["project_name"],
            args["task_id"],
            args["status"],
            args.get("phase")
        )
        
        # Update memory entity with status change
        memory_entity_name = f"{args['project_name']}_TASK_{args['task_id'].replace('-', '_')}"
        status_observation = f"Status updated to: {args['status']}"
        if args.get("phase"):
            status_observation += f" (Phase: {args['phase']})"
        status_observation += f" at {datetime.now().isoformat()}"
        
        # Suggest memory operation for status update
        memory_update_suggestion = self._suggest_memory_observations(
            memory_entity_name,
            [status_observation]
        )
        
        result = {
            "success": True,
            "task_id": args["task_id"],
            "new_status": args["status"],
            "current_phase": metadata["current_phase"],
            "updated": True,
            "suggested_memory_operations": [memory_update_suggestion]
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_add_task_artifact(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle artifact addition with persistence and memory integration."""
        artifact_path = self.storage_manager.add_task_artifact(
            args["project_name"],
            args["task_id"],
            args["artifact_type"],
            args["content"],
            args["filename"],
            args.get("description", "")
        )
        
        # Update memory entity with artifact addition
        memory_entity_name = f"{args['project_name']}_TASK_{args['task_id'].replace('-', '_')}"
        artifact_observation = f"Artifact added: {args['artifact_type']} ({args['filename']})"
        if args.get("description"):
            artifact_observation += f" - {args['description']}"
        artifact_observation += f" at {datetime.now().isoformat()}"
        
        # Suggest memory operation for artifact addition
        memory_update_suggestion = self._suggest_memory_observations(
            memory_entity_name,
            [artifact_observation]
        )
        
        result = {
            "success": True,
            "task_id": args["task_id"],
            "artifact_type": args["artifact_type"],
            "filename": args["filename"],
            "artifact_path": artifact_path,
            "persisted": True,
            "suggested_memory_operations": [memory_update_suggestion]
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
