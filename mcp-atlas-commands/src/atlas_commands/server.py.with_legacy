        metrics_health = self.metrics.get_health_metrics()
        
        status_text = f"""# Observability System Status

## OpenTelemetry Status
- **Enabled**: {status['enabled']}
- **Available**: {status['otel_available']} 
- **Service**: {status['service_name']} v{status['service_version']}
- **Environment**: {status['deployment_environment']}
- **Timestamp**: {status['timestamp']}

## Tracing
- **Tracer Provider**: {status.get('tracer_provider', False)}
- **Console Exporter**: {status.get('exporters', {}).get('console', False)}
- **OTLP Exporter**: {status.get('exporters', {}).get('otlp', False)}
- **Jaeger Exporter**: {status.get('exporters', {}).get('jaeger', False)}

## Metrics
- **Meter Provider**: {status.get('meter_provider', False)}
- **Metrics Enabled**: {metrics_health['metrics_enabled']}
- **Prometheus**: {status.get('exporters', {}).get('prometheus', False)}

## Configuration
- **Service Name**: {status['service_name']}
- **Service Version**: {status['service_version']}"""

        if not status['enabled']:
            status_text += f"""

## Fallback Metrics
- **Available**: {len(metrics_health.get('fallback_metrics', {}))} metrics collected"""

        return [TextContent(type="text", text=status_text)]
    
    async def _handle_get_metrics_summary(self, args: Dict[str, Any]) -> List[TextContent]:
        """Get metrics summary and performance statistics."""
        include_fallback = args.get("include_fallback", True)
        
        # Get cache stats for additional context
        cache_stats = self.cache_manager.get_stats()
        
        metrics_text = f"""# Metrics Summary

## Cache Performance
- **Hit Rate**: {cache_stats['hit_rate']:.1%}
- **Total Operations**: {cache_stats['total_gets'] + cache_stats['total_sets']}
- **L1 Size**: {cache_stats['l1_size']} entries
- **L2 Enabled**: {cache_stats['l2_enabled']}

## Cache Breakdown
- **L1 Hits/Misses**: {cache_stats['l1_hits']}/{cache_stats['l1_misses']}
- **L2 Hits/Misses**: {cache_stats['l2_hits']}/{cache_stats['l2_misses']}
- **L3 Hits/Misses**: {cache_stats['l3_hits']}/{cache_stats['l3_misses']}"""

        # Add OpenTelemetry metrics if available
        if self.metrics.enabled:
            metrics_text += """

## OpenTelemetry Metrics
- **Status**: Active
- **Exporters**: Configured via environment"""
        else:
            metrics_text += """

## Fallback Metrics
- **Status**: OpenTelemetry unavailable, using fallback collection"""
            
            if include_fallback:
                fallback_metrics = self.metrics.get_fallback_metrics()
                if fallback_metrics:
                    metrics_text += "\n\n### Collected Metrics:\n"
                    for metric_name, value in sorted(fallback_metrics.items()):
                        metrics_text += f"- **{metric_name}**: {value}\n"

        return [TextContent(type="text", text=metrics_text)]
    
    async def _handle_export_traces(self, args: Dict[str, Any]) -> List[TextContent]:
        """Force export of current traces."""
        if not self.observability.enabled:
            return [TextContent(type="text", text="OpenTelemetry not enabled - no traces to export")]
        
        try:
            # Force flush traces
            if self.observability.tracer_provider:
                # In a real implementation, you'd force flush the tracer provider
                message = "Trace export triggered - traces will be sent to configured exporters"
            else:
                message = "No tracer provider available for export"
                
        except Exception as e:
            message = f"Error exporting traces: {str(e)}"
        
        return [TextContent(type="text", text=message)]
    
    async def _handle_set_trace_sampling(self, args: Dict[str, Any]) -> List[TextContent]:
        """Set trace sampling rate."""
        sample_rate = args["sample_rate"]
        
        if not self.observability.enabled:
            return [TextContent(type="text", text="OpenTelemetry not enabled - sampling rate not applied")]
        
        # In a real implementation, you'd update the sampling configuration
        # This would typically require recreating the tracer provider
        message = f"""Trace sampling rate update requested: {sample_rate:.1%}

Note: Sampling rate changes require service restart to take full effect.
Current configuration should be updated via environment variable OTEL_TRACE_SAMPLE_RATE={sample_rate}"""
        
        return [TextContent(type="text", text=message)]

    # Embeddings tool handlers
    
    @trace_mcp_tool('search_similar_tasks')
    async def _handle_search_similar_tasks(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle semantic search for similar tasks."""
        try:
            # Create search context
            context = SearchContext(
                current_task_id=args.get("context_task_id"),
                project_name=args.get("project_name"),
                domain=args.get("domain")
            )
            
            # Perform search
            results = self.semantic_search.search_similar_tasks(
                query=args["query"],
                context=context,
                max_results=args.get("max_results", 10),
                threshold=args.get("threshold", 0.7)
            )
            
            if not results:
                return [TextContent(type="text", text="No similar tasks found matching your query.")]
            
            # Format results
            response = f"Found {len(results)} similar tasks:\n\n"
            for result in results:
                response += f"🎯 **{result.task_id}** (similarity: {result.similarity_score:.3f})\n"
                response += f"   Type: {result.result_type} | Rank: {result.relevance_rank}\n"
                response += f"   {result.explanation}\n\n"
            
            # Record metrics
            self.metrics.record_tool_call('search_similar_tasks', 0.1, True, {
                'results_count': len(results),
                'query_length': len(args["query"])
            })
            
            return [TextContent(type="text", text=response)]
            
        except Exception as e:
            self.logger.error(f"Error in semantic search: {e}")
            return [TextContent(type="text", text=f"Error performing semantic search: {str(e)}")]
    
    @trace_mcp_tool('discover_related_concepts')
    async def _handle_discover_related_concepts(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle discovery of related concepts for a task."""
        try:
            task_id = args["task_id"]
            relation_types = args.get("relation_types")
            max_distance = args.get("max_distance", 3)
            
            # Find related concepts
            results = self.semantic_search.find_related_concepts(
                task_id=task_id,
                relation_types=relation_types,
                max_distance=max_distance
            )
            
            if not results:
                return [TextContent(type="text", text=f"No related concepts found for task {task_id}.")]
            
            # Format results
            response = f"Found {len(results)} related concepts for {task_id}:\n\n"
            
            # Group by relationship type
            by_type = {}
            for result in results:
                rel_type = result.metadata.get("relationship_type", "unknown")
                if rel_type not in by_type:
                    by_type[rel_type] = []
                by_type[rel_type].append(result)
            
            for rel_type, type_results in by_type.items():
                response += f"## {rel_type.title()} Relationships\n"
                for result in type_results[:5]:  # Limit per type
                    response += f"🔗 **{result.task_id}** (similarity: {result.similarity_score:.3f})\n"
                    response += f"   {result.explanation}\n"
                response += "\n"
            
            return [TextContent(type="text", text=response)]
            
        except Exception as e:
            self.logger.error(f"Error discovering related concepts: {e}")
            return [TextContent(type="text", text=f"Error discovering related concepts: {str(e)}")]
    
    @trace_mcp_tool('find_solution_patterns')
    async def _handle_find_solution_patterns(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle discovery of solution patterns for problems."""
        try:
            problem_description = args["problem_description"]
            domain = args.get("domain")
            max_results = args.get("max_results", 15)
            
            # Find solution patterns
            results = self.semantic_search.discover_solution_patterns(
                problem_description=problem_description,
                domain=domain
            )
            
            if not results:
                return [TextContent(type="text", text="No solution patterns found for the given problem.")]
            
            # Sort by solution confidence
            results.sort(key=lambda x: x.metadata.get("solution_confidence", 0), reverse=True)
            results = results[:max_results]
            
            # Format results
            response = f"Found {len(results)} solution patterns for your problem:\n\n"
            response += f"**Problem**: {problem_description}\n"
            if domain:
                response += f"**Domain**: {domain}\n"
            response += "\n"
            
            for i, result in enumerate(results, 1):
                confidence = result.metadata.get("solution_confidence", 0)
                response += f"## Solution {i}: {result.task_id}\n"
                response += f"📊 **Confidence**: {confidence:.1%} | **Similarity**: {result.similarity_score:.3f}\n"
                response += f"🎯 {result.explanation}\n"
                
                # Add task metadata if available
                task_meta = result.metadata.get("task_metadata", {})
                if task_meta.get("status") == "completed":
                    response += f"✅ Completed successfully\n"
                
                response += "\n"
            
            return [TextContent(type="text", text=response)]
            
        except Exception as e:
            self.logger.error(f"Error finding solution patterns: {e}")
            return [TextContent(type="text", text=f"Error finding solution patterns: {str(e)}")]
    
    @trace_mcp_tool('train_task_embeddings')
    async def _handle_train_task_embeddings(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle training or retraining of task embeddings."""
        try:
            incremental = args.get("incremental", True)
            force_retrain = args.get("force_retrain", False)
            config_dict = args.get("config", {})
            
            # Create training config
            config = TrainingConfig(
                batch_size=config_dict.get("batch_size", 32),
                learning_rate=config_dict.get("learning_rate", 0.001),
                num_epochs=config_dict.get("num_epochs", 100),
                early_stopping_patience=config_dict.get("early_stopping_patience", 10)
            )
            
            # Check if retraining is needed
            if not force_retrain and not self.embedding_trainer.should_retrain():
                return [TextContent(type="text", text="Embeddings are up to date. Use force_retrain=True to retrain anyway.")]
            
            # Start training
            self.logger.info("Starting embedding training...")
            response = "🧠 **Training Task Embeddings**\n\n"
            response += f"Training mode: {'Incremental' if incremental else 'Full'}\n"
            response += f"Configuration: {config.to_dict()}\n\n"
            response += "Training in progress...\n"
            
            # Train embeddings
            result = self.embedding_trainer.train_embeddings(config, incremental)
            
            # Format training results
            if result.success:
                response += "\n✅ **Training Completed Successfully!**\n\n"
                response += f"📊 **Results**:\n"
                response += f"- Final Loss: {result.final_loss:.4f}\n"
                response += f"- Validation Accuracy: {result.validation_accuracy:.1%}\n"
                response += f"- Epochs Trained: {result.num_epochs_trained}\n"
                response += f"- Training Time: {result.training_time_seconds:.1f}s\n"
                response += f"- Model Size: {result.model_size_mb:.1f} MB\n"
                response += f"- Embeddings Generated: {result.embeddings_generated}\n"
            else:
                response += f"\n❌ **Training Failed**\n\n"
                response += f"Error: {result.error_message}\n"
                response += f"Training Time: {result.training_time_seconds:.1f}s\n"
            
            return [TextContent(type="text", text=response)]
            
        except Exception as e:
            self.logger.error(f"Error training embeddings: {e}")
            return [TextContent(type="text", text=f"Error training embeddings: {str(e)}")]
    
    @trace_mcp_tool('get_embeddings_stats')
    async def _handle_get_embeddings_stats(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle getting embeddings system statistics."""
        try:
            include_training_history = args.get("include_training_history", False)
            
            # Get comprehensive stats
            generator_info = self.embedding_generator.get_model_info()
            storage_stats = self.embedding_storage.get_storage_stats()
            search_stats = self.semantic_search.get_search_stats()
            training_stats = self.embedding_trainer.get_training_stats()
            
            # Format response
            response = "🧠 **ATLAS Knowledge Graph Embeddings Status**\n\n"
            
            # System availability
            response += "## System Status\n"
            response += f"- GraphSAGE Model: {'✅ Available' if generator_info['model_available'] else '❌ Fallback mode'}\n"
            response += f"- PyTorch: {'✅ Available' if generator_info['torch_available'] else '❌ Not installed'}\n"
            response += f"- Text Embedder: {'✅ Available' if generator_info['text_embedder_available'] else '❌ Not available'}\n"
            response += f"- Vector Search: {'✅ Available' if search_stats['embedding_storage_available'] else '❌ Not available'}\n\n"
            
            # Storage statistics
            response += "## Storage Statistics\n"
            response += f"- Embedding Dimension: {storage_stats['embedding_dimension']}\n"
            response += f"- Cache Size: {storage_stats['cache_size']}/{storage_stats['max_cache_size']}\n"
            response += f"- Vector Index: {storage_stats['index_type']}\n"
            response += f"- Total Vectors: {storage_stats['total_vectors']}\n"
            response += f"- Redis Available: {'✅' if storage_stats['redis_available'] else '❌'}\n"
            response += f"- FAISS Available: {'✅' if storage_stats['faiss_available'] else '❌'}\n\n"
            
            # Training statistics
            response += "## Training Status\n"
            response += f"- Model Available: {'✅' if training_stats['model_available'] else '❌'}\n"
            response += f"- Last Training: {training_stats['last_training_time'] or 'Never'}\n"
            response += f"- Training Sessions: {training_stats['training_sessions']}\n"
            
            if training_stats.get('latest_training_success'):
                response += f"- Latest Accuracy: {training_stats['latest_training_accuracy']:.1%}\n"
                response += f"- Latest Embeddings: {training_stats['latest_embeddings_generated']}\n"
                response += f"- Latest Duration: {training_stats['latest_training_time_seconds']:.1f}s\n"
            
            response += "\n"
            
            # Search capabilities
            response += "## Search Capabilities\n"
            response += f"- Supported Modes: {', '.join(search_stats['supported_search_modes'])}\n"
            response += f"- Search Cache: {search_stats['cache_size']}/{search_stats['max_cache_size']}\n\n"
            
            # Model information
            response += "## Model Configuration\n"
            response += f"- Model Dimension: {generator_info['model_dimension']}\n"
            response += f"- Cache Entries: {generator_info['cache_size']}\n"
            response += f"- Initialized: {generator_info['initialized']}\n\n"
            
            # Additional training history if requested
            if include_training_history and hasattr(self.embedding_trainer, 'training_history'):
                response += "## Training History\n"
                for i, result in enumerate(self.embedding_trainer.training_history[-5:], 1):
                    status = "✅" if result.success else "❌"
                    response += f"{i}. {status} Accuracy: {result.validation_accuracy:.1%}, "
                    response += f"Embeddings: {result.embeddings_generated}, "
                    response += f"Time: {result.training_time_seconds:.1f}s\n"
            
            return [TextContent(type="text", text=response)]
            
        except Exception as e:
            self.logger.error(f"Error getting embeddings stats: {e}")
            return [TextContent(type="text", text=f"Error getting embeddings stats: {str(e)}")]

    # OTLP Concurrency Pipeline Methods
    async def _batch_process_memory_operations(self, operations: List[Any], batch_id: str) -> Dict[str, Any]:
        """Batch process memory operations using OTLP concurrency pipeline."""
        
        start_time = time.time()
        results = {
            "batch_id": batch_id,
            "total_operations": len(operations),
            "successful_operations": 0,
            "failed_operations": 0,
            "processing_time_ms": 0,
            "operations_per_second": 0,
            "operation_results": []
        }
        
        try:
            # Group operations by type for optimal processing
            grouped_operations = {}
            for op in operations:
                op_type = op.get("operation_type", "unknown")
                if op_type not in grouped_operations:
                    grouped_operations[op_type] = []
                grouped_operations[op_type].append(op)
            
            # Process each group concurrently
            group_tasks = []
            for op_type, group_ops in grouped_operations.items():
                task = asyncio.create_task(self._process_operation_group(op_type, group_ops))
                group_tasks.append(task)
            
            # Wait for all groups to complete
            group_results = await asyncio.gather(*group_tasks, return_exceptions=True)
            
            # Aggregate results
            for group_result in group_results:
                if isinstance(group_result, Exception):
                    results["failed_operations"] += 1
                    results["operation_results"].append({
                        "status": "error",
                        "error": str(group_result)
                    })
                else:
                    results["successful_operations"] += group_result.get("successful", 0)
                    results["failed_operations"] += group_result.get("failed", 0)
                    results["operation_results"].extend(group_result.get("results", []))
            
            # Calculate performance metrics
            end_time = time.time()
            processing_time_ms = (end_time - start_time) * 1000
            results["processing_time_ms"] = processing_time_ms
            results["operations_per_second"] = len(operations) / (processing_time_ms / 1000) if processing_time_ms > 0 else 0
            
            self.logger.info(f"Batch {batch_id}: processed {len(operations)} operations in {processing_time_ms:.1f}ms ({results['operations_per_second']:.1f} ops/sec)")
            
        except Exception as e:
            self.logger.error(f"Batch processing failed for {batch_id}: {e}")
            results["failed_operations"] = len(operations)
            results["operation_results"] = [{"status": "error", "error": str(e)}]
        
        return results

    async def _process_operation_group(self, operation_type: str, operations: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Process a group of similar operations concurrently."""
        
        group_results = {
            "operation_type": operation_type,
            "successful": 0,
            "failed": 0,
            "results": []
        }
        
        try:
            if operation_type == "memory_entity_creation":
                # Batch create memory entities
                entities = []
                for op in operations:
                    entities.append({
                        "name": op["entity_name"],
                        "entityType": op["entity_type"],
                        "observations": op["observations"]
                    })
                
                # Process entities in parallel chunks to avoid overwhelming memory manager
                chunk_size = 10
                for i in range(0, len(entities), chunk_size):
                    chunk = entities[i:i + chunk_size]
                    try:
                        # This would call memory manager's batch creation if available
                        # For now, process individually but could be optimized
                        for entity in chunk:
                            # Simulate memory entity creation
                            group_results["results"].append({
                                "status": "success",
                                "entity_name": entity["name"],
                                "operation": "create_entity"
                            })
                            group_results["successful"] += 1
                    except Exception as e:
                        group_results["failed"] += len(chunk)
                        group_results["results"].append({
                            "status": "error",
                            "error": str(e),
                            "chunk_size": len(chunk)
                        })
            
            elif operation_type == "memory_relation_creation":
                # Batch create memory relations
                for op in operations:
                    try:
                        # Simulate memory relation creation
                        group_results["results"].append({
                            "status": "success",
                            "from_entity": op["from_entity"],
                            "to_entity": op["to_entity"],
                            "relation_type": op["relation_type"],
                            "operation": "create_relation"
                        })
                        group_results["successful"] += 1
                    except Exception as e:
                        group_results["failed"] += 1
                        group_results["results"].append({
                            "status": "error",
                            "error": str(e),
                            "operation": op
                        })
            
            elif operation_type == "memory_observation_update":
                # Batch update memory observations
                for op in operations:
                    try:
                        # Simulate memory observation update
                        group_results["results"].append({
                            "status": "success",
                            "entity_name": op["entity_name"],
                            "observations_added": len(op["observations"]),
                            "operation": "add_observations"
                        })
                        group_results["successful"] += 1
                    except Exception as e:
                        group_results["failed"] += 1
                        group_results["results"].append({
                            "status": "error",
                            "error": str(e),
                            "operation": op
                        })
            
            else:
                # Handle unknown operation types
                for op in operations:
                    group_results["results"].append({
                        "status": "skipped",
                        "reason": f"Unknown operation type: {operation_type}",
                        "operation": op
                    })
                    group_results["failed"] += 1
        
        except Exception as e:
            self.logger.error(f"Error processing operation group {operation_type}: {e}")
            group_results["failed"] = len(operations)
            group_results["results"] = [{"status": "error", "error": str(e)}]
        
        return group_results

    async def queue_memory_operations_for_batching(self, operations: List[Dict[str, Any]], priority: int = 5) -> List[str]:
        """Queue memory operations for batch processing using OTLP concurrency pipeline."""
        
        if not operations:
            return []
        
        # Start the concurrent exporter if not running
        if not self.concurrent_exporter.is_running:
            await self.concurrent_exporter.start()
        
        # Queue each operation for batching
        operation_ids = []
        for operation in operations:
            try:
                # Add operation metadata for batching
                operation_data = {
                    "operation_type": operation.get("type", "unknown"),
                    "data": operation,
                    "queued_at": datetime.now().isoformat()
                }
                
                # Queue the operation
                op_id = await self.concurrent_exporter.queue_item(
                    data=operation_data,
                    priority=priority,
                    metadata={"source": "atlas_memory_operations"}
                )
                operation_ids.append(op_id)
                
            except Exception as e:
                self.logger.error(f"Failed to queue memory operation: {e}")
                operation_ids.append(f"error:{str(e)}")
        
        self.logger.info(f"Queued {len(operations)} memory operations for batch processing")
        return operation_ids


async def main():
    """Main server entry point."""
    server = EnhancedAtlasCommandsServer()
    
    # Run the server
    from mcp.server.stdio import stdio_server
    
    async with stdio_server() as (read_stream, write_stream):
        await server.server.run(
            read_stream,
            write_stream,
            server.server.create_initialization_options()
        )


if __name__ == "__main__":
    asyncio.run(main())