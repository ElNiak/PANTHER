    def _suggest_memory_entity(self, name: str, entity_type: str, observations: List[str]) -> Dict[str, Any]:
        """Generate metadata for memory entity creation."""
        return {
            "mcp_tool": "mcp__memory__create_entities",
            "parameters": {
                "entities": [{
                    "name": name,
                    "entityType": entity_type,
                    "observations": observations
                }]
            },
            "description": f"Create memory entity '{name}' of type '{entity_type}' with {len(observations)} observations",
            "timestamp": datetime.now().isoformat()
        }
    
    def _suggest_memory_relation(self, from_entity: str, to_entity: str, relation_type: str) -> Dict[str, Any]:
        """Generate metadata for memory relation creation."""
        return {
            "mcp_tool": "mcp__memory__create_relations",
            "parameters": {
                "relations": [{
                    "from": from_entity,
                    "to": to_entity,
                    "relationType": relation_type
                }]
            },
            "description": f"Create relation '{relation_type}' from '{from_entity}' to '{to_entity}'",
            "timestamp": datetime.now().isoformat()
        }
    
    def _suggest_memory_observations(self, entity_name: str, observations: List[str]) -> Dict[str, Any]:
        """Generate metadata for adding memory observations."""
        return {
            "mcp_tool": "mcp__memory__add_observations",
            "parameters": {
                "observations": [{
                    "entityName": entity_name,
                    "contents": observations
                }]
            },
            "description": f"Add {len(observations)} observations to entity '{entity_name}'",
            "timestamp": datetime.now().isoformat()
        }
    
    def _generate_hierarchical_task_id(self, project_name: str, task_type: str, domain: str, task_name: str, parent_task_id: str = None) -> str:
        """Generate standardized hierarchical task ID."""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        
        if task_type == "task":
            # ATLAS_TASK_{domain}_{feature}_{timestamp}
            clean_name = task_name.lower().replace(' ', '-').replace('_', '-')
            return f"{project_name}_TASK_{domain}_{clean_name}_{timestamp}"
        elif task_type == "subtask":
            # ATLAS_SUBTASK_{parent_task_id}_{name}_{index}
            clean_name = task_name.lower().replace(' ', '-').replace('_', '-')
            # Count existing subtasks for this parent to get index
            index = self._count_existing_subtasks(project_name, parent_task_id) + 1
            return f"{project_name}_SUBTASK_{parent_task_id}_{clean_name}_{index:02d}"
        elif task_type == "subsubtask":
            # ATLAS_SUBSUBTASK_{parent_subtask_id}_{name}_{index}
            clean_name = task_name.lower().replace(' ', '-').replace('_', '-')
            # Count existing subsubtasks for this parent to get index
            index = self._count_existing_subsubtasks(project_name, parent_task_id) + 1
            return f"{project_name}_SUBSUBTASK_{parent_task_id}_{clean_name}_{index:02d}"
        else:
            raise ValueError(f"Unknown task_type: {task_type}")
    
    def _count_existing_subtasks(self, project_name: str, parent_task_id: str) -> int:
        """Count existing subtasks for a parent task."""
        project_tasks_dir = self.storage_manager.base_path / f"{project_name}_TASKS"
        if not project_tasks_dir.exists():
            return 0
            
        count = 0
        for task_dir in project_tasks_dir.iterdir():
            if task_dir.is_dir() and task_dir.name.startswith(f"{project_name}_SUBTASK_{parent_task_id}_"):
                count += 1
        return count
    
    def _count_existing_subsubtasks(self, project_name: str, parent_subtask_id: str) -> int:
        """Count existing subsubtasks for a parent subtask."""
        project_tasks_dir = self.storage_manager.base_path / f"{project_name}_TASKS"
        if not project_tasks_dir.exists():
            return 0
            
        count = 0
        for task_dir in project_tasks_dir.iterdir():
            if task_dir.is_dir() and task_dir.name.startswith(f"{project_name}_SUBSUBTASK_{parent_subtask_id}_"):
                count += 1
        return count
    
    async def _handle_create_hierarchical_task(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle hierarchical task creation with standardized naming and relationships."""
        
        # Generate standardized task ID
        task_id = self._generate_hierarchical_task_id(
            args["project_name"],
            args["task_type"], 
            args["domain"],
            args["task_name"],
            args.get("parent_task_id")
        )

        # Create enhanced metadata with hierarchical information
        metadata = self.storage_manager.create_task_metadata(
            args["project_name"],
            task_id,
            args["task_type"],
            args["description"],
            "hierarchical_create"
        )

        # Add hierarchical metadata
        task_root = self.storage_manager.get_task_root(args["project_name"], task_id)
        metadata_path = task_root / "task.json"

        # Load and enhance metadata
        with open(metadata_path, 'r') as f:
            full_metadata = json.load(f)

        # Add hierarchical fields
        full_metadata.update({
            "task_name": args["task_name"],
            "domain": args["domain"],
            "task_type": args["task_type"],
            "parent_task_id": args.get("parent_task_id"),
            "estimated_hours": args.get("estimated_hours", 0),
            "priority": args.get("priority", "medium"),
            "hierarchy_level": {"task": 1, "subtask": 2, "subsubtask": 3}[args["task_type"]],
            "children_tasks": [],
            "completion_percentage": 0.0,
            "hierarchical_metadata": {
                "naming_standard": "standardized_hierarchical",
                "created_by": "create_hierarchical_task",
                "supports_rollup": True,
                "context_inheritance": True
            }
        })

        # Save enhanced metadata
        with open(metadata_path, 'w') as f:
            json.dump(full_metadata, f, indent=2)

        # Update parent task if this is a subtask/subsubtask
        if args.get("parent_task_id"):
            await self._update_parent_children_list(
                args["project_name"], 
                args["parent_task_id"], 
                task_id
            )

        # Generate memory operation suggestions for hierarchical task
        memory_entity_name = f"{args['project_name']}_HIERARCHICAL_{task_id}"
        memory_observations = [
            f"Hierarchical {args['task_type']} created: {args['task_name']}",
            f"Domain: {args['domain']}",
            f"Description: {args['description']}",
            f"Parent: {args.get('parent_task_id', 'none')}",
            f"Priority: {args.get('priority', 'medium')}",
            f"Estimated hours: {args.get('estimated_hours', 0)}",
            f"Standardized ID: {task_id}",
            "Supports hierarchical operations and context inheritance",
        ]

        suggested_memory_operations = []

        # Suggest memory entity creation
        memory_creation_suggestion = self._suggest_memory_entity(
            memory_entity_name,
            "HierarchicalTask",
            memory_observations
        )
        suggested_memory_operations.append(memory_creation_suggestion)

        # Suggest linking to project
        project_entity_name = f"{args['project_name']}_Project"
        project_relation_suggestion = self._suggest_memory_relation(
            memory_entity_name,
            project_entity_name,
            "hierarchical_task_in_project"
        )
        suggested_memory_operations.append(project_relation_suggestion)

        # Suggest linking to parent if applicable
        if args.get("parent_task_id"):
            parent_memory_entity = f"{args['project_name']}_HIERARCHICAL_{args['parent_task_id']}"
            parent_relation_suggestion = self._suggest_memory_relation(
                memory_entity_name,
                parent_memory_entity,
                "child_task_of"
            )
            suggested_memory_operations.append(parent_relation_suggestion)

        result = {
            "success": True,
            "task_id": task_id,
            "task_name": args["task_name"],
            "task_type": args["task_type"],
            "domain": args["domain"],
            "parent_task_id": args.get("parent_task_id"),
            "standardized_naming": True,
            "hierarchical_support": True,
            "storage_path": str(task_root),
            "memory_entity": memory_entity_name,
            "suggested_memory_operations": suggested_memory_operations
        }

        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _update_parent_children_list(self, project_name: str, parent_task_id: str, child_task_id: str):
        """Update parent task's children list."""
        parent_root = self.storage_manager.get_task_root(project_name, parent_task_id)
        parent_metadata_path = parent_root / "task.json"
        
        if parent_metadata_path.exists():
            with open(parent_metadata_path, 'r') as f:
                parent_metadata = json.load(f)
            
            if "children_tasks" not in parent_metadata:
                parent_metadata["children_tasks"] = []
            
            if child_task_id not in parent_metadata["children_tasks"]:
                parent_metadata["children_tasks"].append(child_task_id)
            
            with open(parent_metadata_path, 'w') as f:
                json.dump(parent_metadata, f, indent=2)
    
    async def _handle_get_task_hierarchy(self, args: Dict[str, Any]) -> List[TextContent]:
        """Get complete task tree with all children."""
        
        def build_task_tree(task_id: str, current_depth: int, max_depth: int) -> Dict[str, Any]:
            """Recursively build task tree."""
            if current_depth > max_depth:
                return None
            
            task_root = self.storage_manager.get_task_root(args["project_name"], task_id)
            metadata_path = task_root / "task.json"
            
            if not metadata_path.exists():
                return None
            
            with open(metadata_path, 'r') as f:
                task_metadata = json.load(f)
            
            task_info = {
                "task_id": task_id,
                "task_name": task_metadata.get("task_name", task_id),
                "task_type": task_metadata.get("task_type", "unknown"),
                "domain": task_metadata.get("domain", "unknown"),
                "status": task_metadata.get("status", "unknown"),
                "completion_percentage": task_metadata.get("completion_percentage", 0.0),
                "priority": task_metadata.get("priority", "medium"),
                "estimated_hours": task_metadata.get("estimated_hours", 0),
                "children": []
            }
            
            # Add children if they exist and we're within depth limit
            if current_depth < max_depth and "children_tasks" in task_metadata:
                for child_id in task_metadata["children_tasks"]:
                    if args.get("include_completed", True) or self._get_task_status(args["project_name"], child_id) != "completed":
                        child_tree = build_task_tree(child_id, current_depth + 1, max_depth)
                        if child_tree:
                            task_info["children"].append(child_tree)
            
            return task_info
        
        # Build the complete hierarchy
        hierarchy = build_task_tree(
            args["root_task_id"], 
            1, 
            args.get("max_depth", 3)
        )
        
        if not hierarchy:
            result = {
                "success": False,
                "error": f"Task {args['root_task_id']} not found",
                "hierarchy": None
            }
        else:
            result = {
                "success": True,
                "root_task_id": args["root_task_id"],
                "project_name": args["project_name"],
                "max_depth": args.get("max_depth", 3),
                "include_completed": args.get("include_completed", True),
                "hierarchy": hierarchy
            }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    def _get_task_status(self, project_name: str, task_id: str) -> str:
        """Get task status from metadata."""
        task_root = self.storage_manager.get_task_root(project_name, task_id)
        metadata_path = task_root / "task.json"
        
        if not metadata_path.exists():
            return "unknown"
        
        with open(metadata_path, 'r') as f:
            metadata = json.load(f)
        
        return metadata.get("status", "unknown")
    
    async def _handle_update_hierarchical_status(self, args: Dict[str, Any]) -> List[TextContent]:
        """Update task status with automatic parent rollup logic."""
        
        # Update the task's own status
        metadata = self.storage_manager.update_task_status(
            args["project_name"],
            args["task_id"], 
            args["status"],
            None
        )
        
        # Update completion percentage if provided
        if "completion_percentage" in args:
            task_root = self.storage_manager.get_task_root(args["project_name"], args["task_id"])
            metadata_path = task_root / "task.json"
            
            with open(metadata_path, 'r') as f:
                task_metadata = json.load(f)
            
            task_metadata["completion_percentage"] = args["completion_percentage"]
            
            with open(metadata_path, 'w') as f:
                json.dump(task_metadata, f, indent=2)
        
        # Trigger parent rollup if requested
        rollup_results = []
        if args.get("update_parent", True):
            rollup_results = await self._calculate_and_update_parent_progress(
                args["project_name"],
                args["task_id"]
            )
        
        # Update memory entity
        memory_entity_name = f"{args['project_name']}_HIERARCHICAL_{args['task_id']}"
        status_observation = f"Status updated to: {args['status']}"
        if "completion_percentage" in args:
            status_observation += f" (Progress: {args['completion_percentage']*100:.1f}%)"
        status_observation += f" at {datetime.now().isoformat()}"
        
        if rollup_results:
            status_observation += f" (Triggered parent rollup for {len(rollup_results)} parents)"
        
        # Suggest memory operation for hierarchical status update
        memory_update_suggestion = self._suggest_memory_observations(
            memory_entity_name,
            [status_observation]
        )
        
        result = {
            "success": True,
            "task_id": args["task_id"],
            "new_status": args["status"],
            "completion_percentage": args.get("completion_percentage"),
            "parent_rollup_triggered": args.get("update_parent", True),
            "parent_updates": rollup_results,
            "suggested_memory_operations": [memory_update_suggestion]
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _calculate_and_update_parent_progress(self, project_name: str, task_id: str) -> List[Dict]:
        """Calculate and update parent task progress based on children."""
        
        # Find parent task
        task_root = self.storage_manager.get_task_root(project_name, task_id)
        metadata_path = task_root / "task.json"
        
        if not metadata_path.exists():
            return []
        
        with open(metadata_path, 'r') as f:
            task_metadata = json.load(f)
        
        parent_task_id = task_metadata.get("parent_task_id")
        if not parent_task_id:
            return []
        
        # Calculate parent progress based on all children
        parent_root = self.storage_manager.get_task_root(project_name, parent_task_id)
        parent_metadata_path = parent_root / "task.json"
        
        if not parent_metadata_path.exists():
            return []
        
        with open(parent_metadata_path, 'r') as f:
            parent_metadata = json.load(f)
        
        children_tasks = parent_metadata.get("children_tasks", [])
        if not children_tasks:
            return []
        
        # Calculate rollup progress
        total_progress = 0.0
        completed_children = 0
        
        for child_id in children_tasks:
            child_root = self.storage_manager.get_task_root(project_name, child_id)
            child_metadata_path = child_root / "task.json"
            
            if child_metadata_path.exists():
                with open(child_metadata_path, 'r') as f:
                    child_metadata = json.load(f)
                
                child_progress = child_metadata.get("completion_percentage", 0.0)
                total_progress += child_progress
                
                if child_metadata.get("status") == "completed":
                    completed_children += 1
        
        # Calculate average progress
        average_progress = total_progress / len(children_tasks) if children_tasks else 0.0
        
        # Update parent progress
        parent_metadata["completion_percentage"] = average_progress
        
        # Update parent status based on children
        if completed_children == len(children_tasks):
            parent_metadata["status"] = "completed"
        elif completed_children > 0:
            parent_metadata["status"] = "active"
        
        with open(parent_metadata_path, 'w') as f:
            json.dump(parent_metadata, f, indent=2)
        
        update_result = {
            "parent_task_id": parent_task_id,
            "children_count": len(children_tasks),
            "completed_children": completed_children,
            "calculated_progress": average_progress,
            "updated_status": parent_metadata["status"]
        }
        
        # Recursively update grandparent if needed
        grandparent_updates = await self._calculate_and_update_parent_progress(project_name, parent_task_id)
        
        return [update_result] + grandparent_updates
    
    # Complete implementations for remaining handlers
    async def _handle_create_task_dependency(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle task dependency creation with multiple dependency types."""
        
        from_task_id = args["from_task_id"]
        to_task_id = args["to_task_id"]
        dependency_type = args["dependency_type"]  # blocking, related, prerequisite
        project_name = args["project_name"]
        
        # Validate both tasks exist
        from_task_root = self.storage_manager.get_task_root(project_name, from_task_id)
        to_task_root = self.storage_manager.get_task_root(project_name, to_task_id)
        
        if not (from_task_root / "task.json").exists():
            result = {
                "success": False,
                "error": f"Source task not found: {from_task_id}",
                "dependency_created": False
            }
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
        
        if not (to_task_root / "task.json").exists():
            result = {
                "success": False,
                "error": f"Target task not found: {to_task_id}",
                "dependency_created": False
            }
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
        
        # Update both tasks with dependency information
        dependency_data = {
            "dependency_id": f"{from_task_id}_{dependency_type}_{to_task_id}",
            "dependency_type": dependency_type,
            "created_at": datetime.now().isoformat(),
            "description": args.get("description", "")
        }
        
        # Add dependency to source task
        from_metadata_path = from_task_root / "task.json"
        with open(from_metadata_path, 'r') as f:
            from_metadata = json.load(f)
        
        if "dependencies" not in from_metadata:
            from_metadata["dependencies"] = []
        
        dependency_entry = {
            "target_task": to_task_id,
            "type": dependency_type,
            "direction": "outgoing",
            **dependency_data
        }
        
        # Avoid duplicates
        existing = [d for d in from_metadata["dependencies"] 
                   if d.get("target_task") == to_task_id and d.get("type") == dependency_type]
        if not existing:
            from_metadata["dependencies"].append(dependency_entry)
        
        with open(from_metadata_path, 'w') as f:
            json.dump(from_metadata, f, indent=2)
        
        # Add reverse dependency to target task
        to_metadata_path = to_task_root / "task.json"
        with open(to_metadata_path, 'r') as f:
            to_metadata = json.load(f)
        
        if "dependencies" not in to_metadata:
            to_metadata["dependencies"] = []
        
        reverse_dependency_entry = {
            "target_task": from_task_id,
            "type": dependency_type,
            "direction": "incoming",
            **dependency_data
        }
        
        # Avoid duplicates
        existing = [d for d in to_metadata["dependencies"] 
                   if d.get("target_task") == from_task_id and d.get("type") == dependency_type]
        if not existing:
            to_metadata["dependencies"].append(reverse_dependency_entry)
        
        with open(to_metadata_path, 'w') as f:
            json.dump(to_metadata, f, indent=2)
        
        # Generate memory operation suggestions for dependency
        from_memory_entity = f"{project_name}_HIERARCHICAL_{from_task_id}"
        to_memory_entity = f"{project_name}_HIERARCHICAL_{to_task_id}"
        
        suggested_memory_operations = []
        
        # Suggest memory relation creation
        memory_relation_suggestion = self._suggest_memory_relation(
            from_memory_entity,
            to_memory_entity,
            f"task_dependency_{dependency_type}"
        )
        suggested_memory_operations.append(memory_relation_suggestion)
        
        # Suggest memory observations
        dependency_observation = f"Dependency created: {dependency_type} relationship with {to_task_id}"
        if args.get("description"):
            dependency_observation += f" - {args['description']}"
        
        memory_observation_suggestion = self._suggest_memory_observations(
            from_memory_entity,
            [dependency_observation]
        )
        suggested_memory_operations.append(memory_observation_suggestion)
        
        result = {
            "success": True,
            "dependency_id": dependency_data["dependency_id"],
            "from_task_id": from_task_id,
            "to_task_id": to_task_id,
            "dependency_type": dependency_type,
            "description": args.get("description", ""),
            "bidirectional_update": True,
            "suggested_memory_operations": suggested_memory_operations,
            "dependency_created": True
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_get_progress_rollup(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle progress rollup calculation across entire task hierarchy."""
        
        project_name = args["project_name"]
        root_task_id = args["root_task_id"]
        include_time_estimates = args.get("include_time_estimates", False)
        include_dependencies = args.get("include_dependencies", False)
        
        def calculate_hierarchical_progress(task_id: str, visited: set = None) -> Dict[str, Any]:
            """Recursively calculate progress for a task and all its children."""
            if visited is None:
                visited = set()
            
            if task_id in visited:
                return {"error": "circular_dependency", "task_id": task_id}
            
            visited.add(task_id)
            
            task_root = self.storage_manager.get_task_root(project_name, task_id)
            metadata_path = task_root / "task.json"
            
            if not metadata_path.exists():
                return {"error": "task_not_found", "task_id": task_id}
            
            with open(metadata_path, 'r') as f:
                task_metadata = json.load(f)
            
            # Calculate basic task progress
            task_progress = {
                "task_id": task_id,
                "task_name": task_metadata.get("task_name", task_id),
                "task_type": task_metadata.get("task_type", "unknown"),
                "status": task_metadata.get("status", "unknown"),
                "completion_percentage": task_metadata.get("completion_percentage", 0.0),
                "priority": task_metadata.get("priority", "medium"),
                "children_count": len(task_metadata.get("children_tasks", [])),
                "children_progress": []
            }
            
            # Add time estimates if requested
            if include_time_estimates:
                task_progress.update({
                    "estimated_hours": task_metadata.get("estimated_hours", 0),
                    "actual_hours": task_metadata.get("actual_hours", 0),
                    "hours_variance": task_metadata.get("actual_hours", 0) - task_metadata.get("estimated_hours", 0)
                })
            
            # Add dependency analysis if requested
            if include_dependencies:
                dependencies = task_metadata.get("dependencies", [])
                blocking_dependencies = [d for d in dependencies if d.get("type") == "blocking" and d.get("direction") == "incoming"]
                
                task_progress.update({
                    "total_dependencies": len(dependencies),
                    "blocking_dependencies": len(blocking_dependencies),
                    "is_blocked": len(blocking_dependencies) > 0 and task_metadata.get("status") not in ["completed", "archived"]
                })
            
            # Process children recursively
            children_tasks = task_metadata.get("children_tasks", [])
            if children_tasks:
                children_progress_sum = 0.0
                children_completed = 0
                children_blocked = 0
                total_estimated_hours = 0
                total_actual_hours = 0
                
                for child_id in children_tasks:
                    child_progress = calculate_hierarchical_progress(child_id, visited.copy())
                    task_progress["children_progress"].append(child_progress)
                    
                    if "error" not in child_progress:
                        children_progress_sum += child_progress["completion_percentage"]
                        
                        if child_progress["status"] == "completed":
                            children_completed += 1
                        
                        if include_dependencies and child_progress.get("is_blocked", False):
                            children_blocked += 1
                        
                        if include_time_estimates:
                            total_estimated_hours += child_progress.get("estimated_hours", 0)
                            total_actual_hours += child_progress.get("actual_hours", 0)
                
                # Calculate rollup metrics
                if children_tasks:
                    task_progress.update({
                        "children_average_progress": children_progress_sum / len(children_tasks),
                        "children_completed": children_completed,
                        "children_completion_rate": children_completed / len(children_tasks),
                        "overall_progress": (task_progress["completion_percentage"] + (children_progress_sum / len(children_tasks))) / 2
                    })
                    
                    if include_dependencies:
                        task_progress.update({
                            "children_blocked": children_blocked,
                            "children_blocked_rate": children_blocked / len(children_tasks)
                        })
                    
                    if include_time_estimates:
                        task_progress.update({
                            "children_estimated_hours": total_estimated_hours,
                            "children_actual_hours": total_actual_hours,
                            "children_hours_variance": total_actual_hours - total_estimated_hours,
                            "total_estimated_hours": task_progress.get("estimated_hours", 0) + total_estimated_hours,
                            "total_actual_hours": task_progress.get("actual_hours", 0) + total_actual_hours
                        })
            else:
                # Leaf task - no children
                task_progress["overall_progress"] = task_progress["completion_percentage"]
            
            return task_progress
        
        # Calculate complete hierarchy progress
        progress_tree = calculate_hierarchical_progress(root_task_id)
        
        if "error" in progress_tree:
            result = {
                "success": False,
                "error": progress_tree["error"],
                "root_task_id": root_task_id,
                "progress_rollup": None
            }
        else:
            # Calculate summary statistics
            def collect_task_stats(node: Dict, stats: Dict):
                """Recursively collect statistics from progress tree."""
                if "error" in node:
                    stats["errors"] += 1
                    return
                
                stats["total_tasks"] += 1
                stats["total_progress"] += node["completion_percentage"]
                
                if node["status"] == "completed":
                    stats["completed_tasks"] += 1
                elif node["status"] == "active":
                    stats["active_tasks"] += 1
                elif node["status"] == "blocked":
                    stats["blocked_tasks"] += 1
                
                if include_time_estimates:
                    stats["total_estimated_hours"] += node.get("estimated_hours", 0)
                    stats["total_actual_hours"] += node.get("actual_hours", 0)
                
                if include_dependencies and node.get("is_blocked", False):
                    stats["total_blocked_tasks"] += 1
                
                # Process children
                for child in node.get("children_progress", []):
                    collect_task_stats(child, stats)
            
            stats = {
                "total_tasks": 0,
                "completed_tasks": 0,
                "active_tasks": 0,
                "blocked_tasks": 0,
                "total_progress": 0.0,
                "errors": 0
            }
            
            if include_time_estimates:
                stats.update({
                    "total_estimated_hours": 0,
                    "total_actual_hours": 0,
                    "total_hours_variance": 0
                })
            
            if include_dependencies:
                stats["total_blocked_tasks"] = 0
            
            collect_task_stats(progress_tree, stats)
            
            # Calculate derived metrics
            if stats["total_tasks"] > 0:
                stats["average_progress"] = stats["total_progress"] / stats["total_tasks"]
                stats["completion_rate"] = stats["completed_tasks"] / stats["total_tasks"]
                
                if include_time_estimates:
                    stats["total_hours_variance"] = stats["total_actual_hours"] - stats["total_estimated_hours"]
                    if stats["total_estimated_hours"] > 0:
                        stats["hours_accuracy"] = 1 - abs(stats["total_hours_variance"]) / stats["total_estimated_hours"]
                
                if include_dependencies:
                    stats["blocked_task_rate"] = stats["total_blocked_tasks"] / stats["total_tasks"]
            
            result = {
                "success": True,
                "root_task_id": root_task_id,
                "project_name": project_name,
                "calculated_at": datetime.now().isoformat(),
                "include_time_estimates": include_time_estimates,
                "include_dependencies": include_dependencies,
                "summary_statistics": stats,
                "progress_rollup": progress_tree
            }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_query_hierarchical_context(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle hierarchical context querying with memory context inheritance."""
        
        project_name = args["project_name"]
        task_id = args["task_id"]
        include_children = args.get("include_children", True)
        include_ancestors = args.get("include_ancestors", True)
        context_depth = args.get("context_depth", 2)  # How many levels up/down to include
        
        def get_task_memory_context(task_id: str) -> Dict[str, Any]:
            """Get memory context for a specific task."""
            task_root = self.storage_manager.get_task_root(project_name, task_id)
            metadata_path = task_root / "task.json"
            
            if not metadata_path.exists():
                return {"error": "task_not_found", "task_id": task_id}
            
            with open(metadata_path, 'r') as f:
                task_metadata = json.load(f)
            
            # Construct memory entity name
            memory_entity_name = f"{project_name}_HIERARCHICAL_{task_id}"
            
            # Simulate memory graph query (in production, this would call the MCP memory server)
            memory_context = {
                "task_id": task_id,
                "task_name": task_metadata.get("task_name", task_id),
                "task_type": task_metadata.get("task_type", "unknown"),
                "domain": task_metadata.get("domain", "unknown"),
                "status": task_metadata.get("status", "unknown"),
                "priority": task_metadata.get("priority", "medium"),
                "memory_entity_name": memory_entity_name,
                "description": task_metadata.get("description", ""),
                "created_at": task_metadata.get("created_at"),
                "current_phase": task_metadata.get("current_phase", "unknown"),
                "parent_task_id": task_metadata.get("parent_task_id"),
                "children_tasks": task_metadata.get("children_tasks", []),
                "completion_percentage": task_metadata.get("completion_percentage", 0.0),
                "estimated_hours": task_metadata.get("estimated_hours", 0),
                "dependencies": task_metadata.get("dependencies", []),
                "artifacts": task_metadata.get("artifacts", {}),
                
                # Memory-specific context
                "memory_observations": [
                    f"Hierarchical {task_metadata.get('task_type', 'task')} in domain: {task_metadata.get('domain', 'unknown')}",
                    f"Current status: {task_metadata.get('status', 'unknown')}",
                    f"Progress: {task_metadata.get('completion_percentage', 0.0)*100:.1f}%",
                    f"Created: {task_metadata.get('created_at', 'unknown')}",
                    f"Last updated: {task_metadata.get('timestamps', {}).get('last_updated', 'unknown')}"
                ],
                
                "memory_relations": [],
                "inherited_context": {}
            }
            
            return memory_context
        
        def collect_ancestral_context(task_id: str, current_depth: int = 0) -> List[Dict]:
            """Collect context from parent tasks (inherited context)."""
            if current_depth >= context_depth:
                return []
            
            task_context = get_task_memory_context(task_id)
            if "error" in task_context:
                return []
            
            ancestral_contexts = [task_context]
            
            parent_task_id = task_context.get("parent_task_id")
            if parent_task_id:
                parent_contexts = collect_ancestral_context(parent_task_id, current_depth + 1)
                ancestral_contexts.extend(parent_contexts)
            
            return ancestral_contexts
        
        def collect_descendant_context(task_id: str, current_depth: int = 0) -> List[Dict]:
            """Collect context from child tasks."""
            if current_depth >= context_depth:
                return []
            
            task_context = get_task_memory_context(task_id)
            if "error" in task_context:
                return []
            
            descendant_contexts = [task_context]
            
            children_tasks = task_context.get("children_tasks", [])
            for child_id in children_tasks:
                child_contexts = collect_descendant_context(child_id, current_depth + 1)
                descendant_contexts.extend(child_contexts)
            
            return descendant_contexts
        
        # Get primary task context
        primary_context = get_task_memory_context(task_id)
        
        if "error" in primary_context:
            result = {
                "success": False,
                "error": primary_context["error"],
                "task_id": task_id,
                "hierarchical_context": None
            }
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
        
        # Collect hierarchical context
        hierarchical_context = {
            "primary_task": primary_context,
            "ancestral_context": [],
            "descendant_context": [],
            "inherited_properties": {},
            "context_summary": {}
        }
        
        # Collect ancestral context (parents, grandparents, etc.)
        if include_ancestors and primary_context.get("parent_task_id"):
            ancestral_contexts = collect_ancestral_context(primary_context["parent_task_id"])
            hierarchical_context["ancestral_context"] = ancestral_contexts
            
            # Calculate inherited properties
            inherited_domain = None
            inherited_priority = None
            inherited_patterns = []
            
            for ancestor in reversed(ancestral_contexts):  # Start from root
                if not inherited_domain and ancestor.get("domain") != "unknown":
                    inherited_domain = ancestor["domain"]
                if not inherited_priority and ancestor.get("priority") != "medium":
                    inherited_priority = ancestor["priority"]
                
                # Collect patterns from ancestor artifacts
                ancestor_artifacts = ancestor.get("artifacts", {})
                for artifact_type, artifacts in ancestor_artifacts.items():
                    if artifact_type in ["analysis", "design", "patterns"]:
                        inherited_patterns.extend([f"{artifact_type}:{a.get('filename', 'unknown')}" for a in artifacts])
            
            hierarchical_context["inherited_properties"] = {
                "domain": inherited_domain or primary_context.get("domain"),
                "priority": inherited_priority or primary_context.get("priority"),
                "patterns": inherited_patterns,
                "inheritance_chain_length": len(ancestral_contexts)
            }
        
        # Collect descendant context (children, grandchildren, etc.)
        if include_children and primary_context.get("children_tasks"):
            descendant_contexts = []
            for child_id in primary_context["children_tasks"]:
                child_contexts = collect_descendant_context(child_id)
                descendant_contexts.extend(child_contexts)
            
            hierarchical_context["descendant_context"] = descendant_contexts
        
        # Calculate context summary
        total_tasks = 1  # Primary task
        total_tasks += len(hierarchical_context["ancestral_context"])
        total_tasks += len(hierarchical_context["descendant_context"])
        
        completed_tasks = 0
        active_tasks = 0
        total_estimated_hours = 0
        total_artifacts = 0
        unique_domains = set()
        dependency_count = 0
        
        # Analyze all tasks in hierarchy
        all_tasks = [primary_context] + hierarchical_context["ancestral_context"] + hierarchical_context["descendant_context"]
        
        for task_context in all_tasks:
            if "error" not in task_context:
                if task_context["status"] == "completed":
                    completed_tasks += 1
                elif task_context["status"] == "active":
                    active_tasks += 1
                
                total_estimated_hours += task_context.get("estimated_hours", 0)
                total_artifacts += sum(len(artifacts) for artifacts in task_context.get("artifacts", {}).values())
                unique_domains.add(task_context.get("domain", "unknown"))
                dependency_count += len(task_context.get("dependencies", []))
        
        hierarchical_context["context_summary"] = {
            "total_tasks_in_hierarchy": total_tasks,
            "completed_tasks": completed_tasks,
            "active_tasks": active_tasks,
            "completion_rate": completed_tasks / total_tasks if total_tasks > 0 else 0,
            "total_estimated_hours": total_estimated_hours,
            "total_artifacts": total_artifacts,
            "unique_domains": list(unique_domains),
            "total_dependencies": dependency_count,
            "hierarchy_depth": max(len(hierarchical_context["ancestral_context"]), 
                                 max([len(collect_ancestral_context(task_id)) for task_id in primary_context.get("children_tasks", [])], default=0)),
            "context_collection_timestamp": datetime.now().isoformat()
        }
        
        # Simulate memory relation creation for context linkage
        memory_relations = []
        
        # Link to ancestors
        for ancestor in hierarchical_context["ancestral_context"]:
            if "error" not in ancestor:
                memory_relations.append({
                    "from": primary_context["memory_entity_name"],
                    "to": ancestor["memory_entity_name"],
                    "relation_type": "inherits_context_from",
                    "simulated": True
                })
        
        # Link to descendants  
        for descendant in hierarchical_context["descendant_context"]:
            if "error" not in descendant:
                memory_relations.append({
                    "from": primary_context["memory_entity_name"],
                    "to": descendant["memory_entity_name"],
                    "relation_type": "provides_context_to",
                    "simulated": True
                })
        
        result = {
            "success": True,
            "task_id": task_id,
            "project_name": project_name,
            "query_parameters": {
                "include_children": include_children,
                "include_ancestors": include_ancestors,
                "context_depth": context_depth
            },
            "hierarchical_context": hierarchical_context,
            "memory_relations": memory_relations,
            "context_inheritance_enabled": True
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    # Convention validation tool handlers
    
    async def _handle_validate_file_operation(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle file operation validation."""
        from .convention.file_operation_validator import FileOperationValidationRequest, FileOperationType
        
        # Create request
        request = FileOperationValidationRequest(
            operation=FileOperationType(args["operation"]),
            file_path=args["file_path"],
            project_root=args.get("project_root"),
            context=args.get("context")
        )
        
        # Validate
        response = self.file_operation_validator.validate_file_operation(request)
        
        # Format response
        result = {
            "validation_result": response.validation_result.value,
            "should_proceed": response.should_proceed,
            "reasoning": response.reasoning,
            "suggestions": response.suggestions,
            "affected_files": response.affected_files[:5]  # Limit for readability
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_validate_naming_convention(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle naming convention validation."""
        from .convention.naming_convention_enforcer import NamingValidationRequest, NamingType
        
        # Create request
        request = NamingValidationRequest(
            name=args["name"],
            type=NamingType(args["type"]),
            context=args.get("context")
        )
        
        # Validate
        response = self.naming_convention_enforcer.validate_naming_convention(request)
        
        # Format response
        result = {
            "is_valid": response.is_valid,
            "score": response.score,
            "violations": [
                {
                    "rule": v.rule,
                    "description": v.description,
                    "severity": v.severity,
                    "suggestion": v.suggestion
                }
                for v in response.violations
            ],
            "suggested_alternatives": response.suggested_alternatives
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_validate_code_standards(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle code standards validation."""
        from .convention.code_standards_validator import CodeStandardsValidationRequest
        
        # Create request
        request = CodeStandardsValidationRequest(
            file_path=args["file_path"],
            content=args.get("content"),
            standards_config=args.get("standards_config")
        )
        
        # Validate
        response = self.code_standards_validator.validate_code_standards(request)
        
        # Format response
        result = {
            "compliance_score": response.compliance_score,
            "summary": response.summary,
            "violations": [
                {
                    "type": v.type.value,
                    "severity": v.severity.value,
                    "line_number": v.line_number,
                    "message": v.message,
                    "suggestion": v.suggestion,
                    "auto_fixable": v.auto_fixable
                }
                for v in response.violations[:10]  # Limit for readability
            ],
            "auto_fix_suggestions": response.auto_fix_suggestions[:5]  # Limit for readability
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_enforce_git_protocol(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle Git protocol automation."""
        from .convention.git_protocol_automator import GitProtocolRequest, GitAction
        
        # Create request
        request = GitProtocolRequest(
            action=GitAction(args["action"]),
            files=args.get("files"),
            review_context=args.get("review_context"),
            commit_message=args.get("commit_message"),
            auto_notify=args.get("auto_notify", True)
        )
        
        # Execute
        response = self.git_protocol_automator.execute_git_protocol(request)
        
        # Format response
        result = {
            "protocol_status": response.protocol_status.value,
            "next_actions": response.next_actions,
            "notifications_sent": response.notifications_sent,
            "git_output": response.git_output,
            "warnings": response.warnings,
            "errors": response.errors
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_orchestrate_intelligent_tasks(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle intelligent task orchestration with auto-decomposition and dependency detection."""
        
        task_context = args["task_context"]
        orchestration_options = args.get("orchestration_options", {})
        project_name = args.get("project_name", "ATLAS")
        
        # Initialize orchestration result
        orchestration_result = {
            "task_context": task_context,
            "orchestration_options": orchestration_options,
            "suggested_tasks": [],
            "detected_dependencies": [],
            "recommended_workflow": None,
            "complexity_analysis": {},
            "execution_plan": {}
        }
        
        # Analyze task complexity and scope
        complexity = task_context["complexity"]
        description = task_context["description"]
        domain = task_context["domain"]
        target = task_context.get("target", "unknown")
        
        # Complexity analysis
        complexity_analysis = {
            "complexity_level": complexity,
            "estimated_subtasks": {"simple": 1, "moderate": 3, "complex": 6}.get(complexity, 3),
            "estimated_hours": {"simple": 2, "moderate": 8, "complex": 20}.get(complexity, 8),
            "risk_level": {"simple": "low", "moderate": "medium", "complex": "high"}.get(complexity, "medium"),
            "requires_decomposition": complexity in ["moderate", "complex"]
        }
        
        orchestration_result["complexity_analysis"] = complexity_analysis
        
        # Auto-decomposition if requested and needed
        if orchestration_options.get("auto_decompose", True) and complexity_analysis["requires_decomposition"]:
            
            # Pattern-based task decomposition
            if "automation" in domain.lower():
                suggested_tasks = [
                    {
                        "task_name": f"{domain}-infrastructure",
                        "description": f"Set up core infrastructure for {description}",
                        "task_type": "subtask",
                        "priority": "high",
                        "estimated_hours": 2,
                        "dependencies": []
                    },
                    {
                        "task_name": f"{domain}-implementation",
                        "description": f"Implement main functionality for {description}",
                        "task_type": "subtask", 
                        "priority": "high",
                        "estimated_hours": 4,
                        "dependencies": [f"{domain}-infrastructure"]
                    },
                    {
                        "task_name": f"{domain}-testing",
                        "description": f"Test and validate {description}",
                        "task_type": "subtask",
                        "priority": "medium",
                        "estimated_hours": 2,
                        "dependencies": [f"{domain}-implementation"]
                    }
                ]
            elif "development" in domain.lower() or "coding" in domain.lower():
                suggested_tasks = [
                    {
                        "task_name": f"{domain}-analysis",
                        "description": f"Analyze requirements and design for {description}",
                        "task_type": "subtask",
                        "priority": "high",
                        "estimated_hours": 1,
                        "dependencies": []
                    },
                    {
                        "task_name": f"{domain}-implementation",
                        "description": f"Implement core functionality for {description}",
                        "task_type": "subtask",
                        "priority": "high", 
                        "estimated_hours": 4,
                        "dependencies": [f"{domain}-analysis"]
                    },
                    {
                        "task_name": f"{domain}-quality-assurance",
                        "description": f"Quality checks and testing for {description}",
                        "task_type": "subtask",
                        "priority": "medium",
                        "estimated_hours": 2,
                        "dependencies": [f"{domain}-implementation"]
                    }
                ]
            else:
                # Generic decomposition
                suggested_tasks = [
                    {
                        "task_name": f"{domain}-planning",
                        "description": f"Plan and design approach for {description}",
                        "task_type": "subtask",
                        "priority": "high",
                        "estimated_hours": 1,
                        "dependencies": []
                    },
                    {
                        "task_name": f"{domain}-execution", 
                        "description": f"Execute main work for {description}",
                        "task_type": "subtask",
                        "priority": "high",
                        "estimated_hours": complexity_analysis["estimated_hours"] - 2,
                        "dependencies": [f"{domain}-planning"]
                    },
                    {
                        "task_name": f"{domain}-validation",
                        "description": f"Validate and finalize {description}",
                        "task_type": "subtask",
                        "priority": "medium",
                        "estimated_hours": 1,
                        "dependencies": [f"{domain}-execution"]
                    }
                ]
            
            orchestration_result["suggested_tasks"] = suggested_tasks
        
        # Dependency detection if requested
        if orchestration_options.get("detect_dependencies", True):
            
            # Simulate dependency detection based on domain and complexity
            detected_dependencies = []
            
            if domain.lower() in ["automation", "workflow"]:
                detected_dependencies.extend([
                    {
                        "type": "prerequisite",
                        "description": "Foundation systems must be operational",
                        "estimated_impact": "high"
                    },
                    {
                        "type": "resource",
                        "description": "MCP server tools need to be available",
                        "estimated_impact": "medium"
                    }
                ])
            
            if complexity == "complex":
                detected_dependencies.append({
                    "type": "skill",
                    "description": "Advanced system architecture knowledge required",
                    "estimated_impact": "medium"
                })
            
            if "integration" in description.lower():
                detected_dependencies.append({
                    "type": "external",
                    "description": "External system compatibility verification needed",
                    "estimated_impact": "high"
                })
            
            orchestration_result["detected_dependencies"] = detected_dependencies
        
        # Workflow recommendation if requested
        if orchestration_options.get("suggest_workflow", True):
            
            if complexity == "simple":
                recommended_workflow = "quick-fix"
            elif complexity == "moderate":
                recommended_workflow = "explore-plan-code-commit"
            else:  # complex
                recommended_workflow = "analyze-plan-decompose-code-run-analyse_results"
            
            orchestration_result["recommended_workflow"] = {
                "pattern": recommended_workflow,
                "reasoning": f"Selected based on {complexity} complexity level",
                "estimated_duration": complexity_analysis["estimated_hours"],
                "phases": {
                    "quick-fix": ["analyze", "implement", "test"],
                    "explore-plan-code-commit": ["explore", "plan", "code", "commit"],
                    "analyze-plan-decompose-code-run-analyse_results": ["analyze", "plan", "decompose", "code", "run", "analyze_results"]
                }.get(recommended_workflow, ["plan", "execute", "verify"])
            }
        
        # Create execution plan
        execution_plan = {
            "total_estimated_hours": complexity_analysis["estimated_hours"],
            "recommended_approach": "systematic" if complexity != "simple" else "direct",
            "parallel_execution_possible": len(orchestration_result.get("suggested_tasks", [])) > 1,
            "checkpoints_recommended": complexity != "simple",
            "quality_gates": [
                "requirements_clear",
                "implementation_complete", 
                "tests_passing",
                "documentation_updated"
            ] if complexity != "simple" else ["implementation_complete"]
        }
        
        orchestration_result["execution_plan"] = execution_plan
        
        # Create subtasks if requested
        if orchestration_options.get("create_subtasks", False) and orchestration_result["suggested_tasks"]:
            
            created_tasks = []
            
            # Create a parent task first
            parent_task_id = self._generate_hierarchical_task_id(
                project_name, "task", domain, f"orchestrated-{target}", None
            )
            
            parent_metadata = self.storage_manager.create_task_metadata(
                project_name,
                parent_task_id, 
                "task",
                description,
                "intelligent_orchestration"
            )
            
            created_tasks.append({
                "task_id": parent_task_id,
                "task_type": "task",
                "created": True
            })
            
            # Create subtasks
            for suggested_task in orchestration_result["suggested_tasks"]:
                subtask_id = self._generate_hierarchical_task_id(
                    project_name, "subtask", domain, suggested_task["task_name"], parent_task_id
                )
                
                subtask_metadata = self.storage_manager.create_task_metadata(
                    project_name,
                    subtask_id,
                    "subtask", 
                    suggested_task["description"],
                    "intelligent_orchestration"
                )
                
                created_tasks.append({
                    "task_id": subtask_id,
                    "task_type": "subtask",
                    "parent_task_id": parent_task_id,
                    "created": True
                })
                
                # Update suggested task with actual ID
                suggested_task["task_id"] = subtask_id
            
            orchestration_result["created_tasks"] = created_tasks
        
        # Suggest memory entity for orchestration
        memory_entity_name = f"{project_name}_ORCHESTRATION_{domain}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        memory_observations = [
            f"Intelligent task orchestration for: {description}",
            f"Domain: {domain}, Complexity: {complexity}",
            f"Auto-decomposed into {len(orchestration_result.get('suggested_tasks', []))} subtasks",
            f"Detected {len(orchestration_result.get('detected_dependencies', []))} dependencies",
            f"Recommended workflow: {orchestration_result.get('recommended_workflow', {}).get('pattern', 'none')}",
            f"Estimated total hours: {complexity_analysis['estimated_hours']}",
            f"Risk level: {complexity_analysis['risk_level']}"
        ]
        
        memory_creation_suggestion = self._suggest_memory_entity(
            memory_entity_name,
            "TaskOrchestration",
            memory_observations
        )
        
        # Final result
        result = {
            "success": True,
            "orchestration_completed": True,
            "task_context": task_context,
            "orchestration_options": orchestration_options,
            "orchestration_result": orchestration_result,
            "suggested_memory_operations": [memory_creation_suggestion],
            "orchestration_timestamp": datetime.now().isoformat()
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]

    async def _handle_adaptive_command_selection(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle adaptive command selection requests."""
        try:
            # Extract parameters
            task_description = args["task_description"]
            domain = args["domain"]
            current_phase = args.get("current_phase", "planning")
            previous_commands = args.get("previous_commands", [])
            project_state = args.get("project_state", {})
            limit = args.get("limit", 5)
            include_alternatives = args.get("include_alternatives", True)
            learn_from_outcome = args.get("learn_from_outcome")
            
            # Handle learning from outcome first if provided
            if learn_from_outcome:
                context = self.adaptive_command_selector.analyze_context(
                    task_description, domain, current_phase, previous_commands, project_state
                )
                self.adaptive_command_selector.learn_from_outcome(
                    commands_used=learn_from_outcome["commands_used"],
                    context=context,
                    outcome=learn_from_outcome["outcome"],
                    execution_time=learn_from_outcome.get("execution_time"),
                    notes=learn_from_outcome.get("notes")
                )
            
            # Analyze current context
            context = self.adaptive_command_selector.analyze_context(
                task_description, domain, current_phase, previous_commands, project_state
            )
            
            # Get command recommendations
            recommendations = self.adaptive_command_selector.recommend_commands(
                context, limit, include_alternatives
            )
            
            # Generate confidence explanations for top recommendations
            explanations = []
            for rec in recommendations[:3]:  # Explain top 3
                explanation = self.adaptive_command_selector.get_confidence_explanation(rec)
                explanations.append(explanation)
            
            # Format results
            result = {
                "success": True,
                "context_analysis": {
                    "domain": context.domain,
                    "complexity": context.complexity,
                    "current_phase": context.current_phase,
                    "success_indicators": context.success_indicators,
                    "blocking_issues": context.blocking_issues,
                    "available_resources": context.available_resources
                },
                "recommendations": [
                    {
                        "command": rec.command,
                        "confidence": rec.confidence,
                        "reasoning": rec.reasoning,
                        "prerequisites": rec.prerequisites,
                        "expected_outcome": rec.expected_outcome,
                        "risk_level": rec.risk_level,
                        "estimated_time": rec.estimated_time
                    }
                    for rec in recommendations
                ],
                "confidence_explanations": explanations,
                "recommendation_count": len(recommendations),
                "learning_applied": learn_from_outcome is not None
            }
            
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
            
        except Exception as e:
            error_result = {
                "success": False,
                "error": str(e),
                "error_type": type(e).__name__,
                "recommendations": [],
                "context_analysis": {}
            }
            return [TextContent(type="text", text=json.dumps(error_result, indent=2))]

    async def _handle_analyze_workflow_patterns(self, args: Dict[str, Any]) -> List[TextContent]:
        """Analyze workflow patterns using memory-optimized search instead of full workflow analysis."""
        
        # Extract parameters
        workflow_data = args.get("workflow_data", [])
        analysis_type = args.get("analysis_type", "all")
        project_context = args.get("project_context", {})
        learning_mode = args.get("learning_mode", True)
        
        project_name = project_context.get("project_name", "ATLAS")
        domain = project_context.get("domain", "general")
        complexity_level = project_context.get("complexity_level", "moderate")
        
        # Use memory-optimized workflow search for token efficiency
        try:
            analysis_results = await self.memory_search_optimizer.optimized_workflow_search(
                query_patterns=workflow_data,
                project_name=project_name,
                domain=domain,
                analysis_type=analysis_type,
                enable_learning=learning_mode
            )
            
            # Add confidence scores using memory patterns
            confidence_score = analysis_results.get("confidence_score", 0.85)
            analysis_results["confidence_scores"] = {
                "overall": confidence_score,
                "pattern_matching": min(confidence_score + 0.1, 1.0),
                "memory_retrieval": confidence_score
            }
            
            # Calculate token savings
            token_savings = analysis_results.get("token_savings", {})
            traditional_tokens = token_savings.get("estimated_traditional_tokens", 1000)
            memory_tokens = token_savings.get("memory_search_tokens", 200)
            efficiency_gain = ((traditional_tokens - memory_tokens) / traditional_tokens * 100) if traditional_tokens > 0 else 0
            
            # Create memory integration suggestion if learning enabled
            memory_creation_suggestion = None
            if learning_mode and analysis_results.get("should_update_memory", False):
                memory_entity_name = f"WorkflowAnalysis_{project_name}_{domain}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                memory_creation_suggestion = self._suggest_memory_entity(
                    memory_entity_name,
                    "WorkflowAnalysis",
                    [
                        f"Memory-optimized workflow analysis for {project_name} in {domain} domain",
                        f"Processed {len(workflow_data)} workflow patterns using memory search",
                        f"Analysis type: {analysis_type}",
                        f"Confidence level: {confidence_score:.2f}",
                        f"Token efficiency gain: {efficiency_gain:.1f}%",
                        f"Memory patterns found: {len(analysis_results.get('memory_patterns', []))}",
                        f"Optimization suggestions: {len(analysis_results.get('optimization_suggestions', []))}"
                    ]
                )
            
            # Create final result with token efficiency metrics
            result = {
                "success": True,
                "analysis_type": analysis_type,
                "project_context": project_context,
                "workflow_count": len(workflow_data),
                "analysis_results": analysis_results,
                "token_efficiency": {
                    "traditional_approach_tokens": traditional_tokens,
                    "memory_search_tokens": memory_tokens,
                    "efficiency_gain_percent": efficiency_gain,
                    "approach_used": "memory_optimized_search"
                },
                "suggested_memory_operations": [memory_creation_suggestion] if memory_creation_suggestion else [],
                "analysis_timestamp": datetime.now().isoformat()
            }
            
            self.logger.info(f"Memory-optimized workflow analysis completed with {efficiency_gain:.1f}% token efficiency gain")
            
        except Exception as e:
            self.logger.warning(f"Memory-optimized search failed, falling back to traditional analysis: {e}")
            
            # Fallback to traditional analysis if memory search fails
            analysis_results = {
                "pattern_analysis": self.pattern_analyzer.analyze_patterns(workflow_data) if analysis_type in ["patterns", "all"] else {},
                "inefficiency_report": self.pattern_analyzer.detect_inefficiencies(workflow_data) if analysis_type in ["efficiency", "all"] else {},
                "optimization_suggestions": self.pattern_analyzer.generate_optimization_suggestions(workflow_data, domain, complexity_level) if analysis_type in ["suggestions", "all"] else [],
                "confidence_scores": {"overall": 0.75, "fallback_mode": True},
                "memory_insights": self.pattern_analyzer.generate_memory_insights(workflow_data, {}, project_name, domain) if learning_mode else []
            }
            
            result = {
                "success": True,
                "analysis_type": analysis_type,
                "project_context": project_context,
                "workflow_count": len(workflow_data),
                "analysis_results": analysis_results,
                "token_efficiency": {
                    "approach_used": "traditional_fallback",
                    "reason": str(e)
                },
                "analysis_timestamp": datetime.now().isoformat()
            }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]

    async def _handle_track_progress_milestones(self, args: Dict[str, Any]) -> List[TextContent]:
        """Handle automated progress tracking with smart milestone detection."""
        
        # Extract parameters
        task_id = args.get("task_id")
        current_completion = args.get("current_completion")
        status = args.get("status")
        project_name = args.get("project_name", "ATLAS")
        context = args.get("context", {})
        
        if not task_id:
            return [TextContent(type="text", text="Error: task_id is required")]
        
        try:
            # Call the progress tracking automation
            tracking_results = self.progress_tracking_automation.track_progress_milestones(
                task_id=task_id,
                current_completion=current_completion,
                status=status,
                context=context
            )
            
            # Add project context
            tracking_results["project_name"] = project_name
            tracking_results["timestamp"] = datetime.now().isoformat()
            
            # Create memory entity suggestion if milestones detected
            memory_suggestions = []
            if tracking_results.get("milestones_detected"):
                memory_entity_name = f"ProgressMilestone_{project_name}_{task_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                memory_suggestion = self._suggest_memory_entity(
                    memory_entity_name,
                    "ProgressTracking",
                    [
                        f"Progress milestone tracking for task {task_id}",
                        f"Milestones detected: {len(tracking_results['milestones_detected'])}",
                        f"Alerts generated: {len(tracking_results['alerts_generated'])}",
                        f"Patterns learned: {len(tracking_results['patterns_learned'])}",
                        f"Project: {project_name}"
                    ]
                )
                memory_suggestions.append(memory_suggestion)
            
            # Add memory suggestions to results
            tracking_results["suggested_memory_operations"] = memory_suggestions
            
            return [TextContent(type="text", text=json.dumps(tracking_results, indent=2))]
            
        except Exception as e:
            error_result = {
                "error": f"Progress tracking failed: {str(e)}",
                "task_id": task_id,
                "project_name": project_name,
                "timestamp": datetime.now().isoformat()
            }
            return [TextContent(type="text", text=json.dumps(error_result, indent=2))]

    # Memory Management Handlers
    async def _handle_memory_health_check(self, args: Dict[str, Any]) -> List[TextContent]:
        """Check memory system health and integrity."""
        health_status = self.memory_guardian.get_memory_health()
        
        # Create human-readable summary
        summary = "## Memory Health Status\n\n"
        
        if health_status.get("guardian_running"):
            summary += "✅ **Guardian Status**: Running and protecting memory\n"
        else:
            summary += "❌ **Guardian Status**: Not running - memory is vulnerable\n"
        
        integrity = health_status.get("memory_integrity", "unknown")
        if integrity == "valid":
            summary += "✅ **Memory Integrity**: Valid and consistent\n"
        elif integrity == "corrupted":
            summary += "❌ **Memory Integrity**: Corruption detected\n"
        else:
            summary += "⚠️ **Memory Integrity**: Status unknown\n"
        
        backup_count = health_status.get("backup_count", 0)
        summary += f"💾 **Backup Count**: {backup_count} backups available\n"
        summary += f"📏 **Memory Size**: {health_status.get('memory_file_size', 0)} bytes\n"
        
        last_backup = health_status.get("last_backup", "unknown")
        summary += f"🕒 **Last Backup**: {last_backup}\n"
        
        corruption_events = health_status.get("corruption_events", 0)
        if corruption_events > 0:
            summary += f"⚠️ **Corruption Events**: {corruption_events} detected\n"
        else:
            summary += "✅ **Corruption Events**: None detected\n"
        
        # Add recent backups
        recent_backups = health_status.get("available_backups", [])
        if recent_backups:
            summary += f"\n**Recent Backups**:\n"
            for backup in recent_backups[:3]:
                summary += f"- {backup}\n"
        
        result = {
            "health_check_completed": True,
            "summary": summary,
            "detailed_status": health_status,
            "recommendations": self._get_memory_recommendations(health_status)
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_memory_force_backup(self, args: Dict[str, Any]) -> List[TextContent]:
        """Force an immediate memory backup with context."""
        context = args.get("context", "manual_backup")
        metadata = args.get("metadata", {})
        
        backup_result = self.memory_guardian.force_backup(context, metadata)
        
        if backup_result.get("success"):
            summary = f"✅ **Backup Created Successfully**\n\n"
            summary += f"📝 **Context**: {context}\n"
            summary += f"💾 **Backup**: {backup_result.get('backup_created', 'unknown')}\n"
            summary += f"🕒 **Timestamp**: {datetime.now().isoformat()}\n"
        else:
            summary = f"❌ **Backup Failed**\n\n"
            summary += f"🚨 **Error**: {backup_result.get('error', 'unknown')}\n"
        
        result = {
            "backup_requested": True,
            "context": context,
            "summary": summary,
            "backup_result": backup_result
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_memory_restore(self, args: Dict[str, Any]) -> List[TextContent]:
        """Restore memory from backup."""
        backup_name = args.get("backup_name")
        
        restore_result = self.memory_guardian.restore_from_backup(backup_name)
        
        if restore_result.get("success"):
            summary = f"✅ **Memory Restored Successfully**\n\n"
            summary += f"🔄 **Restored From**: {restore_result.get('restored_from', 'latest valid backup')}\n"
            summary += f"🕒 **Timestamp**: {datetime.now().isoformat()}\n"
            summary += f"⚠️ **Note**: Memory server will restart to load restored data\n"
        else:
            summary = f"❌ **Restore Failed**\n\n"
            summary += f"🚨 **Error**: {restore_result.get('error', 'unknown')}\n"
        
        result = {
            "restore_requested": True,
            "backup_name": backup_name,
            "summary": summary,
            "restore_result": restore_result
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_memory_analytics(self, args: Dict[str, Any]) -> List[TextContent]:
        """Get detailed memory analytics and statistics."""
        analytics = self.memory_guardian.get_memory_analytics()
        
        if analytics.get("error"):
            summary = f"❌ **Analytics Error**: {analytics['error']}\n"
        else:
            memory_stats = analytics.get("memory_statistics", {})
            backup_stats = analytics.get("backup_statistics", {})
            reliability_stats = analytics.get("reliability_statistics", {})
            
            summary = "## Memory Analytics Report\n\n"
            
            summary += "### 📊 Memory Usage\n"
            summary += f"- **Entities**: {memory_stats.get('total_entities', 0)}\n"
            summary += f"- **Relations**: {memory_stats.get('total_relations', 0)}\n"
            summary += f"- **File Size**: {memory_stats.get('memory_file_size_mb', 0):.2f} MB\n"
            summary += f"- **Growth Rate**: {memory_stats.get('growth_rate', 'unknown')}\n\n"
            
            summary += "### 💾 Backup Statistics\n"
            summary += f"- **Total Backups**: {backup_stats.get('total_backups', 0)}\n"
            summary += f"- **Backup Storage**: {backup_stats.get('total_backup_size_mb', 0):.2f} MB\n"
            summary += f"- **Oldest**: {backup_stats.get('oldest_backup', 'none')}\n"
            summary += f"- **Newest**: {backup_stats.get('newest_backup', 'none')}\n\n"
            
            summary += "### 🛡️ Reliability Metrics\n"
            summary += f"- **Corruption Events**: {reliability_stats.get('corruption_events', 0)}\n"
            summary += f"- **Successful Restores**: {reliability_stats.get('successful_restores', 0)}\n"
            summary += f"- **Uptime**: {reliability_stats.get('uptime_hours', 0)} hours\n"
            summary += f"- **Last Corruption**: {reliability_stats.get('last_corruption', 'never')}\n"
        
        result = {
            "analytics_completed": True,
            "summary": summary,
            "detailed_analytics": analytics
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_memory_cleanup(self, args: Dict[str, Any]) -> List[TextContent]:
        """Clean up old memory backups."""
        keep_count = args.get("keep_count", 20)
        
        cleanup_result = self.memory_guardian.cleanup_old_backups(keep_count)
        
        if cleanup_result.get("success", True):
            cleaned = cleanup_result.get("cleaned", 0)
            kept = cleanup_result.get("kept", 0)
            
            summary = f"✅ **Cleanup Completed**\n\n"
            summary += f"🗑️ **Cleaned**: {cleaned} old backups\n"
            summary += f"💾 **Kept**: {kept} recent backups\n"
            summary += f"📝 **Message**: {cleanup_result.get('message', 'Cleanup completed')}\n"
        else:
            summary = f"❌ **Cleanup Failed**\n\n"
            summary += f"🚨 **Error**: {cleanup_result.get('error', 'unknown')}\n"
        
        result = {
            "cleanup_completed": True,
            "keep_count": keep_count,
            "summary": summary,
            "cleanup_result": cleanup_result
        }
        
        return [TextContent(type="text", text=json.dumps(result, indent=2))]
    
    async def _handle_create_nested_subtask(self, args: Dict[str, Any]) -> List[TextContent]:
        """Create subtask within parent's task.json."""
        subtask_data = {
            "task_name": args["task_name"],
            "description": args["description"],
            "priority": args.get("priority", "medium"),
            "estimated_hours": args.get("estimated_hours", 0),
            "status": "planning"
        }
        
        try:
            subtask_id = self.storage_manager.create_nested_task(
                args["project_name"],
                args["parent_id"],
                subtask_data
            )
            
            # Get parent task to check if nested storage is enabled
            parent_root = self.storage_manager.get_task_root(args["project_name"], args["parent_id"])
            parent_metadata_path = parent_root / "task.json"
            
            with open(parent_metadata_path, 'r') as f:
                parent_task = json.load(f)
            
            result = {
                "success": True,
                "subtask_id": subtask_id,
                "parent_id": args["parent_id"],
                "nested_storage_enabled": parent_task.get("nested_storage_enabled", False),
                "storage_mode": "nested" if parent_task.get("nested_storage_enabled", False) else "dual",
                "message": f"Created subtask {subtask_id} under {args['parent_id']}"
            }
            
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
            
        except Exception as e:
            return [TextContent(type="text", text=json.dumps({
                "success": False,
                "error": str(e)
            }, indent=2))]
    
    async def _handle_get_nested_task(self, args: Dict[str, Any]) -> List[TextContent]:
        """Get nested subtask data."""
        try:
            subtask_data = self.storage_manager.get_nested_task(
                args["project_name"],
                args["parent_id"],
                args["subtask_path"]
            )
            
            result = {
                "success": True,
                "task_data": subtask_data,
                "path": f"{args['parent_id']}/{'/'.join(args['subtask_path'])}"
            }
            
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
            
        except Exception as e:
            return [TextContent(type="text", text=json.dumps({
                "success": False,
                "error": str(e)
            }, indent=2))]
    
    async def _handle_update_nested_task(self, args: Dict[str, Any]) -> List[TextContent]:
        """Update nested subtask."""
        try:
            updated_task = self.storage_manager.update_nested_task(
                args["project_name"],
                args["parent_id"],
                args["subtask_path"],
                args["updates"]
            )
            
            result = {
                "success": True,
                "updated_task": updated_task,
                "path": f"{args['parent_id']}/{'/'.join(args['subtask_path'])}"
            }
            
            return [TextContent(type="text", text=json.dumps(result, indent=2))]
            
        except Exception as e:
            return [TextContent(type="text", text=json.dumps({
                "success": False,
                "error": str(e)
            }, indent=2))]
    
    async def _handle_migrate_to_nested_storage(self, args: Dict[str, Any]) -> List[TextContent]:
        """Migrate flat storage to nested format."""
        try:
            migration_report = self.storage_manager.migrate_to_nested_storage(
                args["project_name"],
                args.get("dry_run", True)
            )
            
            # Calculate potential savings
            if "subtasks_found" in migration_report:
                total_tasks = migration_report.get("tasks_analyzed", 0)
                total_subtasks = migration_report.get("subtasks_found", 0)
                
                # Directory reduction calculation
                current_dirs = total_tasks + total_subtasks
                new_dirs = total_tasks
                reduction_percentage = ((current_dirs - new_dirs) / current_dirs * 100) if current_dirs > 0 else 0
                
                migration_report["storage_optimization"] = {
                    "current_directories": current_dirs,
                    "directories_after_migration": new_dirs,
                    "reduction_percentage": round(reduction_percentage, 1),
                    "directories_to_remove": total_subtasks
                }
            
            return [TextContent(type="text", text=json.dumps(migration_report, indent=2))]
            
        except Exception as e:
            return [TextContent(type="text", text=json.dumps({
                "success": False,
                "error": str(e)
            }, indent=2))]
    
    def _get_memory_recommendations(self, health_status: Dict[str, Any]) -> List[str]:
        """Generate recommendations based on memory health."""
        recommendations = []
        
        if not health_status.get("guardian_running"):
            recommendations.append("Start Memory Guardian container for protection")
        
        backup_count = health_status.get("backup_count", 0)
        if backup_count < 5:
            recommendations.append("Consider forcing backup to ensure adequate backup coverage")
        elif backup_count > 50:
            recommendations.append("Consider cleaning up old backups to save disk space")
        
        corruption_events = health_status.get("corruption_events", 0)
        if corruption_events > 0:
            recommendations.append("Investigate corruption causes and consider memory restore")
        
        memory_size = health_status.get("memory_file_size", 0)
        if memory_size > 10 * 1024 * 1024:  # 10MB
            recommendations.append("Memory file is large - consider analytics to understand growth")
        
        if health_status.get("memory_integrity") == "unknown":
            recommendations.append("Run memory validation to check integrity")
        
        return recommendations

    # Cache management tool handlers
    async def _handle_get_cache_stats(self, args: Dict[str, Any]) -> List[TextContent]:
        """Get multi-tier cache performance statistics."""
        stats = self.cache_manager.get_stats()
        
        stats_text = f"""# Cache Performance Statistics

## Hit Rates
- **Overall Hit Rate**: {stats['hit_rate']:.1%}
- **L1 Hits**: {stats['l1_hits']} | **L1 Misses**: {stats['l1_misses']}
- **L2 Hits**: {stats['l2_hits']} | **L2 Misses**: {stats['l2_misses']}
- **L3 Hits**: {stats['l3_hits']} | **L3 Misses**: {stats['l3_misses']}

## Cache Status
- **L1 Size**: {stats['l1_size']} / {self.cache_manager.l1_max_size} entries
- **L2 Enabled**: {stats['l2_enabled']}
- **L3 Cache Dir**: {stats['l3_cache_dir']}

## Operations
- **Total Gets**: {stats['total_gets']}
- **Total Sets**: {stats['total_sets']}
- **Total Hits**: {stats['total_hits']}
- **Total Misses**: {stats['total_misses']}

## Redis Status"""
        
        if self.cache_manager.l2_client.enabled:
            redis_info = self.cache_manager.l2_client.info()
            stats_text += f"""
- **Redis Version**: {redis_info.get('redis_version', 'Unknown')}
- **Memory Used**: {redis_info.get('used_memory_human', 'Unknown')}
- **Connected Clients**: {redis_info.get('connected_clients', 'Unknown')}
- **Commands Processed**: {redis_info.get('total_commands_processed', 'Unknown')}"""
        else:
            stats_text += "\n- **Redis**: Disabled or unavailable"
        
        return [TextContent(type="text", text=stats_text)]
    
    async def _handle_invalidate_cache(self, args: Dict[str, Any]) -> List[TextContent]:
        """Invalidate cache entries by namespace or specific key."""
        namespace = args["namespace"]
        key = args.get("key")
        
        invalidated_count = self.cache_manager.invalidate(namespace, key)
        
        if key:
            message = f"Invalidated {invalidated_count} cache entries for {namespace}:{key}"
        else:
            message = f"Invalidated {invalidated_count} cache entries for namespace '{namespace}'"
        
        return [TextContent(type="text", text=message)]
    
    async def _handle_warm_cache(self, args: Dict[str, Any]) -> List[TextContent]:
        """Pre-populate cache with commonly accessed data."""
        namespace = args["namespace"]
        operation = args["operation"]
        project_name = args.get("project_name", "ATLAS")
        
        warmed_items = []
        
        try:
            if namespace == "task" and operation == "hierarchy":
                # Warm task hierarchy cache
                if project_name:
                    tasks = self.storage_manager.list_project_tasks(project_name)
                    for task in tasks[:10]:  # Warm top 10 tasks
                        task_context = self.storage_manager.get_task_context(project_name, task["task_id"])
                        self.cache_manager.set("task", "context", task_context, 
                                             l1_ttl=300, l2_ttl=1800, l3_ttl=3600,
                                             project_name=project_name, task_id=task["task_id"])
                        warmed_items.append(f"task:context:{project_name}:{task['task_id']}")
            
            elif namespace == "task" and operation == "list":
                # Warm task list cache
                task_list = self.storage_manager.list_project_tasks(project_name)
                self.cache_manager.set("task", "list", task_list,
                                     l1_ttl=300, l2_ttl=1800, l3_ttl=3600,
                                     project_name=project_name)
                warmed_items.append(f"task:list:{project_name}")
            
            elif namespace == "memory" and operation == "search":
                # Pre-warm common memory searches
                common_queries = ["task", "architecture", "pattern", "error", "solution"]
                for query in common_queries:
                    # This would call memory search and cache results
                    # Implementation depends on memory manager interface
                    warmed_items.append(f"memory:search:{query}")
            
            message = f"Cache warmed for {namespace}:{operation}"
            if warmed_items:
                message += f"\n\nWarmed items:\n" + "\n".join(f"- {item}" for item in warmed_items)
            
        except Exception as e:
            message = f"Error warming cache for {namespace}:{operation}: {str(e)}"
        
        return [TextContent(type="text", text=message)]
    
    async def _handle_clear_all_cache(self, args: Dict[str, Any]) -> List[TextContent]:
        """Clear all cache tiers."""
        cleared_stats = self.cache_manager.clear_all()
        
        message = f"""# Cache Cleared Successfully

- **L1 Cache**: {cleared_stats['l1_cleared']} entries removed
- **L2 Cache**: {cleared_stats['l2_cleared']} databases cleared
- **L3 Cache**: {cleared_stats['l3_cleared']} files removed

All cache tiers have been reset."""
        
        return [TextContent(type="text", text=message)]

    # Observability tool handlers
    async def _handle_get_observability_status(self, args: Dict[str, Any]) -> List[TextContent]:
