{
  "name": "atlas-commands",
  "version": "1.0.0",
  "description": "Comprehensive MCP server providing intelligent workflow automation, task persistence, memory graph management, pattern learning, and convention validation for the ATLAS command ecosystem",
  "author": "ATLAS",
  "license": "MIT",
  "runtime": "python",
  "main": "src/atlas_commands/server.py",
  "commands": {
    "start": "python -m atlas_commands.server"
  },
  "claude_integration": {
    "server_config": {
      "command": "docker",
      "args": [
        "exec",
        "-i", 
        "atlas-commands-mcp",
        "python",
        "-m",
        "atlas_commands.server"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "LOG_LEVEL": "INFO",
        "PROJECT_NAME": "Software-Engineer-AI-Agent-Atlas",
        "ATLAS_STORAGE_PATH": "/app/REPOS",
        "ATLAS_STARTUP_MODE": "fast",
        "ATLAS_LAZY_LOADING": "true",
        "ATLAS_TOKEN_MODE": "auto",
        "ATLAS_COMPRESSION_STRATEGY": "adaptive",
        "ATLAS_CACHE_MODE": "hierarchical"
      }
    },
    "usage_notes": {
      "container_requirement": "Requires atlas-commands-mcp Docker container to be running",
      "startup_command": "docker-compose up -d atlas-commands",
      "tools_available": 49,
      "protocol_version": "2024-11-05"
    }
  },
  "tools": [
    {
      "name": "create_unified_checklist",
      "description": "Create a unified checklist with consistent formatting, priority levels, time estimates, and dependency tracking for ATLAS command workflows",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command_name": {
            "type": "string",
            "description": "Name of the command creating the checklist"
          },
          "task_id": {
            "type": "string",
            "description": "Unique identifier for the task"
          },
          "items": {
            "type": "array",
            "description": "Array of checklist items",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ],
                  "default": "MEDIUM"
                },
                "estimate": {
                  "type": "string",
                  "default": "15m"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              },
              "required": [
                "id",
                "description"
              ]
            }
          },
          "title": {
            "type": "string",
            "description": "Title of the checklist"
          },
          "template_type": {
            "type": "string",
            "description": "Type of checklist template to use",
            "default": "standard"
          }
        },
        "required": [
          "command_name",
          "task_id",
          "title",
          "items"
        ]
      }
    },
    {
      "name": "update_checklist_item",
      "description": "Update checklist item status (PENDING/IN_PROGRESS/COMPLETED/BLOCKED) with timestamp tracking and dependency validation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checklist_id": {
            "type": "string",
            "description": "Identifier of the checklist"
          },
          "item_id": {
            "type": "string",
            "description": "Identifier of the checklist item"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "BLOCKED"
            ],
            "description": "New status for the item"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about the status change",
            "default": ""
          }
        },
        "required": [
          "checklist_id",
          "item_id",
          "status"
        ]
      }
    },
    {
      "name": "get_checklist_progress",
      "description": "Calculate and return checklist completion progress including item counts, time estimates, blocked dependencies, and completion percentage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checklist_id": {
            "type": "string",
            "description": "Identifier of the checklist"
          },
          "include_estimates": {
            "type": "boolean",
            "description": "Whether to include time estimates in progress calculation",
            "default": true
          }
        },
        "required": [
          "checklist_id"
        ]
      }
    },
    {
      "name": "create_todowrite_integration",
      "description": "Generate TodoWrite-compatible markdown format for checklists with proper formatting, priority indicators, and integration with ATLAS workflows",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checklist_id": {
            "type": "string",
            "description": "Identifier of the checklist to integrate"
          },
          "output_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json",
              "yaml"
            ],
            "description": "Output format for TodoWrite integration",
            "default": "markdown"
          },
          "include_metadata": {
            "type": "boolean",
            "description": "Whether to include metadata in the output",
            "default": true
          }
        },
        "required": [
          "checklist_id"
        ]
      }
    },
    {
      "name": "create_memory_entity",
      "description": "Create named entities in the memory graph with observations, relationships, and standardized naming patterns for workflow tracking and context preservation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the memory entity"
          },
          "entity_type": {
            "type": "string",
            "description": "Type of entity (TaskInstance, Workflow, Analysis, etc.)"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of observations about the entity"
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to_entity": {
                  "type": "string"
                },
                "relation_type": {
                  "type": "string"
                }
              },
              "required": [
                "to_entity",
                "relation_type"
              ]
            },
            "description": "Relations to other entities",
            "default": []
          }
        },
        "required": [
          "name",
          "entity_type",
          "observations"
        ]
      }
    },
    {
      "name": "create_workflow",
      "description": "Create enforced command workflows with prerequisite validation, execution order controls, optional steps, and failure recovery mechanisms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow_name": {
            "type": "string",
            "description": "Name of the workflow"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object",
                  "default": {}
                },
                "prerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "optional": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "command",
                "target"
              ]
            },
            "description": "Array of workflow steps"
          },
          "validation_rules": {
            "type": "object",
            "description": "Custom validation rules for the workflow",
            "default": {}
          }
        },
        "required": [
          "workflow_name",
          "steps"
        ]
      }
    },
    {
      "name": "validate_command",
      "description": "Validate command execution readiness by checking prerequisites, parameter completeness, workflow state, and execution context requirements",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command to validate"
          },
          "target": {
            "type": "string",
            "description": "Target for the command"
          },
          "parameters": {
            "type": "object",
            "description": "Parameters for the command",
            "default": {}
          },
          "workflow_context": {
            "type": "object",
            "description": "Current workflow context",
            "default": {}
          }
        },
        "required": [
          "command",
          "target"
        ]
      }
    },
    {
      "name": "track_command_pattern",
      "description": "Record and analyze command execution patterns including success/failure indicators, context parameters, timing metrics, and outcome observations for machine learning",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command_type": {
            "type": "string",
            "description": "Type of command executed"
          },
          "target": {
            "type": "string",
            "description": "Target of the command"
          },
          "parameters": {
            "type": "object",
            "description": "Parameters used in execution"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "partial"
            ],
            "description": "Outcome of the execution"
          },
          "metrics": {
            "type": "object",
            "description": "Execution metrics (timing, resource usage, etc.)",
            "default": {}
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Observations about the execution",
            "default": []
          }
        },
        "required": [
          "command_type",
          "target",
          "parameters",
          "outcome"
        ]
      }
    },
    {
      "name": "get_pattern_recommendations",
      "description": "Provide intelligent recommendations based on learned execution patterns, historical success rates, context similarity, and best practices for command optimization",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command_type": {
            "type": "string",
            "description": "Type of command to get recommendations for"
          },
          "target": {
            "type": "string",
            "description": "Target for the command"
          },
          "context": {
            "type": "object",
            "description": "Current execution context",
            "default": {}
          },
          "max_recommendations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum number of recommendations to return",
            "default": 5
          }
        },
        "required": [
          "command_type",
          "target"
        ]
      }
    },
    {
      "name": "compact_memory_graph",
      "description": "Optimize memory graph storage by preserving high-entropy information, consolidating redundant observations, and maintaining essential relationships while reducing memory footprint",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_filter": {
            "type": "string",
            "description": "Optional filter pattern for entities to compact",
            "default": "*"
          },
          "preserve_recent": {
            "type": "boolean",
            "description": "Whether to preserve recent entities from compaction",
            "default": true
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum age in days for entities to be considered for compaction",
            "default": 30
          },
          "compression_ratio": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 0.9,
            "description": "Target compression ratio (0.1 = aggressive, 0.9 = conservative)",
            "default": 0.7
          }
        }
      }
    }
  ],
  "capabilities": {
    "error_recovery": true,
    "resource_monitoring": true,
    "validation": true,
    "pattern_learning": true,
    "memory_graph": true
  },
  "requirements": {
    "python": ">=3.10",
    "dependencies": [
      "mcp>=1.0.0",
      "pydantic>=2.0.0",
      "psutil>=5.9.0"
    ]
  }
}