# Atlas MCP Configuration Example
# Copy this file to .env and customize for your environment

# ==============================================
# Atlas Home Configuration (NEW - Centralized)
# ==============================================

# Base directory for all Atlas MCP outputs
# All task storage, cache, logs, etc. will be organized under this directory
ATLAS_HOME=~/.atlas

# The following paths are automatically derived from ATLAS_HOME:
# - Projects: ${ATLAS_HOME}/projects (replaces /app/REPOS)
# - Cache: ${ATLAS_HOME}/cache (L3 file cache)
# - Logs: ${ATLAS_HOME}/logs
# - Coordination: ${ATLAS_HOME}/coordination (cross-project data)
# - Models: ${ATLAS_HOME}/models (ML models and embeddings)
# - Temp: ${ATLAS_HOME}/temp (temporary files)

# ==============================================
# Project Configuration
# ===============================================

# Current project name
PROJECT_NAME=Software-Engineer-AI-Agent-Atlas

# Task directory suffix pattern
ATLAS_TASK_SUFFIX=_TASKS

# ==============================================
# Cache Configuration
# ==============================================

# L1 Cache (in-memory) - max entries
ATLAS_L1_CACHE_SIZE=128

# L2 Cache (Redis) - TTL in seconds
ATLAS_L2_TTL=3600

# L3 Cache (file system under ${ATLAS_HOME}/cache) - TTL in seconds
ATLAS_L3_TTL=86400

# ==============================================
# Performance Configuration
# ==============================================

# Maximum concurrent tool executions
ATLAS_MAX_CONCURRENT_TOOLS=10

# Tool execution timeout in seconds
ATLAS_TOOL_TIMEOUT=60.0

# ==============================================
# Startup Configuration
# ==============================================

# Fast startup mode (loads ML components asynchronously)
ATLAS_STARTUP_MODE=fast

# Enable lazy loading of non-essential components
ATLAS_LAZY_LOADING=true

# ==============================================
# Redis Configuration
# ==============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Or individual Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Optional

# ==============================================
# Logging Configuration
# ==============================================

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ==============================================
# Token Optimization
# ==============================================

# Token optimization mode
ATLAS_TOKEN_MODE=auto

# Compression strategy
ATLAS_COMPRESSION_STRATEGY=adaptive
ATLAS_COMPRESSION_MIN_SIZE=500
ATLAS_COMPRESSION_ENABLE_LEARNING=true
ATLAS_COMPRESSION_DEFAULT_QUALITY=0.85

# ==============================================
# Coordination and Memory
# ==============================================

# Project coordination mode
ATLAS_COORDINATION_MODE=enabled

# Memory isolation level
ATLAS_MEMORY_ISOLATION=strict

# Cross-project sharing policy
ATLAS_CROSS_PROJECT_SHARING=high_entropy_only

# Workspace isolation
ATLAS_WORKSPACE_ISOLATION=false

# ==============================================
# Container Deployment
# ==============================================

# For Docker deployment, ensure these environment variables are set:
# - ATLAS_HOME (host path): /home/user/.atlas
# - Container will mount: ${ATLAS_HOME}:/app/.atlas:rw
# - Legacy compatibility: ${ATLAS_HOME}/projects:/app/REPOS:rw

# User/Group for container security
UID=1000
GID=1000